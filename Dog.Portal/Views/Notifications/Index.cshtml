@model Dog.Portal.Models.NotificationLogListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Notifications";
    var types = new[] { "VaccineDue", "ContractRenewal", "InvoiceOverdue" };
    string TypeLabel(string t) => t switch { "VaccineDue" => "Vaccine Due", "ContractRenewal" => "Contract Renewal", "InvoiceOverdue" => "Invoice Overdue", _ => t };
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:160px}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem}
.tbl-wrap{overflow-x:auto;min-height:300px}
.dt{width:100%;border-collapse:collapse}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:top}
.dt tbody tr:hover td{background:#fafbff}
.type-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:700;padding:.22rem .6rem;border-radius:20px}
.tb-vaccine{background:#dbeafe;color:#1d4ed8}
.tb-contract{background:#fef3c7;color:#b45309}
.tb-invoice{background:#fee2e2;color:#b91c1c}
.s-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:700;padding:.2rem .55rem;border-radius:20px}
.s-active{background:#d1fae5;color:#065f46}
.s-inactive{background:#fee2e2;color:#991b1b}
.msg-cell{max-width:420px;white-space:pre-line;font-size:.8rem;color:#475569}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;color:#64748b;text-decoration:none;background:#fff}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
</style>
<div class="page-hdr-row">
  <div class="page-hdr"><h4>Notifications</h4><p>Reminders the system has sent via WhatsApp — vaccines due, contract renewals, overdue invoices</p></div>
  <div class="total-chip"><i class="bi bi-bell"></i> @Model.TotalCount Sent</div>
</div>
<div class="dc">
  <div class="dc-head">
    <form method="get" style="display:contents">
      <select name="type" class="filter-sel" onchange="this.form.submit()">
        <option value="">All Types</option>
        @foreach (var t in types) {
          if (Model.TypeFilter == t) { <option value="@t" selected>@TypeLabel(t)</option> }
          else { <option value="@t">@TypeLabel(t)</option> }
        }
      </select>
      <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
    </form>
  </div>
  <div class="tbl-wrap">
    @if (Model.LogList.Count > 0) {
      <table class="dt">
        <thead><tr>
          <th style="width:130px">Type</th>
          <th style="width:130px">Sent</th>
          <th style="width:130px">Recipient</th>
          <th>Message</th>
          <th style="width:90px">Status</th>
        </tr></thead>
        <tbody>
          @foreach (var item in Model.LogList) {
            var badgeClass = item.NotificationType switch { "VaccineDue" => "tb-vaccine", "ContractRenewal" => "tb-contract", "InvoiceOverdue" => "tb-invoice", _ => "tb-vaccine" };
            <tr>
              <td><span class="type-badge @badgeClass">@TypeLabel(item.NotificationType)</span></td>
              <td>@item.SentAt.ToString("MMM dd, yyyy HH:mm")</td>
              <td>@(item.RecipientPhone ?? "—")</td>
              <td><div class="msg-cell">@item.Message</div></td>
              <td><span class="s-badge @(item.Success ? "s-active" : "s-inactive")">@(item.Success ? "Sent" : "Failed")</span></td>
            </tr>
          }
        </tbody>
      </table>
    } else {
      <div class="empty-state"><i class="bi bi-bell-slash"></i><h3>No notifications sent yet</h3><p>Daily reminders for vaccines due, contract renewals, and overdue invoices will appear here.</p></div>
    }
  </div>
  @if (Model.TotalCount > 0) {
    <div class="dc-foot">
      <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
      @if (Model.TotalPages > 1) {
        <div class="pgn">
          @if (Model.Page > 1) { <a href="@Url.Action("Index", new { type=Model.TypeFilter, page=Model.Page-1 })" class="pb">Prev</a> }
          else { <span class="pb off">Prev</span> }
          @for (int p = Math.Max(1,Model.Page-2); p <= Math.Min(Model.TotalPages,Model.Page+2); p++) {
            if (p==Model.Page) { <span class="pb cur">@p</span> }
            else { <a href="@Url.Action("Index", new { type=Model.TypeFilter, page=p })" class="pb">@p</a> }
          }
          @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { type=Model.TypeFilter, page=Model.Page+1 })" class="pb">Next</a> }
          else { <span class="pb off">Next</span> }
        </div>
      }
    </div>
  }
</div>
