@model Dog.Portal.Models.BankListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Banks";
    var totalAll = Model.TotalCount;
    var activeCount = Model.BankList.Count(b => b.IsActive);
    var inactiveCount = Model.BankList.Count(b => !b.IsActive);
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem;letter-spacing:-.02em}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px;white-space:nowrap}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(102,126,234,.3)}
.btn-add:hover{opacity:.9;transform:translateY(-1px)}
.btn-accounts{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.125rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:9px;font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s}
.btn-accounts:hover{opacity:.9}
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04);padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.si-total{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.si-active{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-inactive{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.04);overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:280px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.srch-input::placeholder{color:#cbd5e1}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:130px}
.filter-sel:focus{border-color:#667eea}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem;white-space:nowrap}
.btn-srch:hover{opacity:.9}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;font-weight:500;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;transition:all .18s;white-space:nowrap}
.btn-clr:hover{background:#e2e8f0;color:#334155}
.tbl-wrap{overflow-x:auto;min-height:400px;}
.dt{width:100%;border-collapse:collapse;table-layout:fixed;}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.09em;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle;max-width:200px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
.dt tbody tr:last-child td{border-bottom:none}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}
.s-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:700;padding:.25rem .65rem;border-radius:20px}
.s-active{background:#d1fae5;color:#065f46}
.s-inactive{background:#fee2e2;color:#991b1b}
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s;font-size:.9rem}
.act-btn:hover{background:#f8fafc;border-color:#cbd5e1;color:#334155}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18);min-width:200px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;transition:background .15s;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc;color:#1e293b}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-item i{width:16px;text-align:center;font-size:.85rem}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;font-weight:500;color:#64748b;text-decoration:none;transition:all .18s;background:#fff}
.pb:hover{background:#f8fafc;color:#334155;border-color:#cbd5e1}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
.empty-state h3{font-size:1.1rem;font-weight:600;color:#64748b;margin-bottom:.5rem}
.bank-icon{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.bank-cell{display:flex;align-items:center;gap:.625rem}
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:480px;max-height:90vh;overflow-y:auto;animation:mslide .22s ease}
@@keyframes mslide{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.modal-close:hover{background:#e2e8f0}
.modal-body-p{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem}
.frow{margin-bottom:1rem}
.frow label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:.375rem}
.finput{width:100%;padding:.65rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;color:#1e293b;background:#fff;outline:none}
.finput:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer}
.btn-cancel:hover{background:#e2e8f0}
.btn-pm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-pm:disabled{opacity:.6;cursor:not-allowed}
.btn-dm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-dm:disabled{opacity:.6;cursor:not-allowed}
.del-icon{width:60px;height:60px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#dc2626}
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
.spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@@keyframes spin{to{transform:rotate(360deg)}}
</style>

<div class="page-hdr-row">
    <div class="page-hdr">
        <h4>Banks</h4>
        <p>Manage banks and their accounts</p>
    </div>
    <div class="hdr-actions">
        <div class="total-chip"><i class="bi bi-bank"></i><span>@totalAll Total</span></div>
        <a href="@Url.Action("Accounts")" class="btn-accounts">
            <i class="bi bi-credit-card"></i> Bank Accounts
        </a>
        <button type="button" class="btn-add" onclick="openCreateModal()">
            <i class="bi bi-plus-lg"></i> Add Bank
        </button>
    </div>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon si-total"><i class="bi bi-bank2"></i></div>
        <div class="stat-body"><div class="val">@totalAll</div><div class="lbl">Total Banks</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-active"><i class="bi bi-check-circle"></i></div>
        <div class="stat-body"><div class="val">@activeCount</div><div class="lbl">Active</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-inactive"><i class="bi bi-x-circle"></i></div>
        <div class="stat-body"><div class="val">@inactiveCount</div><div class="lbl">Inactive</div></div>
    </div>
</div>

<div class="dc">
    <div class="dc-head">
        <form method="get" style="display:contents;">
            <div class="srch-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search banks...">
            </div>
            <select name="status" class="filter-sel">
                <option value="">All Status</option>
                <option value="active" selected="@(ViewBag.StatusFilter == "active")">Active</option>
                <option value="inactive" selected="@(ViewBag.StatusFilter == "inactive")">Inactive</option>
            </select>
            <button type="submit" class="btn-srch"><i class="bi bi-search"></i> Search</button>
            <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
        </form>
    </div>

    <div class="tbl-wrap">
        @if (Model.BankList.Count > 0)
        {
            <table class="dt">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th style="width:250px">Bank Name</th>
                        <th style="width:200px">Account Name</th>
                        <th style="width:100px">Status</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var startIndex = (Model.Page - 1) * Model.PageSize; }
                    @for (int i = 0; i < Model.BankList.Count; i++)
                    {
                        var item = Model.BankList[i];
                        <tr>
                            <td><span class="rn">@(startIndex + i + 1)</span></td>
                            <td>
                                <div class="bank-cell">
                                    <div class="bank-icon"><i class="bi bi-bank"></i></div>
                                    <div style="font-weight:600;color:#1e293b">@item.Name</div>
                                </div>
                            </td>
                            <td title="@item.AccountName">@item.AccountName</td>
                            <td>
                                <span class="s-badge @(item.IsActive ? "s-active" : "s-inactive")">
                                    <i class="bi @(item.IsActive ? "bi-check-circle" : "bi-x-circle")"></i>
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td style="text-align:center">
                                <div class="act-wrap">
                                    <button class="act-btn" onclick="toggleActMenu(this)" title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <div class="act-menu"
                                         data-id="@item.Id"
                                         data-name="@item.Name"
                                         data-accountname="@item.AccountName"
                                         data-isactive="@item.IsActive.ToString().ToLower()">
                                        <button class="act-item" onclick="openEdit(this.closest('.act-menu'))">
                                            <i class="bi bi-pencil-fill" style="color:#667eea"></i> Edit
                                        </button>
                                        <a href="@Url.Action("Accounts", new { bankId = item.Id })" class="act-item">
                                            <i class="bi bi-credit-card" style="color:#667eea"></i> View Accounts
                                        </a>
                                        <button class="act-item" onclick="toggleBank(this.closest('.act-menu'))">
                                            <i class="bi @(item.IsActive ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                            @(item.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                        <div class="act-divider"></div>
                                        <button class="act-item danger" onclick="openDelete(this.closest('.act-menu'))">
                                            <i class="bi bi-trash3-fill"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-bank"></i>
                <h3>No banks found</h3>
                <p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Get started by adding your first bank." : "Try adjusting your search criteria.")</p>
            </div>
        }
    </div>

    @if (Model.TotalCount > 0)
    {
        <div class="dc-foot">
            <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
            @if (Model.TotalPages > 1)
            {
                <div class="pgn">
                    @if (Model.Page > 1)
                    {
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = Model.Page - 1 })" class="pb wide"><i class="bi bi-chevron-left"></i> Prev</a>
                    }
                    else { <span class="pb wide off"><i class="bi bi-chevron-left"></i> Prev</span> }
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        if (p == Model.Page) { <span class="pb cur">@p</span> }
                        else { <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = p })" class="pb">@p</a> }
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = Model.Page + 1 })" class="pb wide">Next <i class="bi bi-chevron-right"></i></a>
                    }
                    else { <span class="pb wide off">Next <i class="bi bi-chevron-right"></i></span> }
                </div>
            }
        </div>
    }
</div>


<div class="toast-wrap" id="toastWrap"></div>

<!-- CREATE MODAL -->
<div class="modal-backdrop-custom" id="createModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-bank" style="color:#667eea"></i> Add Bank</h5>
      <button class="modal-close" onclick="closeModal('createModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div class="frow"><label>Bank Name <span style="color:#ef4444">*</span></label><input class="finput" id="c_name" placeholder="e.g. First National Bank"></div>
      <div class="frow"><label>Account Name</label><input class="finput" id="c_accountName" placeholder="e.g. Main Operating Account"></div>
      <div class="frow" style="display:flex;align-items:center;gap:.5rem">
        <input type="checkbox" id="c_isActive" checked style="width:16px;height:16px;cursor:pointer">
        <label for="c_isActive" style="margin:0;font-size:.855rem;font-weight:500;cursor:pointer">Active</label>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('createModal')">Cancel</button>
      <button class="btn-pm" id="createBtn" onclick="submitCreate()"><i class="bi bi-bank"></i> Save Bank</button>
    </div>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal-backdrop-custom" id="editModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-pencil-fill" style="color:#667eea"></i> Edit Bank</h5>
      <button class="modal-close" onclick="closeModal('editModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <input type="hidden" id="e_id">
      <div class="frow"><label>Bank Name <span style="color:#ef4444">*</span></label><input class="finput" id="e_name"></div>
      <div class="frow"><label>Account Name</label><input class="finput" id="e_accountName"></div>
      <div class="frow" style="display:flex;align-items:center;gap:.5rem">
        <input type="checkbox" id="e_isActive" style="width:16px;height:16px;cursor:pointer">
        <label for="e_isActive" style="margin:0;font-size:.855rem;font-weight:500;cursor:pointer">Active</label>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('editModal')">Cancel</button>
      <button class="btn-pm" id="editBtn" onclick="submitEdit()"><i class="bi bi-check2-circle"></i> Save Changes</button>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-backdrop-custom" id="deleteModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-trash3-fill" style="color:#dc2626"></i> Delete Bank</h5>
      <button class="modal-close" onclick="closeModal('deleteModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p" style="text-align:center;padding-top:1.75rem">
      <input type="hidden" id="d_id">
      <div class="del-icon"><i class="bi bi-bank"></i></div>
      <p style="font-size:.9rem;color:#374151;margin-bottom:.5rem">Are you sure you want to delete</p>
      <p id="d_name" style="font-weight:700;color:#1e293b;font-size:1rem;margin-bottom:.5rem"></p>
      <p style="font-size:.82rem;color:#94a3b8;margin:0">This action cannot be undone.</p>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn-dm" id="deleteBtn" onclick="submitDelete()"><i class="bi bi-trash3-fill"></i> Delete</button>
    </div>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.modal-backdrop-custom').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)closeModal(bd.id);});});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop-custom.open').forEach(function(m){closeModal(m.id);});}});
function toggleActMenu(btn){var menu=btn.nextElementSibling;var isOpen=menu.classList.contains('open');closeAllActMenus();if(!isOpen){positionActMenu(btn,menu);menu.classList.add('open');}}
function closeAllActMenus(){document.querySelectorAll('.act-menu.open').forEach(function(m){m.classList.remove('open');m.style.top='';m.style.left='';m.style.right='';});}
function positionActMenu(btn,menu){menu.style.visibility='hidden';menu.style.display='block';var mr=menu.getBoundingClientRect();menu.style.display='';menu.style.visibility='';var br=btn.getBoundingClientRect();var right=window.innerWidth-br.right;if(right<8)right=8;var top=br.bottom+4;if(top+mr.height>window.innerHeight-8){var up=br.top-mr.height-4;top=up>=8?up:Math.max(8,window.innerHeight-mr.height-8);}menu.style.top=top+'px';menu.style.right=right+'px';menu.style.left='auto';}
document.addEventListener('click',function(e){if(!e.target.closest('.act-wrap'))closeAllActMenus();});
window.addEventListener('scroll',closeAllActMenus,true);
window.addEventListener('resize',closeAllActMenus);
function setLoading(id,on,html){var b=document.getElementById(id);b.disabled=on;if(on)b.innerHTML='<span class="spin"></span> Saving...';else if(html)b.innerHTML=html;}
function showToast(msg,type){var w=document.getElementById('toastWrap');var el=document.createElement('div');el.className='toast-msg toast-'+type;el.innerHTML='<i class="bi '+(type==='success'?'bi-check-circle-fill':'bi-exclamation-circle-fill')+'"></i>'+msg;w.appendChild(el);requestAnimationFrame(function(){el.classList.add('show');});setTimeout(function(){el.classList.remove('show');setTimeout(function(){el.remove();},350);},3500);}
function openCreateModal(){document.getElementById('c_name').value='';document.getElementById('c_accountName').value='';document.getElementById('c_isActive').checked=true;openModal('createModal');}
function openEdit(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('e_id').value=d.id;document.getElementById('e_name').value=d.name||'';document.getElementById('e_accountName').value=d.accountname||'';document.getElementById('e_isActive').checked=d.isactive==='true';openModal('editModal');}
function openDelete(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('d_id').value=d.id;document.getElementById('d_name').textContent=d.name||'this bank';openModal('deleteModal');}
async function toggleBank(menu){closeAllActMenus();var id=menu.dataset.id;try{var r=await fetch('/Banks/Toggle/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast('Status updated!','success');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}}
async function submitCreate(){var name=document.getElementById('c_name').value.trim();if(!name){showToast('Bank name is required.','error');return;}setLoading('createBtn',true);try{var r=await fetch('/Banks/Create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,accountName:document.getElementById('c_accountName').value.trim(),isActive:document.getElementById('c_isActive').checked})});var d=await r.json();if(d.success){showToast(d.message||'Bank created!','success');closeModal('createModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('createBtn',false,'<i class="bi bi-bank"></i> Save Bank');}}
async function submitEdit(){var name=document.getElementById('e_name').value.trim();if(!name){showToast('Bank name is required.','error');return;}var id=document.getElementById('e_id').value;setLoading('editBtn',true);try{var r=await fetch('/Banks/Update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:parseInt(id),name:name,accountName:document.getElementById('e_accountName').value.trim(),isActive:document.getElementById('e_isActive').checked})});var d=await r.json();if(d.success){showToast(d.message||'Bank updated!','success');closeModal('editModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('editBtn',false,'<i class="bi bi-check2-circle"></i> Save Changes');}}
async function submitDelete(){var id=document.getElementById('d_id').value;setLoading('deleteBtn',true);try{var r=await fetch('/Banks/Delete/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast(d.message||'Bank deleted.','success');closeModal('deleteModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('deleteBtn',false,'<i class="bi bi-trash3-fill"></i> Delete');}}
</script>

