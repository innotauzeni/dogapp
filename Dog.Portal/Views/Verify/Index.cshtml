@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Verify a certificate</title>
    <style>
        body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f1f5f9;color:#0f172a}
        .wrap{max-width:480px;margin:3rem auto;padding:0 1rem}
        .card{background:#fff;border-radius:16px;box-shadow:0 8px 30px rgba(15,23,42,.08);padding:1.6rem}
        h1{font-size:1.25rem;margin:0 0 .4rem} p{color:#64748b;font-size:.9rem;margin:0 0 1rem}
        input{width:100%;box-sizing:border-box;padding:.7rem .8rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.95rem}
        button{margin-top:.8rem;width:100%;padding:.75rem;border:0;border-radius:10px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;font-weight:700;font-size:.95rem;cursor:pointer}
    </style>
</head>
<body>
<div class="wrap"><div class="card">
    <h1>Verify a training certificate</h1>
    <p>Scan the QR code on the certificate, or paste the verification code (the long code at the end of the certificate's verification link).</p>
    <form onsubmit="var v=this.code.value.trim().split('/').pop(); if(v){location.href='/Verify/Training/'+encodeURIComponent(v);} return false;">
        <input name="code" placeholder="Verification code" autocomplete="off" required />
        <button type="submit">Verify</button>
    </form>
</div></div>
</body>
</html>
