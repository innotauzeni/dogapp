@model Dog.Application.Features.DogTraining.DTOs.CertificateVerificationDto
@{
    Layout = null;
    var c = Model.Certificate;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Certificate verification</title>
    <style>
        body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f1f5f9;color:#0f172a}
        .wrap{max-width:560px;margin:0 auto;padding:1.5rem 1rem}
        .card{background:#fff;border-radius:16px;box-shadow:0 8px 30px rgba(15,23,42,.08);overflow:hidden}
        .banner{padding:1.4rem 1.4rem;color:#fff;text-align:center}
        .ok{background:linear-gradient(135deg,#059669,#10b981)}.bad{background:linear-gradient(135deg,#dc2626,#f87171)}
        .banner .ic{font-size:2.6rem;line-height:1}
        .banner h1{margin:.4rem 0 .2rem;font-size:1.25rem}
        .banner p{margin:0;opacity:.95;font-size:.92rem}
        .body{padding:1.2rem 1.4rem}
        .row{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-bottom:1px solid #eef2f7;font-size:.92rem}
        .row:last-child{border-bottom:0}
        .row span{color:#64748b}.row b{text-align:right}
        .org{text-align:center;color:#64748b;font-size:.82rem;margin-top:1rem}
        .dog{font-size:1.5rem;font-weight:800;text-align:center;margin:.2rem 0 .1rem}
        .sub{text-align:center;color:#64748b;margin-bottom:.8rem;font-size:.9rem}
    </style>
</head>
<body>
<div class="wrap">
    <div class="card">
        <div class="banner @(Model.Valid ? "ok" : "bad")">
            <div class="ic">@(Model.Valid ? "✔" : "✖")</div>
            <h1>@(Model.Valid ? "Certificate verified" : "Certificate not valid")</h1>
            <p>@Model.Message</p>
        </div>
        @if (c != null)
        {
            <div class="body">
                <div class="dog">@c.DogName</div>
                <div class="sub">@(c.Breed + (string.IsNullOrWhiteSpace(c.OwnerName) ? "" : " · Owner: " + c.OwnerName))</div>
                <div class="row"><span>Certificate no.</span><b>@c.CertificateNumber</b></div>
                <div class="row"><span>Programme</span><b>@c.ProgrammeName</b></div>
                <div class="row"><span>Duration</span><b>@c.DurationDays days</b></div>
                <div class="row"><span>Start date</span><b>@(c.StartDate?.ToString("dd MMM yyyy") ?? "—")</b></div>
                <div class="row"><span>Completion date</span><b>@(c.CompletionDate?.ToString("dd MMM yyyy") ?? "—")</b></div>
                <div class="row"><span>Handler</span><b>@(string.IsNullOrWhiteSpace(c.HandlerName) ? "—" : c.HandlerName)</b></div>
                <div class="row"><span>Issued</span><b>@c.IssuedOn.ToString("dd MMM yyyy")</b></div>
                @if (c.IsRevoked && !string.IsNullOrWhiteSpace(c.RevokedReason))
                {
                    <div class="row"><span>Revoked because</span><b>@c.RevokedReason</b></div>
                }
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
    {
        <div class="org">Issued by @Model.CompanyName</div>
    }
</div>
</body>
</html>
