@model Dog.Portal.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<style>
    .login-heading {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
        margin: 0 0 0.3rem;
    }

    .login-sub {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0 0 2rem;
    }

    .form-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 11px;
        transition: border-color 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }

    .input-wrap.focused {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.1);
    }

    .input-wrap.has-error {
        border-color: #f87171;
        box-shadow: 0 0 0 4px rgba(248,113,113,0.1);
    }

    .input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        color: #94a3b8;
        font-size: 1rem;
        flex-shrink: 0;
        transition: color 0.2s;
    }

    .input-wrap.focused .input-icon { color: #667eea; }

    .input-wrap .form-control {
        border: none;
        outline: none;
        box-shadow: none;
        flex: 1;
        padding: 0.8rem 0.75rem 0.8rem 0;
        font-size: 0.9rem;
        color: #1e293b;
        background: transparent;
    }

    .input-wrap .form-control::placeholder { color: #cbd5e1; }
    .input-wrap .form-control:focus { box-shadow: none; }

    .toggle-pw {
        width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        font-size: 1rem;
        transition: color 0.2s;
        flex-shrink: 0;
    }

    .toggle-pw:hover { color: #64748b; }

    .error-text {
        font-size: 0.775rem;
        color: #ef4444;
        margin-top: 0.375rem;
        display: block;
        min-height: 0;
    }
    .error-text:empty { display: none; }
    .error-text:not(:empty) {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }
    .error-text:not(:empty)::before {
        content: "\f33c";
        font-family: "bootstrap-icons";
        font-size: 0.85rem;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.845rem;
        color: #dc2626;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        border: 1.5px solid #cbd5e1;
        border-radius: 5px;
        margin-top: 0.1rem;
        cursor: pointer;
    }

    .form-check-input:checked {
        background-color: #667eea;
        border-color: #667eea;
    }

    .form-check-label {
        font-size: 0.845rem;
        color: #4b5563;
        cursor: pointer;
        margin-left: 0.375rem;
    }

    .forgot-link {
        font-size: 0.845rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    .forgot-link:hover { color: #4f46e5; }

    .btn-signin {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 11px;
        padding: 0.875rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.25s ease;
        letter-spacing: 0.01em;
        box-shadow: 0 4px 16px rgba(102,126,234,0.35);
        position: relative;
        overflow: hidden;
    }

    .btn-signin::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0);
        transition: background 0.2s;
    }

    .btn-signin:hover:not(:disabled)::before { background: rgba(255,255,255,0.08); }

    .btn-signin:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(102,126,234,0.45);
    }

    .btn-signin:active:not(:disabled) { transform: translateY(0); }

    .btn-signin:disabled {
        opacity: 0.75;
        cursor: not-allowed;
        transform: none;
    }

    .divider-text {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #cbd5e1;
        font-size: 0.775rem;
        margin: 1.25rem 0;
    }

    .divider-text::before,
    .divider-text::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e2e8f0;
    }

    .help-text {
        text-align: center;
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 1.5rem;
    }

    .spinner-sm {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- Greeting -->
<div class="mb-4">
    <h1 class="login-heading">Welcome back</h1>
    <p class="login-sub">Sign in to continue to Dog Section</p>
</div>

<form asp-action="Login" method="post" id="loginForm" novalidate>
    @{
        var hasErrors = ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);
    }

    @if (hasErrors)
    {
        <div class="validation-summary">
            <i class="bi bi-exclamation-circle-fill flex-shrink-0" style="margin-top:1px;"></i>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <!-- Identifier -->
    <div class="mb-3">
        <label asp-for="Identifier" class="form-label">Username or Email</label>
        <div class="input-wrap" id="wrapId">
            <div class="input-icon"><i class="bi bi-person"></i></div>
            <input asp-for="Identifier"
                   class="form-control"
                   placeholder="Enter your username"
                   autocomplete="username"
                   autofocus />
        </div>
        <span asp-validation-for="Identifier" class="error-text"></span>
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="input-wrap" id="wrapPw">
            <div class="input-icon"><i class="bi bi-lock"></i></div>
            <input asp-for="Password"
                   class="form-control"
                   type="password"
                   placeholder="Enter your password"
                   autocomplete="current-password"
                   id="passwordInput" />
            <button type="button" class="toggle-pw" id="togglePw" tabindex="-1" title="Show/hide password">
                <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="error-text"></span>
    </div>

    <!-- Remember me + Forgot -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check mb-0">
            <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" />
            <label class="form-check-label" for="rememberCheck">Keep me signed in</label>
        </div>
        <a href="#" class="forgot-link">Forgot password?</a>
    </div>

    <!-- Submit -->
    <button type="submit" class="btn-signin" id="signInBtn">
        <span id="btnContent">
            <i class="bi bi-box-arrow-in-right"></i>
            Sign In
        </span>
        <span id="btnLoading" style="display:none;">
            <span class="spinner-sm"></span>
            Signing in...
        </span>
    </button>
</form>

<div class="help-text">
    Having trouble? Contact your system administrator.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Password visibility toggle ─────────────────────
        const pwInput  = document.getElementById('passwordInput');
        const togglePw = document.getElementById('togglePw');
        const eyeIcon  = document.getElementById('eyeIcon');

        togglePw.addEventListener('click', () => {
            const show = pwInput.type === 'password';
            pwInput.type = show ? 'text' : 'password';
            eyeIcon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        // ── Input focus styling ────────────────────────────
        document.querySelectorAll('.input-wrap').forEach(wrap => {
            const input = wrap.querySelector('input');
            if (!input) return;
            input.addEventListener('focus',  () => wrap.classList.add('focused'));
            input.addEventListener('blur',   () => wrap.classList.remove('focused'));
        });

        // ── Form submit loading state ──────────────────────
        const loginForm   = document.getElementById('loginForm');
        const signInBtn   = document.getElementById('signInBtn');
        const btnContent  = document.getElementById('btnContent');
        const btnLoading  = document.getElementById('btnLoading');

        loginForm.addEventListener('submit', () => {
            if (loginForm.checkValidity()) {
                signInBtn.disabled = true;
                btnContent.style.display = 'none';
                btnLoading.style.display  = 'flex';
                btnLoading.style.alignItems = 'center';
                btnLoading.style.gap = '0.5rem';
            }
        });
    </script>
}
