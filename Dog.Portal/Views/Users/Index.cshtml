<script>
    // ── Modal helpers ─────────────────────────────────────────
    function openModal(id) {
        document.getElementById(id).classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
        document.body.style.overflow = '';
    }
    // Close on backdrop click
    document.querySelectorAll('.modal-backdrop-custom').forEach(bd => {
        bd.addEventListener('click', e => { if (e.target === bd) closeModal(bd.id); });
    });
    // Close on Escape
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-backdrop-custom.open').forEach(m => closeModal(m.id));
        }
    });

    // ── Action menu (fixed-position, escapes overflow containers) ─
    function toggleActMenu(btn) {
        const menu = btn.nextElementSibling;
        const isOpen = menu.classList.contains('open');
        closeAllActMenus();
        if (!isOpen) {
            positionActMenu(btn, menu);
            menu.classList.add('open');
        }
    }

    function closeAllActMenus() {
        document.querySelectorAll('.act-menu.open').forEach(m => {
            m.classList.remove('open');
            m.style.top = ''; m.style.left = ''; m.style.right = '';
        });
    }

    function positionActMenu(btn, menu) {
        // Temporarily show (invisibly) to measure
        menu.style.visibility = 'hidden';
        menu.style.display = 'block';
        const menuRect = menu.getBoundingClientRect();
        menu.style.display = '';
        menu.style.visibility = '';

        const btnRect = btn.getBoundingClientRect();
        const pad = 8;

        // Align right edge of menu with right edge of button
        let right = window.innerWidth - btnRect.right;
        if (right < pad) right = pad;

        // Default: open below
        let top = btnRect.bottom + 4;
        // If not enough room below, open upward
        if (top + menuRect.height > window.innerHeight - pad) {
            const upTop = btnRect.top - menuRect.height - 4;
            if (upTop >= pad) top = upTop;
            else top = Math.max(pad, window.innerHeight - menuRect.height - pad);
        }

        menu.style.top   = top + 'px';
        menu.style.right = right + 'px';
        menu.style.left  = 'auto';
    }

    // Close on outside click
    document.addEventListener('click', e => {
        if (!e.target.closest('.act-wrap')) closeAllActMenus();
    });
    // Close on any scroll (fixed-position won't follow content scroll)
    window.addEventListener('scroll', closeAllActMenus, true);
    window.addEventListener('resize', closeAllActMenus);

    // ── Open Edit ─────────────────────────────────────────────
    function openEdit(menu) {
        menu.classList.remove('open');
        document.getElementById('e_id').value        = menu.dataset.id;
        document.getElementById('e_firstName').value = menu.dataset.firstname || '';
        document.getElementById('e_lastName').value  = menu.dataset.lastname  || '';
        document.getElementById('e_username').value  = menu.dataset.username  || '';
        document.getElementById('e_phone').value     = menu.dataset.phone     || '';
        document.getElementById('e_status').value    = menu.dataset.status    || 'ACTIVE';
        document.getElementById('e_role').value      = menu.dataset.role      || '';
        document.getElementById('e_company').value   = menu.dataset.company   || '0';
        openModal('editModal');
    }

    // ── Open Change Role ──────────────────────────────────────
    function openChangeRole(menu) {
        menu.classList.remove('open');
        document.getElementById('r_id').value      = menu.dataset.id;
        document.getElementById('r_name').textContent = menu.dataset.name;
        document.getElementById('r_role').value    = menu.dataset.role || '';
        openModal('roleModal');
    }

    // ── Open Change Company ───────────────────────────────────
    function openChangeCompany(menu) {
        menu.classList.remove('open');
        document.getElementById('co_id').value      = menu.dataset.id;
        document.getElementById('co_name').textContent = menu.dataset.name;
        document.getElementById('co_company').value = menu.dataset.company || '';
        openModal('companyModal');
    }

    // ── Open Reset Password ───────────────────────────────────
    function openResetPw(menu) {
        menu.classList.remove('open');
        document.getElementById('pw_id').value = menu.dataset.id;
        document.getElementById('pw_name').textContent = menu.dataset.name;
        document.getElementById('pw_password').value = '';
        document.getElementById('pw_confirm').value  = '';
        document.getElementById('pw_pwbar').style.width = '0';
        document.getElementById('pw_err').style.display = 'none';
        document.getElementById('pw_confirm_err').style.display = 'none';
        openModal('pwModal');
    }

    // ── Open Delete ───────────────────────────────────────────
    function openDelete(menu) {
        menu.classList.remove('open');
        document.getElementById('d_id').value = menu.dataset.id;
        document.getElementById('d_name').textContent = menu.dataset.name;
        openModal('deleteModal');
    }

    // ── Password helpers ──────────────────────────────────────
    function togglePw(inputId, btn) {
        const inp = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }
    function checkStrength(inp, barId) {
        const v = inp.value;
        const bar = document.getElementById(barId);
        let score = 0;
        if (v.length >= 8)  score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        const colors = ['#ef4444','#f59e0b','#10b981','#059669'];
        const widths = ['25%','50%','75%','100%'];
        bar.style.width     = score > 0 ? widths[score - 1] : '0';
        bar.style.background = score > 0 ? colors[score - 1] : '';
    }

    // ── Loading state ─────────────────────────────────────────
    function setLoading(btnId, loading, restoreHtml) {
        const btn = document.getElementById(btnId);
        btn.disabled = loading;
        if (loading) btn.innerHTML = '<span class="spin"></span> Saving…';
        else if (restoreHtml) btn.innerHTML = restoreHtml;
    }

    // ── Toast ─────────────────────────────────────────────────
    function showToast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = `toast-msg toast-${type}`;
        el.innerHTML = `<i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill'}"></i>${msg}`;
        wrap.appendChild(el);
        requestAnimationFrame(() => el.classList.add('show'));
        setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 350); }, 3500);
    }

    // ── Validation helper ─────────────────────────────────────
    function showErr(id, msg) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.style.display = msg ? 'block' : 'none';
    }
    function clearErrs(...ids) { ids.forEach(id => showErr(id, '')); }

    // ── Username Validation ───────────────────────────────────
    let usernameCheckTimeout;
    let usernameAvailable = false;

    async function validateUsernameAvailability() {
        const usernameInput = document.getElementById('c_username');
        const username = usernameInput.value.trim();
        const checkDiv = document.getElementById('c_username_check');
        const msgSpan = document.getElementById('c_username_msg');
        const iconSpan = document.getElementById('c_username_icon');

        // Clear previous timeout
        clearTimeout(usernameCheckTimeout);

        // Hide check message if empty
        if (!username) {
            checkDiv.style.display = 'none';
            usernameAvailable = false;
            return;
        }

        // Basic validation: no spaces, min 3 chars, alphanumeric + underscore
        if (!/^[a-zA-Z0-9_]{3,}$/.test(username)) {
            checkDiv.style.display = 'block';
            checkDiv.style.background = '#fee2e2';
            checkDiv.style.color = '#991b1b';
            iconSpan.className = 'bi bi-exclamation-circle-fill';
            msgSpan.textContent = 'Username must be 3+ characters (letters, numbers, underscore only)';
            usernameAvailable = false;
            return;
        }

        // Show loading state
        checkDiv.style.display = 'block';
        checkDiv.style.background = '#fef3c7';
        checkDiv.style.color = '#92400e';
        iconSpan.className = 'bi bi-hourglass-split';
        msgSpan.textContent = 'Checking availability...';

        // Debounce the API call (wait 800ms after user stops typing)
        usernameCheckTimeout = setTimeout(async () => {
            try {
                const response = await fetch(`/Users/CheckUsername?username=${encodeURIComponent(username)}`);
                const data = await response.json();

                if (data.available) {
                    checkDiv.style.display = 'block';
                    checkDiv.style.background = '#d1fae5';
                    checkDiv.style.color = '#065f46';
                    iconSpan.className = 'bi bi-check-circle-fill';
                    msgSpan.textContent = '✓ Username is available';
                    usernameAvailable = true;
                } else {
                    checkDiv.style.display = 'block';
                    checkDiv.style.background = '#fee2e2';
                    checkDiv.style.color = '#991b1b';
                    iconSpan.className = 'bi bi-x-circle-fill';
                    msgSpan.textContent = '✗ Username is already taken';
                    usernameAvailable = false;
                }
            } catch (error) {
                checkDiv.style.display = 'block';
                checkDiv.style.background = '#fee2e2';
                checkDiv.style.color = '#991b1b';
                iconSpan.className = 'bi bi-exclamation-circle-fill';
                msgSpan.textContent = 'Error checking username. Please try again.';
                usernameAvailable = false;
            }
        }, 800);
    }

    // ── Submit Create ─────────────────────────────────────────
    async function submitCreate() {
        clearErrs('c_firstName_err','c_lastName_err','c_username_err','c_email_err','c_password_err','c_role_err','c_company_err');
        const fn  = document.getElementById('c_firstName').value.trim();
        const ln  = document.getElementById('c_lastName').value.trim();
        const un  = document.getElementById('c_username').value.trim();
        const em  = document.getElementById('c_email').value.trim();
        const pw  = document.getElementById('c_password').value;
        const rl  = document.getElementById('c_role').value;
        const co  = document.getElementById('c_company').value;
        const ph  = document.getElementById('c_phone').value.trim();

        let valid = true;
        if (!fn) { showErr('c_firstName_err','First name is required'); valid = false; }
        if (!ln) { showErr('c_lastName_err','Last name is required'); valid = false; }
        if (!un) { showErr('c_username_err','Username is required'); valid = false; }
        if (!usernameAvailable) { showErr('c_username_err','Username is not available or invalid'); valid = false; }
        if (!em || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(em)) { showErr('c_email_err','Valid email is required'); valid = false; }
        if (!pw || pw.length < 8) { showErr('c_password_err','Password must be at least 8 characters'); valid = false; }
        if (!rl) { showErr('c_role_err','Please select a role'); valid = false; }
        if (!co) { showErr('c_company_err','Please select a company'); valid = false; }
        if (!valid) return;

        setLoading('createBtn', true);
        try {
            const res  = await fetch('/Users/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ firstName: fn, lastName: ln, username: un, email: em, password: pw, phoneNumber: ph || null, roleName: rl, companyId: parseInt(co) })
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message || 'User created successfully!', 'success');
                closeModal('createModal');
                setTimeout(() => location.reload(), 900);
            } else {
                showToast(data.message || 'Failed to create user.', 'error');
            }
        } catch { showToast('Network error. Please try again.', 'error'); }
        finally { setLoading('createBtn', false, '<i class="bi bi-person-plus-fill"></i> Create User'); }
    }

    // ── Submit Edit ───────────────────────────────────────────
    async function submitEdit() {
        const id = document.getElementById('e_id').value;
        const fn = document.getElementById('e_firstName').value.trim();
        const ln = document.getElementById('e_lastName').value.trim();
        const un = document.getElementById('e_username').value.trim();
        const ph = document.getElementById('e_phone').value.trim();
        const st = document.getElementById('e_status').value;
        const rl = document.getElementById('e_role').value;
        const co = document.getElementById('e_company').value;

        if (!fn || !ln) { showToast('First and last name are required.', 'error'); return; }

        setLoading('editBtn', true);
        try {
            const res  = await fetch(`/Users/Update/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ firstName: fn, lastName: ln, username: un || null, phoneNumber: ph || null, status: st, roleName: rl, companyId: parseInt(co) || 0 })
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message || 'User updated!', 'success');
                closeModal('editModal');
                setTimeout(() => location.reload(), 900);
            } else {
                showToast(data.message || 'Failed to update user.', 'error');
            }
        } catch { showToast('Network error. Please try again.', 'error'); }
        finally { setLoading('editBtn', false, '<i class="bi bi-check2-circle"></i> Save Changes'); }
    }

