    // ── Submit Reset Password ─────────────────────────────────
    async function submitResetPw() {
        clearErrs('pw_err','pw_confirm_err');
        const id = document.getElementById('pw_id').value;
        const pw = document.getElementById('pw_password').value;
        const cf = document.getElementById('pw_confirm').value;

        let valid = true;
        if (!pw || pw.length < 8) { showErr('pw_err','Password must be at least 8 characters'); valid = false; }
        if (pw !== cf) { showErr('pw_confirm_err','Passwords do not match'); valid = false; }
        if (!valid) return;

        setLoading('pwBtn', true);
        try {
            const res  = await fetch(`/Users/ResetPassword/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newPassword: pw })
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message || 'Password changed!', 'success');
                closeModal('pwModal');
            } else {
                showToast(data.message || 'Failed to change password.', 'error');
            }
        } catch { showToast('Network error. Please try again.', 'error'); }
        finally { setLoading('pwBtn', false, '<i class="bi bi-key-fill"></i> Set Password'); }
    }

