
@model Dog.Portal.Models.InvoiceListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Invoices";
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s}
.btn-nav{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1rem;background:#f1f5f9;color:#374151;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.82rem;font-weight:500;text-decoration:none}
.btn-nav:hover{background:#e2e8f0;color:#1e293b}
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem;cursor:pointer;transition:all .2s;text-decoration:none}
.stat-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.08)}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.si-draft{background:linear-gradient(135deg,#f1f5f9,#e2e8f0);color:#64748b}
.si-sent{background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1d4ed8}
.si-partial{background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e}
.si-paid{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-money{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.stat-body .val{font-size:1.25rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.72rem;color:#94a3b8;font-weight:500;margin-top:.2rem}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:260px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:120px}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem}
.tbl-wrap{overflow-x:auto;min-height:300px}
.dt{width:100%;border-collapse:collapse;table-layout:fixed}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}
.inv-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:700;padding:.25rem .6rem;border-radius:20px}
.inv-draft{background:#f1f5f9;color:#64748b}
.inv-sent{background:#dbeafe;color:#1d4ed8}
.inv-partial{background:#fef3c7;color:#92400e}
.inv-paid{background:#d1fae5;color:#065f46}
.inv-cancelled{background:#fee2e2;color:#991b1b}
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18);min-width:210px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-item i{width:16px;text-align:center}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;color:#64748b;text-decoration:none;background:#fff}
.pb:hover{background:#f8fafc}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
.empty-state h3{font-size:1.1rem;font-weight:600;color:#64748b;margin-bottom:.5rem}
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:700px;max-height:92vh;overflow-y:auto;animation:mslide .22s ease}
.modal-box.sm{max-width:460px}
@@keyframes mslide{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9;position:sticky;top:0;background:#fff;z-index:1}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.modal-close:hover{background:#e2e8f0}
.modal-body-p{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem;position:sticky;bottom:0;background:#fff}
.frow{margin-bottom:1rem}
.frow label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:.375rem}
.frow-2{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.frow-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.75rem}
.finput{width:100%;padding:.65rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;color:#1e293b;background:#fff;outline:none}
.finput:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer}
.btn-cancel:hover{background:#e2e8f0}
.btn-pm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-pm:disabled{opacity:.6;cursor:not-allowed}
.btn-dm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-dm:disabled{opacity:.6;cursor:not-allowed}
.btn-green{padding:.65rem 1.5rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-green:disabled{opacity:.6;cursor:not-allowed}
.del-icon{width:60px;height:60px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#dc2626}
.line-items-table{width:100%;border-collapse:collapse;font-size:.82rem;margin-top:.5rem}
.line-items-table th{padding:.5rem .75rem;background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:.72rem;font-weight:700;color:#64748b;text-transform:uppercase}
.line-items-table td{padding:.5rem .75rem;border-bottom:1px solid #f8fafc;vertical-align:middle}
.line-items-table tr:last-child td{border-bottom:none}
.btn-add-line{display:inline-flex;align-items:center;gap:.3rem;padding:.4rem .875rem;background:#f1f5f9;color:#374151;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;font-weight:600;cursor:pointer;margin-top:.5rem}
.btn-add-line:hover{background:#e2e8f0}
.btn-rm-line{width:26px;height:26px;border:1px solid #fecaca;border-radius:6px;background:#fef2f2;color:#dc2626;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.8rem}
.totals-box{background:#f8fafc;border-radius:10px;padding:1rem;margin-top:1rem}
.totals-row{display:flex;justify-content:space-between;font-size:.855rem;padding:.3rem 0}
.totals-row.total{font-weight:800;font-size:1rem;color:#1e293b;border-top:1px solid #e2e8f0;padding-top:.6rem;margin-top:.3rem}
.pay-method-tabs{display:flex;gap:.5rem;margin-bottom:1rem}
.pay-tab{padding:.5rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;background:#fff;color:#64748b;transition:all .15s}
.pay-tab.active{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent}
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
.spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@@keyframes spin{to{transform:rotate(360deg)}}
</style>
<div class="toast-wrap" id="toastWrap"></div>
@if (ViewBag.Error != null) {
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:.875rem 1.125rem;color:#dc2626;font-size:.845rem;margin-bottom:1.25rem">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@ViewBag.Error
    </div>
}
<div class="page-hdr-row">
  <div class="page-hdr"><h4><i class="bi bi-receipt me-2" style="color:#667eea"></i>Invoices</h4><p>Create and manage customer invoices, payments and receipts</p></div>
  <div class="hdr-actions">
    <a href="@Url.Action("Suspense")" class="btn-nav"><i class="bi bi-bank2" style="color:#667eea"></i> Suspense (@Model.PendingSuspense.Count)</a>
    <a href="@Url.Action("Receipts")" class="btn-nav"><i class="bi bi-receipt-cutoff" style="color:#10b981"></i> Receipts</a>
    <button class="btn-add" onclick="openModal('createModal')"><i class="bi bi-plus-lg"></i> New Invoice</button>
  </div>
</div>
<div class="stats-row">
  <div class="stat-card" onclick="filterByStatus('DRAFT')">
    <div class="stat-icon si-draft"><i class="bi bi-file-earmark"></i></div>
    <div class="stat-body"><div class="val">@Model.DraftCount</div><div class="lbl">Draft</div></div>
  </div>
  <div class="stat-card" onclick="filterByStatus('SENT')">
    <div class="stat-icon si-sent"><i class="bi bi-send"></i></div>
    <div class="stat-body"><div class="val">@Model.SentCount</div><div class="lbl">Sent</div></div>
  </div>
  <div class="stat-card" onclick="filterByStatus('PARTIAL')">
    <div class="stat-icon si-partial"><i class="bi bi-hourglass-split"></i></div>
    <div class="stat-body"><div class="val">@Model.PartialCount</div><div class="lbl">Partial</div></div>
  </div>
  <div class="stat-card" onclick="filterByStatus('PAID')">
    <div class="stat-icon si-paid"><i class="bi bi-check-circle-fill"></i></div>
    <div class="stat-body"><div class="val">@Model.PaidCount</div><div class="lbl">Paid</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon si-money"><i class="bi bi-currency-dollar"></i></div>
    <div class="stat-body"><div class="val" style="font-size:1rem">@Model.TotalOutstanding.ToString("N2")</div><div class="lbl">Outstanding</div></div>
  </div>
</div>
<div class="dc">
  <div class="dc-head">
    <form method="get" style="display:contents">
      <div class="srch-wrap"><i class="bi bi-search"></i><input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search invoice, customer..."></div>
      <select name="status" class="filter-sel">
        <option value="">All Status</option>
        @foreach (var s in new[]{"DRAFT","SENT","PARTIAL","PAID","CANCELLED"}) {
          if (Model.StatusFilter == s) { <option value="@s" selected>@s</option> }
          else { <option value="@s">@s</option> }
        }
      </select>
      <button type="submit" class="btn-srch"><i class="bi bi-funnel-fill"></i> Filter</button>
      @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter)) {
        <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
      }
    </form>
  </div>
  <div class="tbl-wrap">
    @if (Model.InvoiceList.Count > 0) {
      <table class="dt">
        <thead><tr>
          <th style="width:50px">#</th>
          <th style="width:140px">Invoice #</th>
          <th style="width:180px">Customer</th>
          <th style="width:100px">Date</th>
          <th style="width:100px">Due</th>
          <th style="width:110px">Total</th>
          <th style="width:110px">Balance</th>
          <th style="width:90px">Status</th>
          <th style="width:80px;text-align:center">Actions</th>
        </tr></thead>
        <tbody>
          @{ var si = (Model.Page - 1) * Model.PageSize; }
          @for (int i = 0; i < Model.InvoiceList.Count; i++) {
            var item = Model.InvoiceList[i];
            var badgeClass = item.Status switch { "DRAFT" => "inv-draft", "SENT" => "inv-sent", "PARTIAL" => "inv-partial", "PAID" => "inv-paid", _ => "inv-cancelled" };
            var isOverdue = item.Status != "PAID" && item.Status != "CANCELLED" && item.DueDate < DateTime.Today;
            <tr>
              <td><span class="rn">@(si+i+1)</span></td>
              <td><span style="font-weight:700;color:#1e293b;font-family:monospace">@item.InvoiceNumber</span></td>
              <td title="@item.CustomerName">
                <div style="font-weight:600;color:#1e293b">@item.CustomerName</div>
                <div style="font-size:.75rem;color:#94a3b8">@item.CustomerEmail</div>
              </td>
              <td style="font-size:.8rem;color:#64748b">@item.InvoiceDate.ToString("dd MMM yy")</td>
              <td style="font-size:.8rem;color:@(isOverdue ? "#dc2626" : "#64748b");font-weight:@(isOverdue ? "700" : "400")">
                @item.DueDate.ToString("dd MMM yy")
                @if (isOverdue) { <span style="font-size:.65rem;background:#fee2e2;color:#dc2626;padding:.1rem .35rem;border-radius:6px;margin-left:.25rem">OVERDUE</span> }
              </td>
              <td style="font-weight:600">@item.TotalAmount.ToString("N2")</td>
              <td style="font-weight:700;color:@(item.BalanceAmount > 0 ? "#dc2626" : "#065f46")">@item.BalanceAmount.ToString("N2")</td>
              <td><span class="inv-badge @badgeClass">@item.Status</span></td>
              <td style="text-align:center">
                <div class="act-wrap">
                  <button class="act-btn" onclick="toggleActMenu(this)"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu"
                       data-id="@item.Id"
                       data-invnum="@item.InvoiceNumber"
                       data-customer="@item.CustomerName"
                       data-total="@item.TotalAmount"
                       data-balance="@item.BalanceAmount"
                       data-status="@item.Status">
                    <button class="act-item" onclick="viewInvoice(this.closest('.act-menu'))"><i class="bi bi-eye" style="color:#667eea"></i> View Details</button>
                    @if (item.Status == "DRAFT") {
                      <button class="act-item" onclick="sendInvoice(this.closest('.act-menu'))"><i class="bi bi-send" style="color:#1d4ed8"></i> Send Invoice</button>
                    }
                    @if (item.Status == "SENT" || item.Status == "PARTIAL") {
                      <button class="act-item" onclick="openPayModal(this.closest('.act-menu'))"><i class="bi bi-cash-coin" style="color:#10b981"></i> Record Payment</button>
                      <button class="act-item" onclick="openClaimModal(this.closest('.act-menu'))"><i class="bi bi-bank2" style="color:#f59e0b"></i> Claim Bank Tx</button>
                      <button class="act-item" onclick="openApplyModal(this.closest('.act-menu'))"><i class="bi bi-arrow-left-right" style="color:#7c3aed"></i> Apply Suspense</button>
                    }
                    @if (item.Status != "PAID" && item.Status != "CANCELLED") {
                      <div class="act-divider"></div>
                      <button class="act-item danger" onclick="cancelInvoice(this.closest('.act-menu'))"><i class="bi bi-x-circle"></i> Cancel</button>
                    }
                    @if (item.Status == "DRAFT") {
                      <button class="act-item danger" onclick="deleteInvoice(this.closest('.act-menu'))"><i class="bi bi-trash3-fill"></i> Delete</button>
                    }
                  </div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    } else {
      <div class="empty-state"><i class="bi bi-receipt"></i><h3>No invoices found</h3><p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Create your first invoice to get started." : "Try adjusting your search.")</p></div>
    }
  </div>
  @if (Model.TotalCount > 0) {
    <div class="dc-foot">
      <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
      @if (Model.TotalPages > 1) {
        <div class="pgn">
          @if (Model.Page > 1) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=Model.StatusFilter, page=Model.Page-1 })" class="pb wide"><i class="bi bi-chevron-left"></i> Prev</a> }
          else { <span class="pb wide off"><i class="bi bi-chevron-left"></i> Prev</span> }
          @for (int p = Math.Max(1,Model.Page-2); p <= Math.Min(Model.TotalPages,Model.Page+2); p++) {
            if (p==Model.Page) { <span class="pb cur">@p</span> }
            else { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=Model.StatusFilter, page=p })" class="pb">@p</a> }
          }
          @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=Model.StatusFilter, page=Model.Page+1 })" class="pb wide">Next <i class="bi bi-chevron-right"></i></a> }
          else { <span class="pb wide off">Next <i class="bi bi-chevron-right"></i></span> }
        </div>
      }
    </div>
  }
</div>

<!-- VIEW DETAILS MODAL -->
<div class="modal-backdrop-custom" id="viewModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-receipt" style="color:#667eea"></i> Invoice Details</h5>
      <button class="modal-close" onclick="closeModal('viewModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.25rem" id="viewMeta"></div>
      <div style="font-size:.8rem;font-weight:700;color:#374151;margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.05em">Balance</div>
      <div id="viewBalance" style="font-size:1.5rem;font-weight:800;color:#dc2626"></div>
    </div>
    <div class="modal-foot"><button class="btn-cancel" onclick="closeModal('viewModal')">Close</button></div>
  </div>
</div>

<!-- CREATE INVOICE MODAL -->
<div class="modal-backdrop-custom" id="createModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-receipt" style="color:#667eea"></i> New Invoice</h5>
      <button class="modal-close" onclick="closeModal('createModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div class="frow-2">
        <div class="frow"><label>Customer Name <span style="color:#ef4444">*</span></label><input class="finput" id="c_customerName" placeholder="Customer name"></div>
        <div class="frow"><label>Customer Email</label><input class="finput" type="email" id="c_customerEmail" placeholder="email@example.com"></div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Customer Phone</label><input class="finput" id="c_customerPhone" placeholder="+1 234 567 8900"></div>
        <div class="frow"><label>Customer ID</label>
          <select class="finput" id="c_customerId">
            <option value="">Select customer (optional)</option>
            @foreach (var c in Model.Customers) { <option value="@c.Id">@c.FullName @(c.Email != null ? "(" + c.Email + ")" : "")</option> }
          </select>
        </div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Invoice Date <span style="color:#ef4444">*</span></label><input class="finput" type="date" id="c_invoiceDate"></div>
        <div class="frow"><label>Due Date <span style="color:#ef4444">*</span></label><input class="finput" type="date" id="c_dueDate"></div>
      </div>
      <div style="font-size:.85rem;font-weight:700;color:#374151;margin-bottom:.5rem;margin-top:.5rem">Line Items</div>
      <table class="line-items-table">
        <thead><tr><th>Description</th><th style="width:70px">Qty</th><th style="width:90px">Unit Price</th><th style="width:70px">Tax%</th><th style="width:70px">Disc%</th><th style="width:90px">Amount</th><th style="width:30px"></th></tr></thead>
        <tbody id="lineItemsBody"></tbody>
      </table>
      <button class="btn-add-line" onclick="addLineItem()"><i class="bi bi-plus"></i> Add Line</button>
      <div class="totals-box">
        <div class="totals-row"><span>Subtotal</span><span id="t_subtotal">0.00</span></div>
        <div class="frow-2" style="margin-top:.5rem">
          <div class="frow"><label>Tax Amount</label><input class="finput" type="number" id="c_taxAmount" value="0" min="0" step="0.01" oninput="recalcTotals()"></div>
          <div class="frow"><label>Discount Amount</label><input class="finput" type="number" id="c_discountAmount" value="0" min="0" step="0.01" oninput="recalcTotals()"></div>
        </div>
        <div class="totals-row total"><span>TOTAL</span><span id="t_total">0.00</span></div>
      </div>
      <div class="frow" style="margin-top:1rem"><label>Notes</label><textarea class="finput" id="c_notes" rows="2" placeholder="Optional notes..."></textarea></div>
      <div class="frow"><label>Terms</label><textarea class="finput" id="c_terms" rows="2" placeholder="Payment terms..."></textarea></div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('createModal')">Cancel</button>
      <button class="btn-pm" id="createBtn" onclick="submitCreate()"><i class="bi bi-receipt"></i> Create Invoice</button>
    </div>
  </div>
</div>

<!-- RECORD PAYMENT MODAL -->
<div class="modal-backdrop-custom" id="payModal">
  <div class="modal-box sm">
    <div class="modal-hdr">
      <h5><i class="bi bi-cash-coin" style="color:#10b981"></i> Record Payment</h5>
      <button class="modal-close" onclick="closeModal('payModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <input type="hidden" id="p_invoiceId">
      <div style="background:#f8fafc;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem">
        <div style="font-size:.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase">Invoice</div>
        <div id="p_invoiceInfo" style="font-weight:700;color:#1e293b;font-size:.9rem"></div>
      </div>
      <div class="pay-method-tabs">
        <button class="pay-tab active" onclick="setPayMethod(this,'CASH')"><i class="bi bi-cash"></i> Cash</button>
        <button class="pay-tab" onclick="setPayMethod(this,'ECOCASH')"><i class="bi bi-phone"></i> EcoCash</button>
        <button class="pay-tab" onclick="setPayMethod(this,'BANK')"><i class="bi bi-bank2"></i> Bank</button>
      </div>
      <input type="hidden" id="p_payMethod" value="CASH">
      <div class="frow"><label>Amount <span style="color:#ef4444">*</span></label><input class="finput" type="number" id="p_amount" min="0.01" step="0.01" placeholder="0.00"></div>
      <div class="frow"><label>Reference / Transaction ID</label><input class="finput" id="p_reference" placeholder="e.g. EcoCash ref, bank ref..."></div>
      <div class="frow"><label>Notes</label><textarea class="finput" id="p_notes" rows="2" placeholder="Optional notes..."></textarea></div>

      <!-- Bank-specific fields (shown only when BANK tab is active) -->
      <div id="bankFields" style="display:none;border-top:1px solid #f1f5f9;padding-top:1rem;margin-top:.5rem">
        <div style="font-size:.78rem;font-weight:700;color:#374151;margin-bottom:.75rem;display:flex;align-items:center;gap:.4rem">
          <i class="bi bi-bank2" style="color:#f59e0b"></i> Bank Payment Details
        </div>
        <div class="frow-2">
          <div class="frow"><label>Bank <span style="color:#ef4444">*</span></label>
            <select class="finput" id="p_bankId" onchange="onBankChange(this)">
              <option value="">Select bank</option>
              @foreach (var b in Model.Banks) {
                <option value="@b.Id">@b.Name@(b.AccountName != null ? " — " + b.AccountName : "")</option>
              }
            </select>
          </div>
          <div class="frow"><label>Bank Account <span style="color:#ef4444">*</span></label>
            <select class="finput" id="p_bankAccountId" onchange="onBankAccountChange(this)">
              <option value="">— select bank first —</option>
            </select>
          </div>
        </div>
        <div class="frow-2">
          <div class="frow">
            <label>Account Number</label>
            <input class="finput" id="p_accountNumber" placeholder="Auto-filled from account" readonly style="background:#f8fafc;color:#64748b">
          </div>
          <div class="frow">
            <label>Currency <span style="color:#ef4444">*</span></label>
            <input class="finput" id="p_currencyDisplay" placeholder="Auto-filled from account" readonly style="background:#f8fafc;color:#64748b">
            <input type="hidden" id="p_currencyId">
          </div>
        </div>
        <div class="frow-2">
          <div class="frow"><label>Customer <span style="color:#ef4444">*</span></label>
            <select class="finput" id="p_customerId">
              <option value="">Select customer</option>
              @foreach (var c in Model.Customers) { <option value="@c.Id">@c.FullName</option> }
            </select>
          </div>
          <div class="frow"><label>Statement Reference</label><input class="finput" id="p_statementRef" placeholder="Bank statement reference"></div>
        </div>

        <!-- POP Upload -->
        <div style="background:#fef3c7;border:1.5px dashed #f59e0b;border-radius:10px;padding:1rem;margin-top:.5rem">
          <div style="font-size:.8rem;font-weight:700;color:#92400e;margin-bottom:.5rem;display:flex;align-items:center;gap:.4rem">
            <i class="bi bi-paperclip"></i> Proof of Payment (POP) <span style="color:#ef4444">*</span>
          </div>
          <input type="file" id="p_popFile" accept=".pdf,.jpg,.jpeg,.png,.gif" style="display:none" onchange="handlePopFile(this)">
          <div id="popDropZone" onclick="document.getElementById('p_popFile').click()"
               style="border:1.5px dashed #e2e8f0;border-radius:8px;padding:1.25rem;text-align:center;cursor:pointer;background:#fff;transition:all .15s"
               ondragover="event.preventDefault();this.style.borderColor='#667eea'"
               ondragleave="this.style.borderColor='#e2e8f0'"
               ondrop="handlePopDrop(event)">
            <i class="bi bi-cloud-upload" style="font-size:1.5rem;color:#94a3b8;display:block;margin-bottom:.4rem"></i>
            <div style="font-size:.82rem;color:#64748b;font-weight:500">Click to upload or drag & drop</div>
            <div style="font-size:.72rem;color:#94a3b8;margin-top:.2rem">PDF, JPG, PNG (max 5MB)</div>
          </div>
          <div id="popFileInfo" style="display:none;margin-top:.5rem;background:#d1fae5;border-radius:7px;padding:.5rem .75rem;align-items:center;gap:.5rem;font-size:.82rem;color:#065f46">
            <i class="bi bi-file-earmark-check-fill"></i>
            <span id="popFileName"></span>
            <button onclick="clearPop()" style="margin-left:auto;background:none;border:none;color:#065f46;cursor:pointer;font-size:.8rem"><i class="bi bi-x"></i></button>
          </div>
        </div>
      </div>

      <!-- Embed bank accounts as JSON for client-side lookup -->
      <script id="bankAccountsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BankAccounts))</script>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('payModal')">Cancel</button>
      <button class="btn-green" id="payBtn" onclick="submitPayment()"><i class="bi bi-check-circle"></i> Record Payment</button>
    </div>
  </div>
</div>

<!-- CLAIM BANK TRANSACTION MODAL -->
