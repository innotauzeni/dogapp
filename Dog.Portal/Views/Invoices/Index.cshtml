<!-- APPLY SUSPENSE MODAL -->
<div class="modal-backdrop-custom" id="applyModal">
  <div class="modal-box sm">
    <div class="modal-hdr">
      <h5><i class="bi bi-arrow-left-right" style="color:#7c3aed"></i> Apply Suspense</h5>
      <button class="modal-close" onclick="closeModal('applyModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <input type="hidden" id="ap_invoiceId">
      <div style="background:#ede9fe;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;font-size:.82rem;color:#6d28d9">
        <i class="bi bi-info-circle me-1"></i> Apply a suspense entry to pay this invoice. Suspense will be marked UTILIZED and a receipt generated.
      </div>
      <div class="frow"><label>Suspense Entry <span style="color:#ef4444">*</span></label>
        <select class="finput" id="ap_suspenseId" onchange="setSuspenseAmount(this)">
          <option value="">Select pending suspense</option>
          @foreach (var s in Model.PendingSuspense) { <option value="@s.Id" data-amount="@s.Amount">@s.CustomerName - @s.Amount.ToString("N2") @s.CurrencyCode</option> }
        </select>
      </div>
      <div class="frow"><label>Amount to Apply <span style="color:#ef4444">*</span></label><input class="finput" type="number" id="ap_amount" min="0.01" step="0.01" placeholder="0.00"></div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('applyModal')">Cancel</button>
      <button class="btn-pm" id="applyBtn" onclick="submitApply()"><i class="bi bi-check2-circle"></i> Apply & Generate Receipt</button>
    </div>
  </div>
</div>

<script>
var _currentInvoiceId = null;

function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.modal-backdrop-custom').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)closeModal(bd.id);});});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop-custom.open').forEach(function(m){closeModal(m.id);});}});

function toggleActMenu(btn){var menu=btn.nextElementSibling;var isOpen=menu.classList.contains('open');closeAllActMenus();if(!isOpen){positionActMenu(btn,menu);menu.classList.add('open');}}
function closeAllActMenus(){document.querySelectorAll('.act-menu.open').forEach(function(m){m.classList.remove('open');m.style.top='';m.style.left='';m.style.right='';});}
function positionActMenu(btn,menu){menu.style.visibility='hidden';menu.style.display='block';var mr=menu.getBoundingClientRect();menu.style.display='';menu.style.visibility='';var br=btn.getBoundingClientRect();var right=window.innerWidth-br.right;if(right<8)right=8;var top=br.bottom+4;if(top+mr.height>window.innerHeight-8){var up=br.top-mr.height-4;top=up>=8?up:Math.max(8,window.innerHeight-mr.height-8);}menu.style.top=top+'px';menu.style.right=right+'px';menu.style.left='auto';}
document.addEventListener('click',function(e){if(!e.target.closest('.act-wrap'))closeAllActMenus();});
window.addEventListener('scroll',closeAllActMenus,true);
window.addEventListener('resize',closeAllActMenus);

function setLoading(id,on,html){var b=document.getElementById(id);b.disabled=on;if(on)b.innerHTML='<span class="spin"></span> Saving...';else if(html)b.innerHTML=html;}
function showToast(msg,type){var w=document.getElementById('toastWrap');var el=document.createElement('div');el.className='toast-msg toast-'+type;el.innerHTML='<i class="bi '+(type==='success'?'bi-check-circle-fill':'bi-exclamation-circle-fill')+'"></i>'+msg;w.appendChild(el);requestAnimationFrame(function(){el.classList.add('show');});setTimeout(function(){el.classList.remove('show');setTimeout(function(){el.remove();},350);},4000);}
function filterByStatus(s){window.location.href='?status='+s;}

function drow(l,v){return '<div><div style="font-size:.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;margin-bottom:.2rem">'+l+'</div><div style="font-size:.875rem;color:#1e293b;font-weight:600">'+(v||'-')+'</div></div>';}

function viewInvoice(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('viewMeta').innerHTML=drow('Invoice #',d.invnum)+drow('Customer',d.customer)+drow('Total',parseFloat(d.total).toFixed(2))+drow('Status',d.status);var bal=parseFloat(d.balance);document.getElementById('viewBalance').textContent=bal.toFixed(2);document.getElementById('viewBalance').style.color=bal>0?'#dc2626':'#065f46';openModal('viewModal');}

// ── CREATE INVOICE ────────────────────────────────────────────────────────────
var lineCount = 0;
function addLineItem(){
    lineCount++;
    var tbody = document.getElementById('lineItemsBody');
    var tr = document.createElement('tr');
    tr.id = 'line_'+lineCount;
    tr.innerHTML = '<td><input class="finput" style="padding:.4rem .5rem" placeholder="Description" oninput="recalcTotals()"></td>'+
        '<td><input class="finput" style="padding:.4rem .5rem" type="number" value="1" min="1" oninput="recalcTotals()"></td>'+
        '<td><input class="finput" style="padding:.4rem .5rem" type="number" value="0" min="0" step="0.01" oninput="recalcTotals()"></td>'+
        '<td><input class="finput" style="padding:.4rem .5rem" type="number" value="0" min="0" max="100" oninput="recalcTotals()"></td>'+
        '<td><input class="finput" style="padding:.4rem .5rem" type="number" value="0" min="0" max="100" oninput="recalcTotals()"></td>'+
        '<td id="amt_'+lineCount+'" style="font-weight:600;color:#1e293b">0.00</td>'+
        '<td><button class="btn-rm-line" onclick="removeLine('+lineCount+')"><i class="bi bi-x"></i></button></td>';
    tbody.appendChild(tr);
    recalcTotals();
}
function removeLine(id){var r=document.getElementById('line_'+id);if(r)r.remove();recalcTotals();}
function recalcTotals(){
    var rows=document.getElementById('lineItemsBody').querySelectorAll('tr');
    var subtotal=0;
    rows.forEach(function(r){
        var inputs=r.querySelectorAll('input');
        var qty=parseFloat(inputs[1].value)||0;
        var price=parseFloat(inputs[2].value)||0;
        var tax=parseFloat(inputs[3].value)||0;
        var disc=parseFloat(inputs[4].value)||0;
        var amt=qty*price*(1-disc/100)*(1+tax/100);
        subtotal+=qty*price;
        var id=r.id.replace('line_','');
        var amtEl=document.getElementById('amt_'+id);
        if(amtEl)amtEl.textContent=amt.toFixed(2);
    });
    document.getElementById('t_subtotal').textContent=subtotal.toFixed(2);
    var tax=parseFloat(document.getElementById('c_taxAmount').value)||0;
    var disc=parseFloat(document.getElementById('c_discountAmount').value)||0;
    var total=subtotal-disc+tax;
    document.getElementById('t_total').textContent=total.toFixed(2);
}
function openCreateModal(){
    document.getElementById('c_customerName').value='';document.getElementById('c_customerEmail').value='';
    document.getElementById('c_customerPhone').value='';document.getElementById('c_customerId').value='';
    document.getElementById('c_invoiceDate').value=new Date().toISOString().split('T')[0];
    var due=new Date();due.setDate(due.getDate()+30);
    document.getElementById('c_dueDate').value=due.toISOString().split('T')[0];
    document.getElementById('c_taxAmount').value='0';document.getElementById('c_discountAmount').value='0';
    document.getElementById('c_notes').value='';document.getElementById('c_terms').value='';
    document.getElementById('lineItemsBody').innerHTML='';lineCount=0;
    addLineItem();
    openModal('createModal');
}
async function submitCreate(){
    var name=document.getElementById('c_customerName').value.trim();
    var invDate=document.getElementById('c_invoiceDate').value;
    var dueDate=document.getElementById('c_dueDate').value;
    if(!name){showToast('Customer name is required.','error');return;}
    if(!invDate||!dueDate){showToast('Invoice and due dates are required.','error');return;}
    var rows=document.getElementById('lineItemsBody').querySelectorAll('tr');
    if(rows.length===0){showToast('Add at least one line item.','error');return;}
    var items=[];
    rows.forEach(function(r){
        var inputs=r.querySelectorAll('input');
        items.push({description:inputs[0].value.trim(),quantity:parseInt(inputs[1].value)||1,unitPrice:parseFloat(inputs[2].value)||0,taxRate:parseFloat(inputs[3].value)||0,discountRate:parseFloat(inputs[4].value)||0});
    });
    setLoading('createBtn',true);
    try{
        var r=await fetch('/Invoices/Create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({customerName:name,customerEmail:document.getElementById('c_customerEmail').value.trim(),customerPhone:document.getElementById('c_customerPhone').value.trim(),customerId:document.getElementById('c_customerId').value||null,invoiceDate:invDate,dueDate:dueDate,taxAmount:parseFloat(document.getElementById('c_taxAmount').value)||0,discountAmount:parseFloat(document.getElementById('c_discountAmount').value)||0,notes:document.getElementById('c_notes').value.trim(),terms:document.getElementById('c_terms').value.trim(),items:items})});
        var d=await r.json();
        if(d.success){showToast(d.message||'Invoice created!','success');closeModal('createModal');setTimeout(function(){location.reload();},1200);}
        else showToast(d.message||'Failed.','error');
    }catch(e){showToast('Network error.','error');}
    finally{setLoading('createBtn',false,'<i class="bi bi-receipt"></i> Create Invoice');}
}

// ── SEND / CANCEL / DELETE ────────────────────────────────────────────────────
async function sendInvoice(menu){closeAllActMenus();var id=menu.dataset.id;if(!confirm('Send invoice '+menu.dataset.invnum+'?'))return;try{var r=await fetch('/Invoices/Send/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast(d.message||'Invoice sent!','success');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}}
async function cancelInvoice(menu){closeAllActMenus();var id=menu.dataset.id;if(!confirm('Cancel invoice '+menu.dataset.invnum+'? This cannot be undone.'))return;try{var r=await fetch('/Invoices/Cancel/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast(d.message||'Cancelled.','success');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}}
async function deleteInvoice(menu){closeAllActMenus();var id=menu.dataset.id;if(!confirm('Delete invoice '+menu.dataset.invnum+'?'))return;try{var r=await fetch('/Invoices/Delete/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast(d.message||'Deleted.','success');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}}

// ── RECORD PAYMENT ────────────────────────────────────────────────────────────
var _popFileBase64 = null;
var _popFileName = null;

function setPayMethod(btn,method){
    document.querySelectorAll('.pay-tab').forEach(function(t){t.classList.remove('active');});
    btn.classList.add('active');
    document.getElementById('p_payMethod').value=method;
    // Show/hide bank fields
    document.getElementById('bankFields').style.display = method === 'BANK' ? 'block' : 'none';
}

function handlePopFile(input){
    var file = input.files[0];
    if(!file) return;
    if(file.size > 5*1024*1024){showToast('File too large. Max 5MB.','error');return;}
    _popFileName = file.name;
    var reader = new FileReader();
    reader.onload = function(e){
        var b64 = e.target.result.split(',')[1]; // strip data URI prefix
        _popFileBase64 = b64;
        document.getElementById('popDropZone').style.display='none';
        var info = document.getElementById('popFileInfo');
        info.style.display='flex';
        document.getElementById('popFileName').textContent = file.name + ' (' + (file.size/1024).toFixed(1) + ' KB)';
    };
    reader.readAsDataURL(file);
}

function handlePopDrop(e){
    e.preventDefault();
    document.getElementById('popDropZone').style.borderColor='#e2e8f0';
    var file = e.dataTransfer.files[0];
    if(file){
        var dt = new DataTransfer();
        dt.items.add(file);
        document.getElementById('p_popFile').files = dt.files;
        handlePopFile(document.getElementById('p_popFile'));
    }
}

function clearPop(){
    _popFileBase64=null;_popFileName=null;
    document.getElementById('p_popFile').value='';
    document.getElementById('popDropZone').style.display='block';
    document.getElementById('popFileInfo').style.display='none';
}

function openPayModal(menu){
    closeAllActMenus();
    var d=menu.dataset;
    document.getElementById('p_invoiceId').value=d.id;
    document.getElementById('p_invoiceInfo').textContent=d.invnum+' — Balance: '+parseFloat(d.balance).toFixed(2);
    document.getElementById('p_amount').value='';
    document.getElementById('p_reference').value='';
    document.getElementById('p_notes').value='';
    document.getElementById('bankFields').style.display='none';
    // Reset bank fields
    document.getElementById('p_bankId').value='';
    document.getElementById('p_bankAccountId').innerHTML='<option value="">— select bank first —</option>';
    document.getElementById('p_accountNumber').value='';
    document.getElementById('p_currencyDisplay').value='';
    document.getElementById('p_currencyId').value='';
    document.getElementById('p_customerId').value='';
    document.getElementById('p_statementRef').value='';
    clearPop();
    document.querySelectorAll('.pay-tab').forEach(function(t){t.classList.remove('active');});
    document.querySelector('.pay-tab').classList.add('active');
    document.getElementById('p_payMethod').value='CASH';
    openModal('payModal');
}

async function submitPayment(){
    var id=document.getElementById('p_invoiceId').value;
    var amt=parseFloat(document.getElementById('p_amount').value);
    var method=document.getElementById('p_payMethod').value;
    if(!amt||amt<=0){showToast('Enter a valid amount.','error');return;}

    if(method === 'BANK'){
        // Bank payment requires POP + bank details
        var bankId=parseInt(document.getElementById('p_bankId').value);
        var currencyId=parseInt(document.getElementById('p_currencyId').value);
        var customerId=parseInt(document.getElementById('p_customerId').value);
        if(!bankId){showToast('Please select a bank.','error');return;}
        if(!currencyId){showToast('Please select a currency.','error');return;}
        if(!customerId){showToast('Please select a customer.','error');return;}
        if(!_popFileBase64){showToast('Please upload Proof of Payment (POP).','error');return;}

        setLoading('payBtn',true);
        try{
            var r=await fetch('/Invoices/SubmitBankPayment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                invoiceId:parseInt(id),amount:amt,bankId:bankId,currencyId:currencyId,customerId:customerId,
                accountNumber:document.getElementById('p_accountNumber').value.trim(),
                statementReference:document.getElementById('p_statementRef').value.trim(),
                description:document.getElementById('p_notes').value.trim(),
                popFileBase64:_popFileBase64,popFileName:_popFileName
            })});
            var d=await r.json();
            if(d.success){showToast(d.message||'Bank payment submitted! POP saved. Awaiting finance review.','success');closeModal('payModal');setTimeout(function(){location.reload();},1200);}
            else showToast(d.message||'Failed.','error');
        }catch(e){showToast('Network error.','error');}
        finally{setLoading('payBtn',false,'<i class="bi bi-check-circle"></i> Record Payment');}
    } else {
        // Cash or EcoCash — direct payment
        setLoading('payBtn',true);
        try{
            var r=await fetch('/Invoices/RecordPayment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({invoiceId:parseInt(id),amount:amt,paymentMethod:method,referenceNumber:document.getElementById('p_reference').value.trim(),notes:document.getElementById('p_notes').value.trim()})});
            var d=await r.json();
            if(d.success){showToast(d.message||'Payment recorded!','success');closeModal('payModal');setTimeout(function(){location.reload();},1200);}
            else showToast(d.message||'Failed.','error');
        }catch(e){showToast('Network error.','error');}
        finally{setLoading('payBtn',false,'<i class="bi bi-check-circle"></i> Record Payment');}
    }
}

// ── BANK ACCOUNT AUTO-POPULATE ────────────────────────────────────────────────
var _bankAccounts = [];
(function(){
    try{
        var el = document.getElementById('bankAccountsData');
        if(el) _bankAccounts = JSON.parse(el.textContent || '[]');
    }catch(e){ _bankAccounts = []; }
})();

function onBankChange(sel){
    var bankId = parseInt(sel.value);
    var accSel = document.getElementById('p_bankAccountId');
    // Clear previous options
    accSel.innerHTML = '<option value="">— select account —</option>';
    document.getElementById('p_accountNumber').value = '';
    document.getElementById('p_currencyDisplay').value = '';
    document.getElementById('p_currencyId').value = '';
    if(!bankId) return;
    // Filter accounts for this bank
    var filtered = _bankAccounts.filter(function(a){ return a.bankId === bankId; });
    if(filtered.length === 0){
        accSel.innerHTML = '<option value="">No accounts found for this bank</option>';
        return;
    }
    filtered.forEach(function(a){
        var opt = document.createElement('option');
        opt.value = a.id;
        opt.textContent = (a.name || a.accountNumber || 'Account') + (a.accountNumber ? ' — ' + a.accountNumber : '') + (a.currencyCode ? ' (' + a.currencyCode + ')' : '');
        opt.dataset.accountNumber = a.accountNumber || '';
        opt.dataset.currencyId = a.currencyId || '';
        opt.dataset.currencyCode = a.currencyCode || '';
        opt.dataset.currencyName = a.currencyName || '';
        accSel.appendChild(opt);
    });
    // Auto-select if only one account
    if(filtered.length === 1){
        accSel.selectedIndex = 1;
        onBankAccountChange(accSel);
    }
}

function onBankAccountChange(sel){
    var opt = sel.options[sel.selectedIndex];
    if(!opt || !opt.value){
        document.getElementById('p_accountNumber').value = '';
        document.getElementById('p_currencyDisplay').value = '';
        document.getElementById('p_currencyId').value = '';
        return;
    }
    document.getElementById('p_accountNumber').value = opt.dataset.accountNumber || '';
    var currCode = opt.dataset.currencyCode || '';
    var currName = opt.dataset.currencyName || '';
    document.getElementById('p_currencyDisplay').value = currCode + (currName ? ' — ' + currName : '');
    document.getElementById('p_currencyId').value = opt.dataset.currencyId || '';
}

