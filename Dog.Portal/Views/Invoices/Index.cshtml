  <div class="modal-box sm">
    <div class="modal-hdr">
      <h5><i class="bi bi-bank2" style="color:#f59e0b"></i> Claim Bank Transaction</h5>
      <button class="modal-close" onclick="closeModal('claimModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <input type="hidden" id="cl_invoiceId">
      <div style="background:#fef3c7;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;font-size:.82rem;color:#92400e">
        <i class="bi bi-info-circle me-1"></i> Finance claims a bank transaction → creates a suspense entry that can be applied to this invoice.
      </div>
      <div class="frow"><label>Bank Transaction <span style="color:#ef4444">*</span></label>
        <select class="finput" id="cl_bankTxId">
          <option value="">Select unclaimed bank transaction</option>
