@model Dog.Portal.Models.ModuleDetailViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Module.Name;
}

<style>
    /* reuse same table system as Index */
    .page-hdr h4 { font-size: 1.1rem; font-weight: 800; color: #0f172a; margin: 0 0 0.25rem; letter-spacing: -0.02em; }
    .page-hdr p  { font-size: 0.845rem; color: #64748b; margin: 0; }

    /* Breadcrumb */
    .bcrumb { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8rem; color: #94a3b8; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .bcrumb a   { color: #667eea; text-decoration: none; font-weight: 500; }
    .bcrumb a:hover { color: #4f46e5; }
    .bcrumb .sep { color: #e2e8f0; }
    .bcrumb .cur { color: #374151; font-weight: 600; }

    /* Module info hero card */
    .mod-hero {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e9eef4;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04), 0 6px 20px rgba(0,0,0,0.04);
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 1.375rem;
        flex-wrap: wrap;
    }

    .mod-hero-icon {
        width: 58px; height: 58px; border-radius: 14px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; color: #fff; flex-shrink: 0;
        box-shadow: 0 6px 18px rgba(102,126,234,0.3);
    }

    .mod-hero-body { flex: 1; min-width: 0; }
    .mod-hero-body h5 { font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 0.3rem; }
    .mod-hero-body p  { font-size: 0.855rem; color: #64748b; margin: 0 0 0.75rem; }

    .mod-meta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .mm-item  { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8rem; color: #64748b; }
    .mm-item i { color: #94a3b8; }

    .ctag {
        display: inline-block; background: #f1f5f9; border: 1px solid #e2e8f0;
        color: #475569; font-size: 0.76rem;
        font-family: 'Consolas', 'Monaco', monospace;
        padding: 0.2rem 0.5rem; border-radius: 5px;
    }

    .s-on  { background: #d1fae5; color: #065f46; font-size: 0.74rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 20px; display: inline-flex; align-items: center; gap: 0.3rem; }
    .s-off { background: #fee2e2; color: #991b1b; font-size: 0.74rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 20px; display: inline-flex; align-items: center; gap: 0.3rem; }

    /* Data card */
    .dc { background: #fff; border-radius: 14px; border: 1px solid #e9eef4; box-shadow: 0 1px 4px rgba(0,0,0,0.04), 0 6px 20px rgba(0,0,0,0.04); overflow: hidden; }

    .dc-head {
        padding: 1rem 1.375rem; border-bottom: 1px solid #f1f5f9; background: #fafbfc;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    }

    .dc-title { font-size: 0.9rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 0.5rem; }
    .dc-title i { color: #667eea; }

    .cc-lrg {
        display: inline-flex; align-items: center; gap: 0.375rem;
        background: #ede9fe; color: #6d28d9;
        font-size: 0.8rem; font-weight: 700;
        padding: 0.3rem 0.75rem; border-radius: 20px;
    }

    /* Search */
    .srch-wrap { position: relative; }
    .srch-wrap i { position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.9rem; pointer-events: none; }
    .srch-input {
        width: 260px; padding: 0.58rem 0.875rem 0.58rem 2.375rem;
        border: 1.5px solid #e2e8f0; border-radius: 9px;
        font-size: 0.845rem; color: #1e293b; background: #fff;
        outline: none; transition: border-color 0.2s, box-shadow 0.2s;
    }
    .srch-input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.1); }
    .srch-input::placeholder { color: #cbd5e1; }

    .btn-srch {
        padding: 0.58rem 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff; border: none; border-radius: 9px; font-size: 0.845rem;
        font-weight: 600; cursor: pointer; transition: opacity 0.2s;
        display: inline-flex; align-items: center; gap: 0.375rem;
    }
    .btn-srch:hover { opacity: 0.9; }

    .btn-clr {
        padding: 0.58rem 0.875rem; background: #f1f5f9; color: #64748b;
        border: 1.5px solid #e2e8f0; border-radius: 9px; font-size: 0.845rem;
        font-weight: 500; cursor: pointer; text-decoration: none;
        display: inline-flex; align-items: center; gap: 0.3rem; transition: all 0.18s;
    }
    .btn-clr:hover { background: #e2e8f0; color: #334155; }

    /* Table */
    .tbl-wrap { overflow-x: auto; }
    .dt { width: 100%; border-collapse: collapse; }
    .dt thead th {
        padding: 0.75rem 1.125rem; font-size: 0.7rem; font-weight: 700;
        color: #64748b; text-transform: uppercase; letter-spacing: 0.09em;
        background: #f8fafc; border-bottom: 1px solid #f0f4f8; white-space: nowrap;
    }
    .dt tbody td {
        padding: 0.875rem 1.125rem; font-size: 0.855rem; color: #374151;
        border-bottom: 1px solid #f8fafc; vertical-align: middle;
    }
    .dt tbody tr:last-child td { border-bottom: none; }
    .dt tbody tr { transition: background 0.15s; }
    .dt tbody tr:hover td { background: #fafbff; }

    .rn { color: #cbd5e1; font-size: 0.8rem; font-weight: 600; }
    .ic  { width: 34px; height: 34px; border-radius: 8px; background: linear-gradient(135deg, #e0f2fe, #bae6fd); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; color: #0369a1; }

    .cn-main { font-weight: 600; color: #1e293b; }
    .cn-sub  { font-size: 0.77rem; color: #94a3b8; margin-top: 0.1rem; }

    /* Route tag */
    .rtag {
        display: inline-flex; align-items: center; gap: 0.3rem;
        background: #f0fdf4; border: 1px solid #bbf7d0;
        color: #166534; font-size: 0.76rem;
        font-family: 'Consolas', 'Monaco', monospace;
        padding: 0.2rem 0.55rem; border-radius: 5px; white-space: nowrap;
    }
    .rtag i { font-size: 0.65rem; }

    /* Permissions button */
    .ab-perms {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.375rem 0.875rem;
        background: #f0fdf4; color: #15803d;
        border: 1.5px solid #bbf7d0; border-radius: 7px;
        font-size: 0.8rem; font-weight: 600;
        text-decoration: none; transition: all 0.18s;
    }
    .ab-perms:hover { background: #dcfce7; color: #166534; border-color: #86efac; }

    /* Footer + pagination */
    .dc-foot {
        padding: 0.9rem 1.375rem; border-top: 1px solid #f1f5f9; background: #fafbfc;
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
    }
    .ri { font-size: 0.82rem; color: #94a3b8; }
    .ri strong { color: #374151; }
    .pgn { display: flex; align-items: center; gap: 0.25rem; }
    .pb {
        display: flex; align-items: center; justify-content: center;
        min-width: 32px; height: 32px; padding: 0 0.5rem;
        border: 1.5px solid #e2e8f0; border-radius: 7px; font-size: 0.8rem;
        font-weight: 500; color: #64748b; text-decoration: none;
        transition: all 0.18s; background: #fff;
    }
    .pb:hover { background: #f8fafc; color: #334155; border-color: #cbd5e1; }
    .pb.cur   { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-color: transparent; font-weight: 700; }
    .pb.off   { opacity: 0.35; pointer-events: none; }
    .pb.wide  { padding: 0 0.875rem; }
    .pgn-dots { padding: 0 0.25rem; color: #cbd5e1; font-size: 0.82rem; }

    /* Empty state */
    .es { text-align: center; padding: 3.5rem 2rem; }
    .es-icon { font-size: 2.75rem; color: #e2e8f0; margin-bottom: 0.875rem; display: block; }
    .es h6   { font-weight: 600; color: #64748b; margin: 0 0 0.375rem; }
    .es p    { font-size: 0.845rem; color: #94a3b8; margin: 0; }

    /* Back button */
    .btn-back {
        display: inline-flex; align-items: center; gap: 0.375rem;
        padding: 0.5rem 1rem; background: #f1f5f9; color: #475569;
        border: 1.5px solid #e2e8f0; border-radius: 9px; font-size: 0.845rem;
        font-weight: 600; text-decoration: none; transition: all 0.18s;
    }
    .btn-back:hover { background: #e2e8f0; color: #334155; }

    @@media (max-width: 576px) {
        .srch-input { width: 100%; }
        .mod-hero { flex-direction: column; }
        .dc-head { flex-direction: column; align-items: stretch; }
    }
</style>

<!-- ── Breadcrumb ───────────────────────────────────────────── -->
<nav class="bcrumb">
    <a href="/SystemModules"><i class="bi bi-grid-3x3-gap-fill me-1"></i>System Modules</a>
    <span class="sep"><i class="bi bi-chevron-right" style="font-size:.65rem;"></i></span>
    <span class="cur">@Model.Module.Name</span>
</nav>

<!-- ── Module hero card ──────────────────────────────────────── -->
<div class="mod-hero">
    <div class="mod-hero-icon">
        <i class="bi @(string.IsNullOrEmpty(Model.Module.Icon) ? "bi-grid" : Model.Module.Icon)"></i>
    </div>
    <div class="mod-hero-body">
        <h5>@Model.Module.Name</h5>
        <p>@(string.IsNullOrEmpty(Model.Module.Description) ? "No description provided." : Model.Module.Description)</p>
        <div class="mod-meta">
            @if (!string.IsNullOrEmpty(Model.Module.AccessName))
            {
                <div class="mm-item">
                    <i class="bi bi-key"></i>
                    <span class="ctag">@Model.Module.AccessName</span>
                </div>
            }
            <div class="mm-item">
                <i class="bi bi-sort-numeric-up"></i>
                <span>Sort order: <strong>@Model.Module.SortOrder</strong></span>
            </div>
            <div class="mm-item">
                @if (Model.Module.IsActive)
                {
                    <span class="s-on"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Active</span>
                }
                else
                {
                    <span class="s-off"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Inactive</span>
                }
            </div>
        </div>
    </div>
    <div>
        <a href="/SystemModules" class="btn-back">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<!-- ── Submodules data card ───────────────────────────────────── -->
<div class="dc">

    <!-- Header -->
    <div class="dc-head">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="dc-title">
                <i class="bi bi-diagram-3-fill"></i> Submodules
            </div>
            <span class="cc-lrg"><i class="bi bi-stack"></i> @Model.TotalCount</span>
            <button class="btn-srch" onclick="openCreateSubmodule()" style="white-space:nowrap;font-size:.8rem;padding:.5rem .875rem;">
                <i class="bi bi-plus-circle"></i> Add Submodule
            </button>
        </div>

        <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <input type="hidden" name="page" value="1" />
            <div class="srch-wrap">
                <i class="bi bi-search"></i>
                <input class="srch-input" type="text" name="search"
                       value="@Model.SearchTerm"
                       placeholder="Search submodules…"
                       autocomplete="off" />
            </div>
            <button type="submit" class="btn-srch"><i class="bi bi-search"></i> Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/SystemModules/Details/@Model.Module.Id" class="btn-clr">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            }
        </form>
    </div>

    <!-- Table -->
    <div class="tbl-wrap">
        <table class="dt">
            <thead>
                <tr>
                    <th style="width:48px;">#</th>
                    <th style="width:52px;">Icon</th>
                    <th>Name</th>
                    <th>Route</th>
                    <th>Access Key</th>
                    <th style="width:70px;" class="d-none d-md-table-cell">Order</th>
                    <th style="width:130px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Submodules.Any())
                {
                    @for (int i = 0; i < Model.Submodules.Count; i++)
                    {
                        var s = Model.Submodules[i];
                        <tr>
                            <td><span class="rn">@(Model.From + i)</span></td>
                            <td>
                                <div class="ic">
                                    <i class="bi @(string.IsNullOrEmpty(s.Icon) ? "bi-circle" : s.Icon)"></i>
                                </div>
                            </td>
                            <td>
                                <div class="cn-main">@(s.Name ?? "—")</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.Route))
                                {
                                    <span class="rtag"><i class="bi bi-link-45deg"></i>/@s.Route</span>
                                }
                                else
                                {
                                    <span style="color:#e2e8f0;">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.AccessName))
                                {
                                    <span class="ctag">@s.AccessName</span>
                                }
                                else
                                {
                                    <span style="color:#e2e8f0;">—</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                <span style="color:#94a3b8;font-weight:600;font-size:.82rem;">@s.Order</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <a href="/SystemModules/Permissions/@s.Id" class="ab-perms" style="padding:.3rem .7rem;font-size:.78rem;">
                                        <i class="bi bi-shield-check"></i> Perms
                                    </a>
                                    <button class="ab-perms" style="padding:.3rem .7rem;font-size:.78rem;background:#fef3c7;color:#92400e;border-color:#fde68a;" onclick='openEditSubmodule(@s.Id, "@s.Name", @s.ModuleId, "@s.Icon", "@s.Route", "@s.AccessName", @s.Order)'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="ab-perms" style="padding:.3rem .7rem;font-size:.78rem;background:#fee2e2;color:#991b1b;border-color:#fecaca;" onclick='openDeleteSubmodule(@s.Id, "@s.Name")'>
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="es">
                                <i class="bi bi-diagram-3 es-icon"></i>
                                <h6>
                                    @(string.IsNullOrEmpty(Model.SearchTerm)
                                        ? "No submodules found"
                                        : "No submodules match your search")
                                </h6>
                                <p>
                                    @(string.IsNullOrEmpty(Model.SearchTerm)
                                        ? "This module has no submodules configured yet."
                                        : "Try a different keyword or clear the filter.")
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    @if (Model.TotalCount > 0)
    {
        <div class="dc-foot">
            <div class="ri">
                Showing <strong>@Model.From</strong>–<strong>@Model.To</strong>
                of <strong>@Model.TotalCount</strong> submodule@(Model.TotalCount != 1 ? "s" : "")
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pgn">
                    @if (Model.Page > 1)
                    {
                        <a class="pb wide" href="?search=@Model.SearchTerm&page=@(Model.Page - 1)&pageSize=@Model.PageSize">
                            <i class="bi bi-chevron-left" style="font-size:.7rem;"></i> Prev
                        </a>
                    }
                    else
                    {
                        <span class="pb wide off"><i class="bi bi-chevron-left" style="font-size:.7rem;"></i> Prev</span>
                    }

                    @{
                        int tp = Model.TotalPages, cp = Model.Page;
                        var pages = new List<int?>();
                        if (tp <= 7) { for (int p = 1; p <= tp; p++) pages.Add(p); }
                        else
                        {
                            pages.Add(1);
                            if (cp > 3) pages.Add(null);
                            for (int p = Math.Max(2, cp - 1); p <= Math.Min(tp - 1, cp + 1); p++) pages.Add(p);
                            if (cp < tp - 2) pages.Add(null);
                            pages.Add(tp);
                        }
                    }

                    @foreach (var pn in pages)
                    {
                        if (pn == null)
                        { <span class="pgn-dots">…</span> }
                        else
                        { <a class="pb @(pn == Model.Page ? "cur" : "")" href="?search=@Model.SearchTerm&page=@pn&pageSize=@Model.PageSize">@pn</a> }
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="pb wide" href="?search=@Model.SearchTerm&page=@(Model.Page + 1)&pageSize=@Model.PageSize">
                            Next <i class="bi bi-chevron-right" style="font-size:.7rem;"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pb wide off">Next <i class="bi bi-chevron-right" style="font-size:.7rem;"></i></span>
                    }
                </nav>
            }
        </div>
    }
</div>

<!-- Toast -->
<div style="position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none;" id="toastWrap"></div>

<!-- Submodule Modal -->
<div class="modal fade" id="submoduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.2);">
            <div class="modal-header" style="border-bottom:1px solid #f1f5f9;">
                <h5 class="modal-title" id="submoduleModalTitle">Add Submodule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="s_id" value="0" />
                <input type="hidden" id="s_moduleId" value="@Model.Module.Id" />
                <div class="mb-3">
                    <label class="form-label">Name <span style="color:#ef4444;">*</span></label>
                    <input type="text" class="form-control" id="s_name" placeholder="e.g. Countries" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Icon (Bootstrap Icon class)</label>
                    <input type="text" class="form-control" id="s_icon" placeholder="e.g. bi-flag-fill" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Route <span style="color:#ef4444;">*</span></label>
                    <input type="text" class="form-control" id="s_route" placeholder="e.g. Countries" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Access Name <span style="color:#ef4444;">*</span></label>
                    <input type="text" class="form-control" id="s_access" placeholder="e.g. countries.view" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Order</label>
                    <input type="number" class="form-control" id="s_order" value="0" />
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f1f5f9;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveSubmoduleBtn" onclick="saveSubmodule()">Save Submodule</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Submodule Modal -->
<div class="modal fade" id="deleteSubmoduleModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger">Delete Submodule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input type="hidden" id="ds_id" />
                <i class="bi bi-trash3 text-danger" style="font-size:3rem;"></i>
                <p class="mt-3">Delete <strong id="ds_name"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="confirmDeleteSubmodule()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
function openCreateSubmodule() {
    document.getElementById('s_id').value = '0';
    document.getElementById('s_moduleId').value = '@Model.Module.Id';
    document.getElementById('s_name').value = '';
    document.getElementById('s_icon').value = '';
    document.getElementById('s_route').value = '';
    document.getElementById('s_access').value = '';
    document.getElementById('s_order').value = '0';
    document.getElementById('submoduleModalTitle').textContent = 'Add Submodule';
    new bootstrap.Modal(document.getElementById('submoduleModal')).show();
}

function openEditSubmodule(id, name, moduleId, icon, route, access, order) {
    document.getElementById('s_id').value = id;
    document.getElementById('s_moduleId').value = moduleId;
    document.getElementById('s_name').value = name;
    document.getElementById('s_icon').value = icon;
    document.getElementById('s_route').value = route;
    document.getElementById('s_access').value = access;
    document.getElementById('s_order').value = order;
    document.getElementById('submoduleModalTitle').textContent = 'Edit Submodule';
    new bootstrap.Modal(document.getElementById('submoduleModal')).show();
}

async function saveSubmodule() {
    const id = parseInt(document.getElementById('s_id').value);
    const payload = {
        name: document.getElementById('s_name').value.trim(),
        moduleId: parseInt(document.getElementById('s_moduleId').value),
        icon: document.getElementById('s_icon').value.trim(),
        route: document.getElementById('s_route').value.trim(),
        accessName: document.getElementById('s_access').value.trim(),
        order: parseInt(document.getElementById('s_order').value)
    };
    if (!payload.name) { showToast('Name is required', 'error'); return; }
    if (!payload.route) { showToast('Route is required', 'error'); return; }
    if (!payload.accessName) { showToast('Access Name is required', 'error'); return; }
    
    const btn = document.getElementById('saveSubmoduleBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    
    try {
        const url = id > 0 ? `/SystemModules/UpdateSubmodule/${id}` : '/SystemModules/CreateSubmodule';
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Saved!', 'success');
            bootstrap.Modal.getInstance(document.getElementById('submoduleModal')).hide();
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(data.message || 'Failed', 'error');
        }
    } catch { showToast('Network error', 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Save Submodule'; }
}

function openDeleteSubmodule(id, name) {
    document.getElementById('ds_id').value = id;
    document.getElementById('ds_name').textContent = name;
    new bootstrap.Modal(document.getElementById('deleteSubmoduleModal')).show();
}

async function confirmDeleteSubmodule() {
    const id = document.getElementById('ds_id').value;
    try {
        const res = await fetch(`/SystemModules/DeleteSubmodule/${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Deleted', 'success');
            bootstrap.Modal.getInstance(document.getElementById('deleteSubmoduleModal')).hide();
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(data.message || 'Failed', 'error');
        }
    } catch { showToast('Network error', 'error'); }
}

function showToast(msg, type) {
    const wrap = document.getElementById('toastWrap');
    const el = document.createElement('div');
    el.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show`;
    el.style.cssText = 'pointer-events:all;box-shadow:0 8px 32px rgba(0,0,0,.15);';
    el.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    wrap.appendChild(el);
    setTimeout(() => el.remove(), 3500);
}
</script>
