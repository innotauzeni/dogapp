@model Dog.Portal.Models.DeploymentListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Deployments";
    var totalAll = Model.TotalCount;
    var activeCount = Model.DeploymentList.Count(d => d.IsActive);
    var inactiveCount = Model.DeploymentList.Count(d => !d.IsActive);
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s}
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.si-total{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.si-active{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-inactive{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:280px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:130px}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem}
.tbl-wrap{overflow-x:auto;min-height:300px}
.dt{width:100%;border-collapse:collapse;table-layout:fixed}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}
.s-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:700;padding:.25rem .65rem;border-radius:20px}
.s-active{background:#d1fae5;color:#065f46}
.s-inactive{background:#fee2e2;color:#991b1b}
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18);min-width:200px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-item i{width:16px;text-align:center}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;color:#64748b;text-decoration:none;background:#fff}
.pb:hover{background:#f8fafc}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
.empty-state h3{font-size:1.1rem;font-weight:600;color:#64748b;margin-bottom:.5rem}
.dep-icon{width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
.dep-cell{display:flex;align-items:center;gap:.625rem}
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:560px;max-height:90vh;overflow-y:auto;animation:mslide .22s ease}
@@keyframes mslide{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.modal-close:hover{background:#e2e8f0}
.modal-body-p{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem}
.frow{margin-bottom:1rem}
.frow label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:.375rem}
.frow-2{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.finput{width:100%;padding:.65rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;color:#1e293b;background:#fff;outline:none}
.finput:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer}
.btn-cancel:hover{background:#e2e8f0}
.btn-pm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-pm:disabled{opacity:.6;cursor:not-allowed}
.btn-dm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-dm:disabled{opacity:.6;cursor:not-allowed}
.del-icon{width:60px;height:60px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#dc2626}
.view-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;background:#f8fafc;border-radius:10px;padding:1rem}
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
.spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@@keyframes spin{to{transform:rotate(360deg)}}
</style>
<div class="page-hdr-row">
  <div class="page-hdr"><h4>Deployments</h4><p>Track dog deployment assignments and locations</p></div>
  <div class="hdr-actions">
    <div class="total-chip"><i class="bi bi-geo-alt"></i> @totalAll Total</div>
    <button type="button" class="btn-add" onclick="openCreateModal()"><i class="bi bi-plus-lg"></i> Add Deployment</button>
  </div>
</div>
<div class="stats-row">
  <div class="stat-card"><div class="stat-icon si-total"><i class="bi bi-geo-alt-fill"></i></div><div class="stat-body"><div class="val">@totalAll</div><div class="lbl">Total</div></div></div>
  <div class="stat-card"><div class="stat-icon si-active"><i class="bi bi-check-circle"></i></div><div class="stat-body"><div class="val">@activeCount</div><div class="lbl">Active</div></div></div>
  <div class="stat-card"><div class="stat-icon si-inactive"><i class="bi bi-x-circle"></i></div><div class="stat-body"><div class="val">@inactiveCount</div><div class="lbl">Inactive</div></div></div>
</div>
<div class="dc">
  <div class="dc-head">
    <form method="get" style="display:contents">
      <div class="srch-wrap"><i class="bi bi-search"></i><input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search location, company, guard..."></div>
      <select name="status" class="filter-sel">
        <option value="">All Status</option>
        @if (ViewBag.StatusFilter == "active") { <option value="active" selected>Active</option> }
        else { <option value="active">Active</option> }
        @if (ViewBag.StatusFilter == "inactive") { <option value="inactive" selected>Inactive</option> }
        else { <option value="inactive">Inactive</option> }
      </select>
      <button type="submit" class="btn-srch"><i class="bi bi-search"></i> Search</button>
      <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
    </form>
  </div>
  <div class="tbl-wrap">
    @if (Model.DeploymentList.Count > 0) {
      <table class="dt">
        <thead><tr>
          <th style="width:50px">#</th>
          <th style="width:80px">Dog ID</th>
          <th style="width:160px">Location</th>
          <th style="width:160px">Deployed To</th>
          <th style="width:160px">Security Guard</th>
          <th style="width:110px">Start Date</th>
          <th style="width:110px">End Date</th>
          <th style="width:90px">Status</th>
          <th style="width:80px">Actions</th>
        </tr></thead>
        <tbody>
          @{ var si = (Model.Page - 1) * Model.PageSize; }
          @for (int i = 0; i < Model.DeploymentList.Count; i++) {
            var item = Model.DeploymentList[i];
            <tr>
              <td><span class="rn">@(si+i+1)</span></td>
              <td>
                <div class="dep-cell">
                  <div class="dep-icon"><i class="bi bi-shield-fill"></i></div>
                  <span style="font-weight:600;color:#1e293b">#@item.DogId</span>
                </div>
              </td>
              <td title="@item.Location">@item.Location</td>
              <td title="@item.CompanyDeployedTo">@item.CompanyDeployedTo</td>
              <td title="@item.SecurityGuardAssigned">@item.SecurityGuardAssigned</td>
              <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
              <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("MMM dd, yyyy") : "-")</td>
              <td><span class="s-badge @(item.IsActive ? "s-active" : "s-inactive")"><i class="bi @(item.IsActive ? "bi-check-circle" : "bi-x-circle")"></i>@(item.IsActive ? "Active" : "Inactive")</span></td>
              <td>
                <div class="act-wrap">
                  <button class="act-btn" onclick="toggleActMenu(this)" title="Actions"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu"
                       data-id="@item.Id"
                       data-dogid="@item.DogId"
                       data-location="@item.Location"
                       data-companydeployedto="@item.CompanyDeployedTo"
                       data-securityguardassigned="@item.SecurityGuardAssigned"
                       data-startdate="@item.StartDate.ToString("yyyy-MM-dd")"
                       data-enddate="@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "")"
                       data-notes="@item.Notes"
                       data-isactive="@item.IsActive.ToString().ToLower()">
                    <button class="act-item" onclick="openView(this.closest('.act-menu'))"><i class="bi bi-eye" style="color:#667eea"></i> View Details</button>
                    <button class="act-item" onclick="openEdit(this.closest('.act-menu'))"><i class="bi bi-pencil-fill" style="color:#667eea"></i> Edit</button>
                    <div class="act-divider"></div>
                    <button class="act-item danger" onclick="openDelete(this.closest('.act-menu'))"><i class="bi bi-trash3-fill"></i> Delete</button>
                  </div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    } else {
      <div class="empty-state"><i class="bi bi-geo-alt"></i><h3>No deployments found</h3><p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Get started by adding your first deployment." : "Try adjusting your search.")</p></div>
    }
  </div>
  @if (Model.TotalCount > 0) {
    <div class="dc-foot">
      <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
      @if (Model.TotalPages > 1) {
        <div class="pgn">
          @if (Model.Page > 1) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=ViewBag.StatusFilter, page=Model.Page-1 })" class="pb wide"><i class="bi bi-chevron-left"></i> Prev</a> }
          else { <span class="pb wide off"><i class="bi bi-chevron-left"></i> Prev</span> }
          @for (int p = Math.Max(1,Model.Page-2); p <= Math.Min(Model.TotalPages,Model.Page+2); p++) {
            if (p==Model.Page) { <span class="pb cur">@p</span> }
            else { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=ViewBag.StatusFilter, page=p })" class="pb">@p</a> }
          }
          @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, status=ViewBag.StatusFilter, page=Model.Page+1 })" class="pb wide">Next <i class="bi bi-chevron-right"></i></a> }
          else { <span class="pb wide off">Next <i class="bi bi-chevron-right"></i></span> }
        </div>
      }
    </div>
  }

<div class="toast-wrap" id="toastWrap"></div>

<!-- VIEW DETAILS MODAL -->
<div class="modal-backdrop-custom" id="viewModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-geo-alt-fill" style="color:#f59e0b"></i> Deployment Details</h5>
      <button class="modal-close" onclick="closeModal('viewModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div class="view-grid" id="viewContent"></div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('viewModal')">Close</button>
      <button class="btn-pm" id="v_editBtn"><i class="bi bi-pencil-fill"></i> Edit</button>
    </div>
  </div>
</div>

<!-- CREATE MODAL -->
<div class="modal-backdrop-custom" id="createModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-geo-alt" style="color:#f59e0b"></i> Add Deployment</h5>
      <button class="modal-close" onclick="closeModal('createModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div class="frow-2">
        <div class="frow"><label>Dog <span style="color:#ef4444">*</span></label>
          <select class="finput" id="c_dogId">
            <option value="">Select dog</option>
            @foreach (var d in Model.Dogs) { <option value="@d.Id">@d.Name@(d.MicrochipNumber != null ? " (" + d.MicrochipNumber + ")" : "")</option> }
          </select>
        </div>
        <div class="frow"><label>Location <span style="color:#ef4444">*</span></label><input class="finput" id="c_location" placeholder="Deployment location"></div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Company Deployed To</label><input class="finput" id="c_companyDeployedTo" placeholder="Client company"></div>
        <div class="frow"><label>Security Guard</label><input class="finput" id="c_securityGuard" placeholder="Guard name"></div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Start Date <span style="color:#ef4444">*</span></label><input class="finput" type="date" id="c_startDate"></div>
        <div class="frow"><label>End Date</label><input class="finput" type="date" id="c_endDate"></div>
      </div>
      <div class="frow"><label>Notes</label><textarea class="finput" id="c_notes" rows="3" placeholder="Additional notes..."></textarea></div>
      <div class="frow" style="display:flex;align-items:center;gap:.5rem">
        <input type="checkbox" id="c_isActive" checked style="width:16px;height:16px;cursor:pointer">
        <label for="c_isActive" style="margin:0;font-size:.855rem;font-weight:500;cursor:pointer">Active</label>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('createModal')">Cancel</button>
      <button class="btn-pm" id="createBtn" onclick="submitCreate()"><i class="bi bi-geo-alt"></i> Save Deployment</button>
    </div>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal-backdrop-custom" id="editModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-pencil-fill" style="color:#667eea"></i> Edit Deployment</h5>
      <button class="modal-close" onclick="closeModal('editModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <input type="hidden" id="e_id">
      <div class="frow-2">
        <div class="frow"><label>Dog</label>
          <select class="finput" id="e_dogId">
            <option value="">Select dog</option>
            @foreach (var d in Model.Dogs) { <option value="@d.Id">@d.Name@(d.MicrochipNumber != null ? " (" + d.MicrochipNumber + ")" : "")</option> }
          </select>
        </div>
        <div class="frow"><label>Location</label><input class="finput" id="e_location"></div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Company Deployed To</label><input class="finput" id="e_companyDeployedTo"></div>
        <div class="frow"><label>Security Guard</label><input class="finput" id="e_securityGuard"></div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Start Date</label><input class="finput" type="date" id="e_startDate"></div>
        <div class="frow"><label>End Date</label><input class="finput" type="date" id="e_endDate"></div>
      </div>
      <div class="frow"><label>Notes</label><textarea class="finput" id="e_notes" rows="3"></textarea></div>
      <div class="frow" style="display:flex;align-items:center;gap:.5rem">
        <input type="checkbox" id="e_isActive" style="width:16px;height:16px;cursor:pointer">
        <label for="e_isActive" style="margin:0;font-size:.855rem;font-weight:500;cursor:pointer">Active</label>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('editModal')">Cancel</button>
      <button class="btn-pm" id="editBtn" onclick="submitEdit()"><i class="bi bi-check2-circle"></i> Save Changes</button>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-backdrop-custom" id="deleteModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-trash3-fill" style="color:#dc2626"></i> Delete Deployment</h5>
      <button class="modal-close" onclick="closeModal('deleteModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p" style="text-align:center;padding-top:1.75rem">
      <input type="hidden" id="d_id">
      <div class="del-icon"><i class="bi bi-geo-alt-fill"></i></div>
      <p style="font-size:.9rem;color:#374151;margin-bottom:.5rem">Delete deployment at</p>
      <p id="d_name" style="font-weight:700;color:#1e293b;font-size:1rem;margin-bottom:.5rem"></p>
      <p style="font-size:.82rem;color:#94a3b8;margin:0">This action cannot be undone.</p>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn-dm" id="deleteBtn" onclick="submitDelete()"><i class="bi bi-trash3-fill"></i> Delete</button>
    </div>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.modal-backdrop-custom').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)closeModal(bd.id);});});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop-custom.open').forEach(function(m){closeModal(m.id);});}});
function toggleActMenu(btn){var menu=btn.nextElementSibling;var isOpen=menu.classList.contains('open');closeAllActMenus();if(!isOpen){positionActMenu(btn,menu);menu.classList.add('open');}}
function closeAllActMenus(){document.querySelectorAll('.act-menu.open').forEach(function(m){m.classList.remove('open');m.style.top='';m.style.left='';m.style.right='';});}
function positionActMenu(btn,menu){menu.style.visibility='hidden';menu.style.display='block';var mr=menu.getBoundingClientRect();menu.style.display='';menu.style.visibility='';var br=btn.getBoundingClientRect();var right=window.innerWidth-br.right;if(right<8)right=8;var top=br.bottom+4;if(top+mr.height>window.innerHeight-8){var up=br.top-mr.height-4;top=up>=8?up:Math.max(8,window.innerHeight-mr.height-8);}menu.style.top=top+'px';menu.style.right=right+'px';menu.style.left='auto';}
document.addEventListener('click',function(e){if(!e.target.closest('.act-wrap'))closeAllActMenus();});
window.addEventListener('scroll',closeAllActMenus,true);
window.addEventListener('resize',closeAllActMenus);
function setLoading(id,on,html){var b=document.getElementById(id);b.disabled=on;if(on)b.innerHTML='<span class="spin"></span> Saving...';else if(html)b.innerHTML=html;}
function showToast(msg,type){var w=document.getElementById('toastWrap');var el=document.createElement('div');el.className='toast-msg toast-'+type;el.innerHTML='<i class="bi '+(type==='success'?'bi-check-circle-fill':'bi-exclamation-circle-fill')+'"></i>'+msg;w.appendChild(el);requestAnimationFrame(function(){el.classList.add('show');});setTimeout(function(){el.classList.remove('show');setTimeout(function(){el.remove();},350);},3500);}
function drow(l,v){return '<div><div style="font-size:.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase">'+l+'</div><div style="font-size:.875rem;color:#1e293b;font-weight:500;margin-top:.15rem">'+(v||'-')+'</div></div>';}
function fmtDate(s){if(!s)return'-';var d=new Date(s);return isNaN(d)?s:d.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'2-digit'});}
function openView(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('viewContent').innerHTML=drow('Dog ID','#'+d.dogid)+drow('Location',d.location)+drow('Deployed To',d.companydeployedto)+drow('Security Guard',d.securityguardassigned)+drow('Start Date',fmtDate(d.startdate))+drow('End Date',fmtDate(d.enddate))+drow('Status',d.isactive==='true'?'Active':'Inactive')+drow('Notes',d.notes);document.getElementById('v_editBtn').onclick=function(){closeModal('viewModal');setTimeout(function(){openEdit(menu);},300);};openModal('viewModal');}
function openCreateModal(){document.getElementById('c_dogId').value='';document.getElementById('c_location').value='';document.getElementById('c_companyDeployedTo').value='';document.getElementById('c_securityGuard').value='';document.getElementById('c_startDate').value='';document.getElementById('c_endDate').value='';document.getElementById('c_notes').value='';document.getElementById('c_isActive').checked=true;openModal('createModal');}
function openEdit(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('e_id').value=d.id;document.getElementById('e_dogId').value=d.dogid||'';document.getElementById('e_location').value=d.location||'';document.getElementById('e_companyDeployedTo').value=d.companydeployedto||'';document.getElementById('e_securityGuard').value=d.securityguardassigned||'';document.getElementById('e_startDate').value=d.startdate||'';document.getElementById('e_endDate').value=d.enddate||'';document.getElementById('e_notes').value=d.notes||'';document.getElementById('e_isActive').checked=d.isactive==='true';openModal('editModal');}
function openDelete(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('d_id').value=d.id;document.getElementById('d_name').textContent=d.location||'this deployment';openModal('deleteModal');}
async function submitCreate(){var dogId=parseInt(document.getElementById('c_dogId').value);var loc=document.getElementById('c_location').value.trim();var sd=document.getElementById('c_startDate').value;if(!dogId){showToast('Please select a dog.','error');return;}if(!loc){showToast('Location is required.','error');return;}if(!sd){showToast('Start date is required.','error');return;}setLoading('createBtn',true);try{var r=await fetch('/Deployments/Create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dogId:dogId,location:loc,companyDeployedTo:document.getElementById('c_companyDeployedTo').value.trim(),securityGuardAssigned:document.getElementById('c_securityGuard').value.trim(),startDate:sd,endDate:document.getElementById('c_endDate').value||null,notes:document.getElementById('c_notes').value.trim(),isActive:document.getElementById('c_isActive').checked})});var d=await r.json();if(d.success){showToast(d.message||'Deployment created!','success');closeModal('createModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('createBtn',false,'<i class="bi bi-geo-alt"></i> Save Deployment');}}
async function submitEdit(){var loc=document.getElementById('e_location').value.trim();if(!loc){showToast('Location is required.','error');return;}var id=document.getElementById('e_id').value;setLoading('editBtn',true);try{var r=await fetch('/Deployments/Update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:parseInt(id),dogId:parseInt(document.getElementById('e_dogId').value),location:loc,companyDeployedTo:document.getElementById('e_companyDeployedTo').value.trim(),securityGuardAssigned:document.getElementById('e_securityGuard').value.trim(),startDate:document.getElementById('e_startDate').value,endDate:document.getElementById('e_endDate').value||null,notes:document.getElementById('e_notes').value.trim(),isActive:document.getElementById('e_isActive').checked})});var d=await r.json();if(d.success){showToast(d.message||'Deployment updated!','success');closeModal('editModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('editBtn',false,'<i class="bi bi-check2-circle"></i> Save Changes');}}
async function submitDelete(){var id=document.getElementById('d_id').value;setLoading('deleteBtn',true);try{var r=await fetch('/Deployments/Delete/'+id,{method:'POST'});var d=await r.json();if(d.success){showToast(d.message||'Deployment deleted.','success');closeModal('deleteModal');setTimeout(function(){location.reload();},900);}else showToast(d.message||'Failed.','error');}catch(e){showToast('Network error.','error');}finally{setLoading('deleteBtn',false,'<i class="bi bi-trash3-fill"></i> Delete');}}
</script>

