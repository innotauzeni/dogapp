@model Dog.Portal.Models.WebhooksListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Webhooks";
    var totalAll = Model.TotalCount;
    var activeCount = Model.WebhookList.Count(u => bool.Equals(u.IsActive, true));
    var inactiveCount = Model.WebhookList.Count(u => bool.Equals(u.IsActive, false));
    var availableEvents = ViewBag.AvailableEvents as string[] ?? new string[0];
    var P = PermHelper.For(Context);
}

@if (ViewBag.FetchError != null)
{
    <div class="alert alert-danger">
        @ViewBag.FetchError
    </div>
}


<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem;letter-spacing:-.02em}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px;white-space:nowrap}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(102,126,234,.3)}
.btn-add:hover{opacity:.9;transform:translateY(-1px)}
.btn-logs{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-logs:hover{opacity:.9;transform:translateY(-1px);color:#fff}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04);padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.si-total{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.si-active{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-inactive{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}

/* Data card */
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.04);overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}

/* Search & filters */
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:280px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.srch-input::placeholder{color:#cbd5e1}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;transition:border-color .2s;min-width:130px}
.filter-sel:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:opacity .2s;display:inline-flex;align-items:center;gap:.375rem;white-space:nowrap}
.btn-srch:hover{opacity:.9}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;font-weight:500;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;transition:all .18s;white-space:nowrap}
.btn-clr:hover{background:#e2e8f0;color:#334155}

/* Table */
.tbl-wrap{overflow-x:auto;min-height:400px;}
.dt{width:100%;border-collapse:collapse;table-layout:fixed;}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.09em;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle;max-width:200px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
.dt tbody tr:last-child td{border-bottom:none}
.dt tbody tr{transition:background .15s}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}

/* Status badge */
.s-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:700;padding:.25rem .65rem;border-radius:20px}
.s-active{background:#d1fae5;color:#065f46}
.s-inactive{background:#fee2e2;color:#991b1b}

/* Event tags */
.event-tags{display:flex;flex-wrap:wrap;gap:.25rem}
.event-tag{background:#f1f5f9;color:#64748b;font-size:.7rem;padding:.2rem .5rem;border-radius:4px;border:1px solid #e2e8f0}

/* Stats display */
.webhook-stats{font-size:.8rem;color:#64748b}
.success-rate{color:#059669;font-weight:600}

/* Action menu */
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s;font-size:.9rem}
.act-btn:hover{background:#f8fafc;border-color:#cbd5e1;color:#334155}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18),0 0 0 1px rgba(0,0,0,.02);min-width:200px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;transition:background .15s;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc;color:#1e293b}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-item i{width:16px;text-align:center;font-size:.85rem}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}

/* Footer / pagination */
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;font-weight:500;color:#64748b;text-decoration:none;transition:all .18s;background:#fff}
.pb:hover{background:#f8fafc;color:#334155;border-color:#cbd5e1}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.pgn-dots{padding:0 .25rem;color:#cbd5e1;font-size:.82rem}

/* Empty state */
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1}
.empty-state h3{font-size:1.1rem;font-weight:600;color:#64748b;margin-bottom:.5rem}
.empty-state p{font-size:.9rem}

/* Event checkboxes */
.event-checkboxes{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.375rem;max-height:220px;overflow-y:auto;border:1.5px solid #e2e8f0;border-radius:9px;padding:.75rem;background:#fafbfc}
.event-checkbox{display:flex;align-items:center;gap:.5rem}
.event-checkbox input[type=checkbox]{width:15px;height:15px;cursor:pointer;accent-color:#667eea;flex-shrink:0}
.event-checkbox label{font-size:.8rem;color:#374151;cursor:pointer;font-family:monospace;font-weight:500;line-height:1.3}
.event-checkbox:hover label{color:#667eea}
.ev-select-all{font-size:.75rem;color:#667eea;cursor:pointer;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:.25rem;margin-bottom:.5rem}
.ev-select-all:hover{text-decoration:underline}
</style>

<div class="page-hdr-row">
    <div class="page-hdr">
        <h4>Webhooks</h4>
        <p>Manage webhook endpoints and event subscriptions</p>
    </div>
    <div class="hdr-actions">
        <div class="total-chip">
            <i class="fas fa-webhook"></i>
            <span>@totalAll Total</span>
        </div>
        <a href="@Url.Action("Logs")" class="btn-logs">
            <i class="fas fa-list"></i>
            View Logs
        </a>
        @if (P.Can("webhook.create"))
        {
            <button type="button" class="btn-add" onclick="openCreateModal()">
                <i class="fas fa-plus"></i>
                Add Webhook
            </button>
        }
    </div>
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon si-total">
            <i class="fas fa-webhook"></i>
        </div>
        <div class="stat-body">
            <div class="val">@totalAll</div>
            <div class="lbl">Total Webhooks</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-active">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-body">
            <div class="val">@activeCount</div>
            <div class="lbl">Active</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-inactive">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-body">
            <div class="val">@inactiveCount</div>
            <div class="lbl">Inactive</div>
        </div>
    </div>
</div>

<!-- Data Card -->
<div class="dc">
    <!-- Header with search and filters -->
    <div class="dc-head">
        <form method="get" style="display:contents;">
            <div class="srch-wrap">
                <i class="fas fa-search"></i>
                <input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search webhooks...">
            </div>
            <select name="status" class="filter-sel">
                <option value="">All Status</option>
                <option value="active" selected="@(ViewBag.StatusFilter == "active")">Active</option>
                <option value="inactive" selected="@(ViewBag.StatusFilter == "inactive")">Inactive</option>
            </select>
            <button type="submit" class="btn-srch">
                <i class="fas fa-search"></i>
                Search
            </button>
            <a href="@Url.Action("Index")" class="btn-clr">
                <i class="fas fa-times"></i>
                Clear
            </a>
        </form>
    </div>

    <!-- Table -->
    <div class="tbl-wrap">
        @if (Model.WebhookList.Count > 0)
        {
            <table class="dt">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th style="width:200px">Name</th>
                        <th style="width:250px">URL</th>
                        <th style="width:200px">Events</th>
                        <th style="width:120px">Status</th>
                        <th style="width:150px">Success Rate</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var startIndex = (Model.Page - 1) * Model.PageSize;
                    }
                    @for (int i = 0; i < Model.WebhookList.Count; i++)
                    {
                        var item = Model.WebhookList[i];
                        var index = i;
                        <tr>
                            <td>
                                <span class="rn">@(startIndex + index + 1)</span>
                            </td>
                            <td title="@item.Name">
                                <div style="font-weight:600;color:#1e293b">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div style="font-size:.8rem;color:#64748b">@item.Description</div>
                                }
                            </td>
                            <td title="@item.Url">
                                <div style="font-family:monospace;font-size:.8rem;color:#64748b">@item.Url</div>
                            </td>
                            <td>
                                <div class="event-tags">
                                    @{
                                        var eventCount = 0;
                                        if (item.EventList != null)
                                        {
                                            foreach (var eventName in item.EventList)
                                            {
                                                if (eventCount < 3)
                                                {
                                                    <span class="event-tag">@eventName</span>
                                                }
                                                eventCount++;
                                            }
                                            if (eventCount > 3)
                                            {
                                                <span class="event-tag">+@(eventCount - 3) more</span>
                                            }
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="s-badge @(item.IsActive ? "s-active" : "s-inactive")">
                                    <i class="fas @(item.IsActive ? "fa-check-circle" : "fa-times-circle")"></i>
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (item.TotalDeliveries > 0)
                                {
                                    var successRate = (double)item.SuccessfulDeliveries / item.TotalDeliveries * 100;
                                    <div class="webhook-stats">
                                        <div class="success-rate">@successRate.ToString("F1")%</div>
                                        <div>@item.SuccessfulDeliveries/@item.TotalDeliveries</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="webhook-stats">No deliveries</div>
                                }
                            </td>
                            <td>
                                <div class="act-wrap">
                                    <button type="button" class="act-btn" onclick="toggleActionMenu(this)">
                                         <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <div class="act-menu">
                                        @if (P.Can("webhook.edit"))
                                        {
                                            <button type="button" class="act-item" onclick="openEditModal(@item.Id, '@Html.Raw(Html.Encode(item.Name))', '@Html.Raw(Html.Encode(item.Url))', '@Html.Raw(Html.Encode(item.Description))', @item.RetryCount, @item.IsActive.ToString().ToLower(), '@Html.Raw(Html.Encode(item.Events))')">
                                                <i class="fas fa-edit"></i>
                                                Edit
                                            </button>
                                            <button type="button" class="act-item" onclick="toggleWebhook(@item.Id, '@Html.Raw(Html.Encode(item.Name))', @item.IsActive.ToString().ToLower())">
                                                <i class="fas @(item.IsActive ? "fa-pause" : "fa-play")"></i>
                                                @(item.IsActive ? "Disable" : "Enable")
                                            </button>
                                        }
                                        @if (P.Can("webhook.delete"))
                                        {
                                            @if (P.Can("webhook.edit")) { <div class="act-divider"></div> }
                                            <button type="button" class="act-item danger" onclick="deleteWebhook(@item.Id, '@Html.Raw(Html.Encode(item.Name))')">
                                                <i class="fas fa-trash"></i>
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-webhook"></i>
                <h3>No webhooks found</h3>
                <p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Start by creating your first webhook." : "Try adjusting your search criteria.")</p>
            </div>
        }
    </div>

    <!-- Footer / Pagination -->
    @if (Model.TotalCount > 0)
    {
        <div class="dc-foot">
            <div class="ri">
                Showing <strong>@Model.From</strong> to <strong>@Model.To</strong> of <strong>@Model.TotalCount</strong> results
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="pgn">
                    @if (Model.Page > 1)
                    {
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = Model.Page - 1 })" class="pb wide">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    }
                    else
                    {
                        <span class="pb wide off">
                            <i class="fas fa-chevron-left"></i> Previous
                        </span>
                    }

                    @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                    {
                        if (i == Model.Page)
                        {
                            <span class="pb cur">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = i })" class="pb">@i</a>
                        }
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, status = ViewBag.StatusFilter, page = Model.Page + 1 })" class="pb wide">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pb wide off">
                            Next <i class="fas fa-chevron-right"></i>
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>
<!-- Create Webhook Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Webhook</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm">
                    <div class="mb-3">
                        <label for="createName" class="form-label">Name *</label>
                        <input type="text" class="form-control" id="createName" required>
                    </div>
                    <div class="mb-3">
                        <label for="createUrl" class="form-label">URL *</label>
                        <input type="url" class="form-control" id="createUrl" required placeholder="https://example.com/webhook">
                    </div>
                    <div class="mb-3">
                        <label for="createDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="createDescription" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="createSecret" class="form-label">Secret</label>
                        <input type="text" class="form-control" id="createSecret" placeholder="Optional webhook secret">
                    </div>
                    <div class="mb-3">
                        <label for="createRetryCount" class="form-label">Retry Count</label>
                        <input type="number" class="form-control" id="createRetryCount" value="3" min="0" max="10">
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label mb-0">Events <span class="text-danger">*</span></label>
                            <div style="display:flex;gap:.75rem">
                                <a href="#" class="ev-select-all" onclick="selectAllEvents('createEvents',true);return false"><i class="bi bi-check-all"></i> Select All</a>
                                <a href="#" class="ev-select-all" style="color:#94a3b8" onclick="selectAllEvents('createEvents',false);return false"><i class="bi bi-x"></i> Clear</a>
                            </div>
                        </div>
                        <div class="event-checkboxes" id="createEvents">
                            @foreach (var eventName in availableEvents)
                            {
                                <div class="event-checkbox">
                                    <input type="checkbox" id="create-event-@eventName" value="@eventName">
                                    <label for="create-event-@eventName">@eventName</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="createIsActive" checked>
                            <label class="form-check-label" for="createIsActive">Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitCreate()">
                    <span class="spinner-border spinner-border-sm d-none" id="createSpinner"></span>
                    Create
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Webhook Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Webhook</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId">
                    <div class="mb-3">
                        <label for="editName" class="form-label">Name *</label>
                        <input type="text" class="form-control" id="editName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editUrl" class="form-label">URL *</label>
                        <input type="url" class="form-control" id="editUrl" required>
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editDescription" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editSecret" class="form-label">Secret</label>
                        <input type="text" class="form-control" id="editSecret" placeholder="Optional webhook secret">
                    </div>
                    <div class="mb-3">
                        <label for="editRetryCount" class="form-label">Retry Count</label>
                        <input type="number" class="form-control" id="editRetryCount" min="0" max="10">
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label mb-0">Events <span class="text-danger">*</span></label>
                            <div style="display:flex;gap:.75rem">
                                <a href="#" class="ev-select-all" onclick="selectAllEvents('editEvents',true);return false"><i class="bi bi-check-all"></i> Select All</a>
                                <a href="#" class="ev-select-all" style="color:#94a3b8" onclick="selectAllEvents('editEvents',false);return false"><i class="bi bi-x"></i> Clear</a>
                            </div>
                        </div>
                        <div class="event-checkboxes" id="editEvents">
                            @foreach (var eventName in availableEvents)
                            {
                                <div class="event-checkbox">
                                    <input type="checkbox" id="edit-event-@eventName" value="@eventName">
                                    <label for="edit-event-@eventName">@eventName</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">
                    <span class="spinner-border spinner-border-sm d-none" id="editSpinner"></span>
                    Update
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Webhook Functions
function openCreateModal() {
    document.getElementById('createName').value = '';
    document.getElementById('createUrl').value = '';
    document.getElementById('createDescription').value = '';
    document.getElementById('createSecret').value = '';
    document.getElementById('createRetryCount').value = '3';
    document.getElementById('createIsActive').checked = true;
    
    // Clear all event checkboxes
    document.querySelectorAll('#createEvents input[type="checkbox"]').forEach(cb => cb.checked = false);
    
    new bootstrap.Modal(document.getElementById('createModal')).show();
}

function openEditModal(id, name, url, description, retryCount, isActive, events) {
    document.getElementById('editId').value = id;
    document.getElementById('editName').value = name;
    document.getElementById('editUrl').value = url;
    document.getElementById('editDescription').value = description || '';
    document.getElementById('editRetryCount').value = retryCount;
    document.getElementById('editIsActive').checked = isActive;
    
    // Clear all event checkboxes first
    document.querySelectorAll('#editEvents input[type="checkbox"]').forEach(cb => cb.checked = false);
    
    // Check the events for this webhook
    if (events) {
        const eventList = events.split(',').map(e => e.trim());
        eventList.forEach(event => {
            const checkbox = document.getElementById(`edit-event-${event}`);
            if (checkbox) checkbox.checked = true;
        });
    }
    
    new bootstrap.Modal(document.getElementById('editModal')).show();
}

function selectAllEvents(containerId, select) {
    document.querySelectorAll('#' + containerId + ' input[type=checkbox]').forEach(function(cb) {
        cb.checked = select;
    });
}

function submitCreate() {
    const name = document.getElementById('createName').value.trim();
    const url = document.getElementById('createUrl').value.trim();
    const description = document.getElementById('createDescription').value.trim();
    const secret = document.getElementById('createSecret').value.trim();
    const retryCount = parseInt(document.getElementById('createRetryCount').value);
    const isActive = document.getElementById('createIsActive').checked;
    
    // Get selected events
    const selectedEvents = [];
    document.querySelectorAll('#createEvents input[type="checkbox"]:checked').forEach(cb => {
        selectedEvents.push(cb.value);
    });
    
    if (!name) {
        showAlert('Please enter a webhook name.', 'warning');
        return;
    }
    
    if (!url) {
        showAlert('Please enter a webhook URL.', 'warning');
        return;
    }
    
    if (selectedEvents.length === 0) {
        showAlert('Please select at least one event.', 'warning');
        return;
    }
    
    setLoading('createSpinner', true);
    
    fetch('/Webhooks/Create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            Name: name,
            Url: url,
            Description: description || null,
            Secret: secret || null,
            RetryCount: retryCount,
            Events: selectedEvents,
            IsActive: isActive 
        })
    })
    .then(response => response.json())
    .then(data => {
        setLoading('createSpinner', false);
        if (data.success) {
            showAlert('Webhook created successfully!', 'success');
            bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
            setTimeout(() => location.reload(), 1500);
        } else {
            showAlert(data.message || 'Failed to create webhook.', 'danger');
        }
    })
    .catch(error => {
        setLoading('createSpinner', false);
        showAlert('An error occurred. Please try again.', 'danger');
        console.error('Error:', error);
    });
}

function submitEdit() {
    const id = document.getElementById('editId').value;
    const name = document.getElementById('editName').value.trim();
    const url = document.getElementById('editUrl').value.trim();
    const description = document.getElementById('editDescription').value.trim();
    const secret = document.getElementById('editSecret').value.trim();
    const retryCount = parseInt(document.getElementById('editRetryCount').value);
    const isActive = document.getElementById('editIsActive').checked;
    
    // Get selected events
    const selectedEvents = [];
    document.querySelectorAll('#editEvents input[type="checkbox"]:checked').forEach(cb => {
        selectedEvents.push(cb.value);
    });
    
    if (!name) {
        showAlert('Please enter a webhook name.', 'warning');
        return;
    }
    
    if (!url) {
        showAlert('Please enter a webhook URL.', 'warning');
        return;
    }
    
    if (selectedEvents.length === 0) {
        showAlert('Please select at least one event.', 'warning');
        return;
    }
    
    setLoading('editSpinner', true);
    
    fetch('/Webhooks/Update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            Id: parseInt(id),
            Name: name,
            Url: url,
            Description: description || null,
            Secret: secret || null,
            RetryCount: retryCount,
            Events: selectedEvents,
            IsActive: isActive 
        })
    })
    .then(response => response.json())
    .then(data => {
        setLoading('editSpinner', false);
        if (data.success) {
            showAlert('Webhook updated successfully!', 'success');
            bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
            setTimeout(() => location.reload(), 1500);
        } else {
            showAlert(data.message || 'Failed to update webhook.', 'danger');
        }
    })
    .catch(error => {
        setLoading('editSpinner', false);
        showAlert('An error occurred. Please try again.', 'danger');
        console.error('Error:', error);
    });
}

function toggleWebhook(id, name, isActive) {
    const action = isActive ? 'disable' : 'enable';
    if (!confirm(`Are you sure you want to ${action} the webhook "${name}"?`)) {
        return;
    }
    
    fetch(`/Webhooks/Toggle/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert(`Webhook ${action}d successfully!`, 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showAlert(data.message || `Failed to ${action} webhook.`, 'danger');
        }
    })
    .catch(error => {
        showAlert('An error occurred. Please try again.', 'danger');
        console.error('Error:', error);
    });
}

function deleteWebhook(id, name) {
    if (!confirm(`Are you sure you want to delete the webhook "${name}"? This action cannot be undone.`)) {
        return;
    }
    
    fetch(`/Webhooks/Delete/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('Webhook deleted successfully!', 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showAlert(data.message || 'Failed to delete webhook.', 'danger');
        }
    })
    .catch(error => {
        showAlert('An error occurred. Please try again.', 'danger');
        console.error('Error:', error);
    });
}

// Utility Functions
function toggleActionMenu(button) {
    const menu = button.nextElementSibling;
    const rect = button.getBoundingClientRect();
    
    // Close all other menus
    document.querySelectorAll('.act-menu.open').forEach(m => {
        if (m !== menu) m.classList.remove('open');
    });
    
    if (menu.classList.contains('open')) {
        menu.classList.remove('open');
    } else {
        menu.style.left = rect.left + 'px';
        menu.style.top = (rect.bottom + 5) + 'px';
        menu.classList.add('open');
    }
}

function setLoading(spinnerId, loading) {
    const spinner = document.getElementById(spinnerId);
    if (loading) {
        spinner.classList.remove('d-none');
    } else {
        spinner.classList.add('d-none');
    }
}

function showAlert(message, type) {
    // Create alert element
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(alertDiv);
    
    // Auto remove after 5 seconds
    setTimeout(() => {
        if (alertDiv.parentNode) {
            alertDiv.remove();
        }
    }, 5000);
}

// Close action menus when clicking outside
document.addEventListener('click', function(e) {
    if (!e.target.closest('.act-wrap')) {
        document.querySelectorAll('.act-menu.open').forEach(menu => {
            menu.classList.remove('open');
        });
    }
});
</script>
