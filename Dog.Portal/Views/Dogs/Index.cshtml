@model Dog.Portal.Models.DogsListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dogs";
    var totalAll      = Model.TotalCount;
    var activeCount   = Model.Doglist.Count(u => bool.Equals(u.IsActive,true));
    var inactiveCount = Model.Doglist.Count(u => bool.Equals(u.IsActive,false));
   
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem;letter-spacing:-.02em}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px;white-space:nowrap}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(102,126,234,.3)}
.btn-add:hover{opacity:.9;transform:translateY(-1px)}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04);padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.si-total{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.si-active{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-inactive{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b}
.si-roles{background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1d4ed8}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}

/* Data card */
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;box-shadow:0 1px 4px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.04);overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}

/* Search & filters */
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:280px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.srch-input::placeholder{color:#cbd5e1}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;transition:border-color .2s;min-width:130px}
.filter-sel:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;transition:opacity .2s;display:inline-flex;align-items:center;gap:.375rem;white-space:nowrap}
.btn-srch:hover{opacity:.9}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;font-weight:500;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;transition:all .18s;white-space:nowrap}
.btn-clr:hover{background:#e2e8f0;color:#334155}

/* Table */
.tbl-wrap{overflow-x:auto;min-height:400px;}
.dt{width:100%;border-collapse:collapse;table-layout:fixed;}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.09em;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle}
.dt tbody tr:last-child td{border-bottom:none}
.dt tbody tr{transition:background .15s}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}

/* User avatar */
.u-av{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.8rem;font-weight:800;flex-shrink:0;box-shadow:0 2px 8px rgba(102,126,234,.2)}
.u-name{font-weight:700;color:#1e293b;font-size:.875rem}
.u-email{font-size:.75rem;color:#94a3b8}

/* Photo thumbnail */
.photo-thumb{width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;}
.photo-placeholder{width:40px;height:40px;border-radius:6px;border:1px solid #e2e8f0;background:#f8fafc;display:flex;align-items:center;justify-content:center;font-size:1rem;color:#cbd5e1;}

/* Status badge */
.s-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:700;padding:.25rem .65rem;border-radius:20px}
.s-active{background:#d1fae5;color:#065f46}
.s-inactive{background:#fee2e2;color:#991b1b}
.s-other{background:#f1f5f9;color:#475569}

/* Role chip */
.role-chip{display:inline-block;background:#ede9fe;color:#6d28d9;font-size:.74rem;font-weight:600;padding:.2rem .6rem;border-radius:6px}

/* Action menu */
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s;font-size:.9rem}
.act-btn:hover{background:#f8fafc;border-color:#cbd5e1;color:#334155}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18),0 0 0 1px rgba(0,0,0,.02);min-width:200px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;transition:background .15s;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc;color:#1e293b}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-item i{width:16px;text-align:center;font-size:.85rem}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}

/* Footer / pagination */
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;font-weight:500;color:#64748b;text-decoration:none;transition:all .18s;background:#fff}
.pb:hover{background:#f8fafc;color:#334155;border-color:#cbd5e1}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.pgn-dots{padding:0 .25rem;color:#cbd5e1;font-size:.82rem}

/* Empty state */
.es{text-align:center;padding:4rem 2rem}
.es-icon{font-size:3rem;color:#e2e8f0;margin-bottom:1rem;display:block}
.es h6{font-weight:600;color:#64748b;margin:0 0 .375rem}
.es p{font-size:.845rem;color:#94a3b8;margin:0}

/* Alert */
.alert-err{background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:.875rem 1.125rem;color:#dc2626;font-size:.845rem;display:flex;align-items:center;gap:.625rem;margin-bottom:1.25rem}

/* -- Modals ---------------------------------------- */
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:480px;max-height:90vh;overflow-y:auto;animation:mslide .22s ease}
.modal-box.wide{max-width:560px}
@@keyframes mslide{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:all .15s}
.modal-close:hover{background:#e2e8f0;color:#334155}
.modal-body{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem}

/* Form fields */
.frow{margin-bottom:1rem}
.frow label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:.375rem}
.frow label span.req{color:#ef4444;margin-left:.2rem}
.finput{width:100%;padding:.65rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;color:#1e293b;background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.finput:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.finput::placeholder{color:#cbd5e1}
.finput[type="file"]{padding:.4rem .875rem}
.frow-2{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.fhint{font-size:.75rem;color:#94a3b8;margin-top:.3rem}
.ferr{font-size:.75rem;color:#dc2626;margin-top:.3rem;display:none}

/* Buttons */
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer;transition:all .18s}
.btn-cancel:hover{background:#e2e8f0;color:#334155}
.btn-primary{padding:.65rem 1.5rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(102,126,234,.3);display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-primary:hover:not(:disabled){opacity:.9;transform:translateY(-1px)}
.btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none}
.btn-danger{padding:.65rem 1.5rem;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(239,68,68,.3);display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-danger:hover:not(:disabled){opacity:.9}
.btn-danger:disabled{opacity:.6;cursor:not-allowed}

/* Delete confirm */
.del-icon{width:60px;height:60px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#dc2626}
.del-name{font-weight:700;color:#1e293b}

/* Password strength */
.pw-wrap{position:relative}
.pw-toggle{position:absolute;right:.875rem;top:50%;transform:translateY(-50%);background:none;border:none;color:#94a3b8;cursor:pointer;font-size:.9rem;padding:0}
.pw-toggle:hover{color:#64748b}
.pw-strength{height:4px;border-radius:2px;margin-top:.5rem;background:#f1f5f9;overflow:hidden}
.pw-bar{height:100%;border-radius:2px;transition:width .3s,background .3s;width:0}

/* Toast */
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
.spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@@keyframes spin{to{transform:rotate(360deg)}}

@@media(max-width:576px){.frow-2{grid-template-columns:1fr}.dc-head{flex-direction:column;align-items:stretch}.srch-wrap{max-width:100%}}
</style>

<!-- Toast -->
<div class="toast-wrap" id="toastWrap"></div>

<!-- Page header -->
<div class="page-hdr-row">
    <div class="page-hdr">
        <h4><i class="bi bi-people-fill me-2" style="color:#667eea;"></i>Dogs</h4>
        <p>Manage Dogs.</p>
    </div>
    <div class="hdr-actions">
        @if (Model.TotalCount > 0)
        {
            <span class="total-chip"><i class="bi bi-people"></i> @Model.TotalCount Dogs@(Model.TotalCount != 1 ? "s" : "")</span>
        }
        <button class="btn-add" onclick="openCreateModal()">
            <i class="bi bi-person-plus-fill"></i> Add Dog
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.FetchError as string))
{
    <div class="alert-err"><i class="bi bi-exclamation-circle-fill"></i>@ViewBag.FetchError</div>
}

<!-- Stat cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon si-total"><i class="bi bi-people-fill"></i></div>
        <div class="stat-body"><div class="val">@Model.TotalCount</div><div class="lbl">Total Dogs</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-active"><i class="bi bi-person-check-fill"></i></div>
        <div class="stat-body"><div class="val">@activeCount</div><div class="lbl">Active</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-inactive"><i class="bi bi-person-x-fill"></i></div>
        <div class="stat-body"><div class="val">@inactiveCount</div><div class="lbl">Inactive</div></div>
    </div>
  
</div>

<!-- Data card -->
<div class="dc">
    <!-- Filters -->
    <div class="dc-head">
        <form method="get" action="/Dogs" style="display:contents;">
            <div class="srch-wrap">
                <i class="bi bi-search"></i>
                <input class="srch-input" name="search" type="text" placeholder="Search name..."
                       value="@Model.SearchTerm" autocomplete="off" />
            </div>

            <select class="filter-sel" name="status">
                <option value="">All Status</option>
                <option value="active" selected="@(ViewBag.StatusFilter == "active")">Active Only</option>
                <option value="inactive" selected="@(ViewBag.StatusFilter == "inactive")">Inactive Only</option>
            </select>

            <select class="filter-sel" name="gender">
                <option value="">All Genders</option>
                <option value="Male" selected="@(ViewBag.GenderFilter == "Male")">Male</option>
                <option value="Female" selected="@(ViewBag.GenderFilter == "Female")">Female</option>
            </select>
          
            <input type="hidden" name="page" value="1" />
            <button type="submit" class="btn-srch"><i class="bi bi-funnel-fill"></i> Filter</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string) || !string.IsNullOrEmpty(ViewBag.GenderFilter as string))
            {
                <a href="/Dogs" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
            }
        </form>
    </div>

    <!-- Table -->
    <div class="tbl-wrap">
        @if (Model.Doglist.Any())
        {
            <table class="dt">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th style="width:60px;">Photo</th>
                        <th style="min-width:120px;max-width:150px;">Name</th>
                        <th style="min-width:120px;max-width:180px;">Breed</th>
                        <th style="min-width:100px;max-width:120px;">Color</th>
                        <th style="min-width:110px;max-width:130px;">Birth Date</th>
                        <th style="min-width:80px;max-width:100px;">Gender</th>
                        <th style="min-width:100px;max-width:120px;">Father</th>
                        <th style="min-width:100px;max-width:120px;">Mother</th>
                        <th style="min-width:140px;max-width:160px;">Microchip</th>
                        <th style="min-width:80px;max-width:100px;">Status</th>
                        <th style="width:50px;text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = Model.From; }
                    @foreach (var u in Model.Doglist)
                    {
                        var statusClass = u.IsActive ? "s-active" :
                                          u.IsActive == false ? "s-inactive" : "s-other";
                        var statusDot   = u.IsActive ? "bi-circle-fill" : "bi-circle";
                        var statusDotName   = u.IsActive ? "Active" : "Blocked";

                        <tr>
                            <td><span class="rn">@rowNum</span></td>
                            <td style="text-align:center;">
                                @if (!string.IsNullOrEmpty(u.PhotoUrl))
                                {
                                    <img src="@u.PhotoUrl" alt="Dog photo" class="photo-thumb" />
                                }
                                else
                                {
                                    <div class="photo-placeholder">
                                        <i class="bi bi-camera"></i>
                                    </div>
                                }
                            </td>
                            <td style="color:#64748b;font-size:.835rem;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.Name ?? "—")">@(u.Name ?? "—")</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.Breed ?? "—")">@(u.Breed ?? "—")</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.Color ?? "—")">@(u.Color ?? "—")</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(u.DateOfBirth.ToString("yyyy-MM-dd"))</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.Gender ?? "—")">@(u.Gender ?? "—")</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.SireName ?? "—")">@(u.SireName ?? "—")</td>
                            <td style="color:#64748b;font-size:.835rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.DamName ?? "—")">@(u.DamName ?? "—")</td>
                            <td style="color:#64748b;font-size:.75rem;font-family:monospace;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(u.MicrochipNumber ?? "—")">@(u.MicrochipNumber ?? "—")</td>
                            <td>
                                <span class="s-badge @statusClass">
                                    <i class="bi @statusDot" style="font-size:.5rem;"></i>
                                    @statusDotName 
                                </span>
                            </td>
                            <td style="text-align:center;">
                                 <div class="act-wrap">
                                     <button class="act-btn" onclick="toggleActMenu(this)" title="Actions">
                                         <i class="bi bi-three-dots-vertical"></i>
                                     </button>
                                      <div class="act-menu"
                                           data-id="@u.Id"
                                           data-name="@u.Name"
                                           data-breed="@u.Breed"
                                           data-color="@u.Color"
                                           data-dateofbirth="@u.DateOfBirth.ToString("yyyy-MM-dd")"
                                           data-dateofdeath="@(u.DateOfDeath.HasValue ? u.DateOfDeath.Value.ToString("yyyy-MM-dd") : "")"
                                           data-gender="@u.Gender"
                                           data-microchipnumber="@u.MicrochipNumber"
                                           data-photourl="@u.PhotoUrl"
                                           data-sireid="@u.SireId"
                                           data-damid="@u.DamId"
                                           data-status="@u.IsActive">
                                          <a href="/Dogs/Details/@u.Id" class="act-item" style="text-decoration:none;color:inherit;">
                                              <i class="bi bi-eye-fill" style="color:#667eea;"></i> View Details
                                          </a>

                                          <button class="act-item" onclick="openEdit(this.closest('.act-menu'))">
                                              <i class="bi bi-pencil-fill" style="color:#667eea;"></i> Edit Dog
                                          </button>

                                          <div class="act-divider"></div>

                                          <button class="act-item" onclick="openVaccineModal(this.closest('.act-menu'))">
                                              <i class="bi bi-shield-fill-check" style="color:#059669;"></i> Add Vaccination
                                          </button>

                                          <button class="act-item" onclick="openMatingModal(this.closest('.act-menu'))">
                                              <i class="bi bi-heart-fill" style="color:#dc2626;"></i> Add Mating Record
                                          </button>

                                          <button class="act-item" onclick="openLitterModal(this.closest('.act-menu'))">
                                              <i class="bi bi-people-fill" style="color:#7c3aed;"></i> Add Litter
                                          </button>

                                          <button class="act-item" onclick="openPuppyModal(this.closest('.act-menu'))">
                                              <i class="bi bi-heart-eyes-fill" style="color:#f59e0b;"></i> Add Puppy
                                          </button>

                                          <div class="act-divider"></div>

                                          <button class="act-item" onclick="printCertificate(this.closest('.act-menu'))">
                                              <i class="bi bi-award-fill" style="color:#f59e0b;"></i> Print Certificate
                                          </button>

                                          <button class="act-item" onclick="toggleStatus(this.closest('.act-menu'))">
                                              <i class="bi bi-toggle-on" style="color:#059669;"></i> @(u.IsActive == true ? "Deactivate" : "Activate")
                                          </button>

                                          <div class="act-divider"></div>
                                          <button class="act-item danger" onclick="openDelete(this.closest('.act-menu'))">
                                              <i class="bi bi-trash3-fill"></i> Delete Dog
                                          </button>
                                     </div>
                                 </div>
                            </td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="es">
                <i class="bi bi-people es-icon"></i>
                <h6>No dogs found</h6>
                <p>@(string.IsNullOrEmpty(Model.SearchTerm)
                    ? "No dogs have been created yet. Click \"Add Dog\" to get started."
                    : "No dogs match your dog filters. Try adjusting your search.")</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="dc-foot">
            <div class="ri">
                Showing <strong>@Model.From�@Model.To</strong> of <strong>@Model.TotalCount</strong> users
            </div>
            <nav class="pgn">
                @{
                    var prevPage = Model.Page - 1;
                    var nextPage = Model.Page + 1;
                    var baseUrl  = $"/Dogs?search={Model.SearchTerm}&status={ViewBag.StatusFilter}&gender={ViewBag.GenderFilter}&pageSize={Model.PageSize}";
                }
                <a class="pb wide @(Model.Page <= 1 ? "off" : "")" href="@baseUrl&page=@prevPage">
                    <i class="bi bi-chevron-left" style="font-size:.7rem;"></i>
                </a>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == 1 || p == Model.TotalPages || (p >= Model.Page - 2 && p <= Model.Page + 2))
                    {
                        <a class="pb @(p == Model.Page ? "cur" : "")" href="@baseUrl&page=@p">@p</a>
                    }
                    else if (p == Model.Page - 3 || p == Model.Page + 3)
                    {
                        <span class="pgn-dots">�</span>
                    }
                }
                <a class="pb wide @(Model.Page >= Model.TotalPages ? "off" : "")" href="@baseUrl&page=@nextPage">
                    <i class="bi bi-chevron-right" style="font-size:.7rem;"></i>
                </a>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="dc-foot">
            <div class="ri">Showing <strong>@Model.TotalCount</strong> Dog @(Model.TotalCount != 1 ? "s" : "")</div>
        </div>
    }
</div>

