    // -- Open Mating Modal ----------------------------------------
    async function openMatingModal(menu) {
        menu.classList.remove('open');
        
        // Load animals for dropdowns
        const animals = await loadAnimalsForDropdowns();
        
        // Populate Sire dropdown
        const sireSelect = document.getElementById('m_sire');
        sireSelect.innerHTML = '<option value="">-- Select Sire --</option>';
        animals.forEach(animal => {
            const option = document.createElement('option');
            option.value = animal.id;
            option.textContent = animal.name;
            sireSelect.appendChild(option);
        });

        // Populate Dam dropdown
        const damSelect = document.getElementById('m_dam');
        damSelect.innerHTML = '<option value="">-- Select Dam --</option>';
        animals.forEach(animal => {
            const option = document.createElement('option');
            option.value = animal.id;
            option.textContent = animal.name;
            damSelect.appendChild(option);
        });

        // Pre-select current dog if it matches gender
        const currentDogId = menu.dataset.id;
        const currentDogGender = menu.dataset.gender;
        
        if (currentDogGender === 'Male') {
            document.getElementById('m_sire').value = currentDogId;
        } else if (currentDogGender === 'Female') {
            document.getElementById('m_dam').value = currentDogId;
        }
        
        // Set default mating date to today
        document.getElementById('m_matingDate').value = new Date().toISOString().split('T')[0];
        
        openModal('matingModal');
    }

