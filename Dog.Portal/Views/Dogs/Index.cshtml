<!-- Fetch animals for Sire/Dam dropdowns -->
<script>
    // Fetch all animals for Sire/Dam dropdowns
    async function loadAnimalsForDropdowns() {
        try {
            const response = await fetch('/Dogs/GetAnimalsForDropdown');
            if (!response.ok) throw new Error('Failed to load animals');
            const data = await response.json();
            return Array.isArray(data) ? data : (data.data || []);
        } catch (error) {
            console.error('Error loading animals:', error);
            return [];
        }
    }
</script>

