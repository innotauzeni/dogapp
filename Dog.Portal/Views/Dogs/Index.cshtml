<script>
    // -- Modal helpers -----------------------------------------
    function openModal(id) {
        document.getElementById(id).classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    async function openCreateModal() {
        // Auto-generate next microchip number from existing dogs
        const allMicrochips = Array.from(document.querySelectorAll('.act-menu[data-microchipnumber]'))
            .map(el => el.dataset.microchipnumber)
            .filter(v => v && /^\d+$/.test(v.trim()))
            .map(v => BigInt(v.trim()));

        let nextMicrochip;
        if (allMicrochips.length > 0) {
            const maxChip = allMicrochips.reduce((a, b) => a > b ? a : b);
            nextMicrochip = String(maxChip + 1n);
        } else {
            // Base microchip if no dogs exist yet
            nextMicrochip = '981000123456789900';
        }
        document.getElementById('c_microchipNumber').value = nextMicrochip;

        // Load dropdowns for create modal
        const animals = await loadAnimalsForDropdowns();

        // Populate Sire dropdown
        const sireSelect = document.getElementById('c_sireId');
        sireSelect.innerHTML = '<option value="">-- Select Sire --</option>';
        animals.forEach(animal => {
            const option = document.createElement('option');
            option.value = animal.id;
            option.textContent = animal.name;
            sireSelect.appendChild(option);
        });

        // Populate Dam dropdown
        const damSelect = document.getElementById('c_damId');
        damSelect.innerHTML = '<option value="">-- Select Dam --</option>';
        animals.forEach(animal => {
            const option = document.createElement('option');
            option.value = animal.id;
            option.textContent = animal.name;
            damSelect.appendChild(option);
        });

        openModal('createModal');
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
        document.body.style.overflow = '';
    }
    // Close on backdrop click
    document.querySelectorAll('.modal-backdrop-custom').forEach(bd => {
        bd.addEventListener('click', e => { if (e.target === bd) closeModal(bd.id); });
    });
    // Close on Escape
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-backdrop-custom.open').forEach(m => closeModal(m.id));
        }
    });

    // -- Action menu (fixed-position, escapes overflow containers) -
    function toggleActMenu(btn) {
        const menu = btn.nextElementSibling;
        const isOpen = menu.classList.contains('open');
        closeAllActMenus();
        if (!isOpen) {
            positionActMenu(btn, menu);
            menu.classList.add('open');
        }
    }

    function closeAllActMenus() {
        document.querySelectorAll('.act-menu.open').forEach(m => {
            m.classList.remove('open');
            m.style.top = ''; m.style.left = ''; m.style.right = '';
        });
    }

    function positionActMenu(btn, menu) {
        // Temporarily show (invisibly) to measure
        menu.style.visibility = 'hidden';
        menu.style.display = 'block';
        const menuRect = menu.getBoundingClientRect();
        menu.style.display = '';
        menu.style.visibility = '';

        const btnRect = btn.getBoundingClientRect();
        const pad = 8;

        // Align right edge of menu with right edge of button
        let right = window.innerWidth - btnRect.right;
        if (right < pad) right = pad;

        // Default: open below
        let top = btnRect.bottom + 4;
        // If not enough room below, open upward
        if (top + menuRect.height > window.innerHeight - pad) {
            const upTop = btnRect.top - menuRect.height - 4;
            if (upTop >= pad) top = upTop;
            else top = Math.max(pad, window.innerHeight - menuRect.height - pad);
        }

        menu.style.top   = top + 'px';
        menu.style.right = right + 'px';
        menu.style.left  = 'auto';
    }

    // Close on outside click
    document.addEventListener('click', e => {
        if (!e.target.closest('.act-wrap')) closeAllActMenus();
    });
    // Close on any scroll (fixed-position won't follow content scroll)
    window.addEventListener('scroll', closeAllActMenus, true);
    window.addEventListener('resize', closeAllActMenus);


     // -- Open Edit ---------------------------------------------
     async function openEdit(menu) {
         menu.classList.remove('open');

         // Load animals for dropdowns
         const animals = await loadAnimalsForDropdowns();
         const currentDogId = menu.dataset.id;

         // Populate Sire dropdown
         const sireSelect = document.getElementById('e_sireId');
         sireSelect.innerHTML = '<option value="">-- Select Sire --</option>';
         animals.forEach(animal => {
             // Don't include current dog in sire options to prevent circular references
             if (animal.id != currentDogId) {
                 const option = document.createElement('option');
                 option.value = animal.id;
                 option.textContent = animal.name;
                 sireSelect.appendChild(option);
             }
         });

         // Populate Dam dropdown
         const damSelect = document.getElementById('e_damId');
         damSelect.innerHTML = '<option value="">-- Select Dam --</option>';
         animals.forEach(animal => {
             // Don't include current dog in dam options to prevent circular references
             if (animal.id != currentDogId) {
                 const option = document.createElement('option');
                 option.value = animal.id;
                 option.textContent = animal.name;
                 damSelect.appendChild(option);
             }
         });

         // Set form values
         document.getElementById('e_id').value            = menu.dataset.id;
         document.getElementById('e_name').value          = menu.dataset.name  || '';
         document.getElementById('e_breed').value         = menu.dataset.breed  || '';
         document.getElementById('e_color').value         = menu.dataset.color  || '';
         document.getElementById('e_dateOfBirth').value   = menu.dataset.dateofbirth  || '';
         document.getElementById('e_dateOfDeath').value   = menu.dataset.dateofdeath  || '';
         document.getElementById('e_gender').value        = menu.dataset.gender  || '';
         document.getElementById('e_microchipNumber').value = menu.dataset.microchipnumber  || '';
         // Note: File input cannot be pre-populated, so we leave it empty
         // If there's an existing photo, it will be displayed elsewhere
         document.getElementById('e_sireId').value        = menu.dataset.sireid  || '';
         document.getElementById('e_damId').value         = menu.dataset.damid  || '';

         console.log('Edit modal opened for dog ID:', menu.dataset.id);
         console.log('Form data:', {
             name: menu.dataset.name,
             breed: menu.dataset.breed,
             sireId: menu.dataset.sireid,
             damId: menu.dataset.damid
         });

         openModal('editModal');
     }

   

    // -- Toggle Status -----------------------------------------
    async function toggleStatus(menu) {
        menu.classList.remove('open');
        const id = menu.dataset.id;
        const currentStatus = menu.dataset.status === 'true';

        try {
            const res = await fetch(`/Dogs/ToggleStatus/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast(data.message || 'Status updated successfully!', 'success');
                setTimeout(() => location.reload(), 900);
            } else {
                showToast(data.message || 'Failed to update status.', 'error');
            }
        } catch (error) {
            showToast('Network error. Please try again.', 'error');
        }
    }

    // -- Open Delete -------------------------------------------
    function openDelete(menu) {
        menu.classList.remove('open');
        document.getElementById('d_id').value = menu.dataset.id;
        document.getElementById('d_name').textContent = menu.dataset.name;
        openModal('deleteModal');
    }

  


    // -- Loading state -----------------------------------------
    function setLoading(btnId, loading, restoreHtml) {
        const btn = document.getElementById(btnId);
        btn.disabled = loading;
        if (loading) btn.innerHTML = '<span class="spin"></span> Saving�';
        else if (restoreHtml) btn.innerHTML = restoreHtml;
    }

    // -- Toast -------------------------------------------------
    function showToast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = `toast-msg toast-${type}`;
        el.innerHTML = `<i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill'}"></i>${msg}`;
        wrap.appendChild(el);
        requestAnimationFrame(() => el.classList.add('show'));
        setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 350); }, 3500);
    }

    // -- Validation helper -------------------------------------
    function showErr(id, msg) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.style.display = msg ? 'block' : 'none';
    }
    function clearErrs(...ids) { ids.forEach(id => showErr(id, '')); }

     // -- Submit Create -----------------------------------------
     async function submitCreate() {

           clearErrs('c_name_err', 'c_breed_err', 'c_color_err', 'c_dateOfBirth_err', 'c_dateOfDeath_err', 'c_gender_err', 'c_microchipNumber_err', 'c_photoUrl_err', 'c_sireId_err', 'c_damId_err');
         const name  = document.getElementById('c_name').value.trim();
         const breed = document.getElementById('c_breed').value.trim();
         const color = document.getElementById('c_color').value.trim();
         const dateOfBirth = document.getElementById('c_dateOfBirth').value;
         const dateOfDeath = null;
         const gender = document.getElementById('c_gender').value;
         const microchipNumber = document.getElementById('c_microchipNumber').value.trim();
         const sireId = document.getElementById('c_sireId').value;
         const damId = document.getElementById('c_damId').value;
         const photoFile = document.getElementById('c_photoUrl').files[0];

         let valid = true;
         if (!name) { showErr('c_name_err','name is required'); valid = false; }
         if (!breed) { showErr('c_breed_err','breed is required'); valid = false; }
         if (!color) { showErr('c_color_err','color is required'); valid = false; }
         if (!dateOfBirth) { showErr('c_dateOfBirth_err','date of birth is required'); valid = false; }

         if (!valid) return;

         setLoading('createBtn', true);
         try {
             let photoUrl = null;

             // Convert photo to base64 and send with the create request (avoids separate upload + antiforgery issues)
             if (photoFile) {
                 photoUrl = await new Promise((resolve, reject) => {
                     const reader = new FileReader();
                     reader.onload = () => resolve(reader.result);
                     reader.onerror = () => reject(new Error('Failed to read photo file'));
                     reader.readAsDataURL(photoFile);
                 });
             }

             // Send everything in one JSON request
             const res  = await fetch('/Dogs/Create', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({
                     Name: name,
                     Breed: breed,
                     Color: color,
                     DateOfBirth: dateOfBirth || null,
                     DateOfDeath: dateOfDeath || null,
                     Gender: gender || null,
                     MicrochipNumber: microchipNumber || null,
                     PhotoBase64: photoUrl || null,
                     SireId: sireId ? parseInt(sireId, 10) : null,
                     DamId: damId ? parseInt(damId, 10) : null
                 })
             });
             const data = await res.json();
             if (data.success) {
                 showToast(data.message || 'Dog created successfully!', 'success');
                 closeModal('createModal');
                 setTimeout(() => location.reload(), 900);
             } else {
                 showToast(data.message || 'Failed to create Dog.', 'error');
             }
         } catch (error) {
             showToast(error.message || 'Network error. Please try again.', 'error');
         } finally {
             setLoading('createBtn', false, '<i class="bi bi-person-plus-fill"></i> Create Dog');
         }
     }
     // -- Submit Edit -------------------------------------------
     async function submitEdit() {

         const id = document.getElementById('e_id').value;
         const name = document.getElementById('e_name').value.trim();
         const breed = document.getElementById('e_breed').value.trim();
         const color = document.getElementById('e_color').value.trim();
         const dateOfBirth = document.getElementById('e_dateOfBirth').value;
         const dateOfDeath = document.getElementById('e_dateOfDeath').value;
         const gender = document.getElementById('e_gender').value;
         const microchipNumber = document.getElementById('e_microchipNumber').value.trim();
         const sireId = document.getElementById('e_sireId').value;
         const damId = document.getElementById('e_damId').value;
         const photoFile = document.getElementById('e_photoUrl').files[0];

         // if (!fn || !ln) { showToast('First and last name are required.', 'error'); return; }

         setLoading('editBtn', true);
         try {
             let photoUrl = null;

             // Upload photo first if provided
             if (photoFile) {
                 const photoFormData = new FormData();
                 photoFormData.append('file', photoFile);

                 const uploadRes = await fetch('/Dogs/UploadPhoto', {
                     method: 'POST',
                     body: photoFormData
                 });
                 const uploadData = await uploadRes.json();
                 if (!uploadData.success) {
                     throw new Error(uploadData.message || 'Photo upload failed');
                 }
                 photoUrl = uploadData.url;
             }

             // Now update the dog with the photo URL
             const res  = await fetch(`/Dogs/Update/${id}`, {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({
                     Id: id,
                     Name: name,
                     Breed: breed,
                     Color: color,
                     DateOfBirth: dateOfBirth,
                     DateOfDeath: dateOfDeath,
                     Gender: gender,
                     MicrochipNumber: microchipNumber,
                     PhotoUrl: photoUrl,
                     SireId: sireId,
                     DamId: damId
                 })
             });
             const data = await res.json();
             if (data.success) {
                 showToast(data.message || 'Dog updated!', 'success');
                 closeModal('editModal');
                 setTimeout(() => location.reload(), 900);
             } else {
                 showToast(data.message || 'Failed to update Dog.', 'error');
             }
         } catch (error) {
             showToast(error.message || 'Network error. Please try again.', 'error');
         } finally {
             setLoading('editBtn', false, '<i class="bi bi-check2-circle"></i> Save Changes');
         }
     }


