@model Dog.Portal.Models.ExpenseListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Expenses";
    var totalAll = Model.TotalCount;
    var P = PermHelper.For(Context);
    var categories = new[] { "Food", "Vet", "Fuel", "Salaries", "Equipment", "Training", "Other" };
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#fee2e2;color:#b91c1c;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.btn-add{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer}
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.si-total{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#b91c1c}
.si-month{background:linear-gradient(135deg,#ffedd5,#fed7aa);color:#c2410c}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:280px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:130px}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem}
.tbl-wrap{overflow-x:auto;min-height:300px}
.dt{width:100%;border-collapse:collapse}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle}
.dt tbody tr:hover td{background:#fafbff}
.cat-badge{display:inline-flex;align-items:center;font-size:.72rem;font-weight:700;padding:.22rem .6rem;border-radius:20px;background:#f1f5f9;color:#475569}
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18);min-width:180px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;border:none;background:none;width:100%;text-align:left;text-decoration:none}
.act-item:hover{background:#f8fafc}
.act-item.danger{color:#dc2626}
.act-item.danger:hover{background:#fef2f2}
.act-divider{height:1px;background:#f1f5f9;margin:.25rem 0}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;color:#64748b;text-decoration:none;background:#fff}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:560px;max-height:90vh;overflow-y:auto}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.modal-body{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem}
.frow{margin-bottom:1rem}
.frow label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:.375rem}
.frow-2{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.finput{width:100%;padding:.65rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;color:#1e293b;background:#fff;outline:none}
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer}
.btn-pm{padding:.65rem 1.5rem;background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;border:none;border-radius:9px;font-size:.855rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;min-width:120px;justify-content:center}
.btn-pm:disabled{opacity:.6;cursor:not-allowed}
.del-icon{width:60px;height:60px;border-radius:50%;background:#fef2f2;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#dc2626}
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
.spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@@keyframes spin{to{transform:rotate(360deg)}}
</style>
<div class="toast-wrap" id="toastWrap"></div>
<div class="page-hdr-row">
  <div class="page-hdr"><h4>Expenses</h4><p>Track operating costs — food, vet bills, fuel, salaries and more</p></div>
  <div class="hdr-actions">
    <span class="total-chip"><i class="bi bi-cash-stack"></i> @totalAll Total</span>
    @if (P.Can("expense.create")) {
    <button class="btn-add" onclick="openCreateModal()"><i class="bi bi-plus-lg"></i> Add Expense</button>
    }
  </div>
</div>
<div class="stats-row">
  <div class="stat-card"><div class="stat-icon si-total"><i class="bi bi-cash-stack"></i></div><div class="stat-body"><div class="val">@Model.TotalAmount.ToString("0.00")</div><div class="lbl">Total Expenses</div></div></div>
  <div class="stat-card"><div class="stat-icon si-month"><i class="bi bi-calendar-month"></i></div><div class="stat-body"><div class="val">@Model.ThisMonthAmount.ToString("0.00")</div><div class="lbl">This Month</div></div></div>
</div>
<div class="dc">
  <div class="dc-head">
    <form method="get" style="display:contents">
      <div class="srch-wrap"><i class="bi bi-search"></i><input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search description, vendor, dog..."></div>
      <select name="category" class="filter-sel">
        <option value="">All Categories</option>
        @foreach (var c in categories) {
          if (Model.CategoryFilter == c) { <option value="@c" selected>@c</option> }
          else { <option value="@c">@c</option> }
        }
      </select>
      <button type="submit" class="btn-srch"><i class="bi bi-search"></i> Search</button>
      <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
    </form>
  </div>
  <div class="tbl-wrap">
    @if (Model.ExpenseList.Count > 0) {
      <table class="dt">
        <thead><tr>
          <th style="width:100px">Date</th>
          <th style="width:110px">Category</th>
          <th>Description</th>
          <th style="width:130px">Dog</th>
          <th style="width:130px">Vendor</th>
          <th style="width:100px">Amount</th>
          <th style="width:80px">Actions</th>
        </tr></thead>
        <tbody>
          @foreach (var item in Model.ExpenseList) {
            <tr>
              <td>@item.ExpenseDate.ToString("MMM dd, yyyy")</td>
              <td><span class="cat-badge">@item.Category</span></td>
              <td title="@item.Description">@item.Description</td>
              <td>@(item.DogName ?? "—")</td>
              <td>@(item.Vendor ?? "—")</td>
              <td style="font-weight:700;color:#b91c1c">@item.Amount.ToString("0.00")</td>
              <td>
                <div class="act-wrap">
                  <button class="act-btn" onclick="toggleActMenu(this)" title="Actions"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu"
                       data-id="@item.Id"
                       data-category="@item.Category"
                       data-description="@item.Description"
                       data-amount="@item.Amount"
                       data-expensedate="@item.ExpenseDate.ToString("yyyy-MM-dd")"
                       data-dogid="@item.DogId"
                       data-vendor="@item.Vendor"
                       data-paymentmethod="@item.PaymentMethod"
                       data-notes="@item.Notes">
                    @if (P.Can("expense.edit")) {
                    <button class="act-item" onclick="openEdit(this.closest('.act-menu'))"><i class="bi bi-pencil-fill" style="color:#667eea"></i> Edit</button>
                    }
                    @if (P.Can("expense.delete")) {
                    <div class="act-divider"></div>
                    <button class="act-item danger" onclick="openDelete(this.closest('.act-menu'))"><i class="bi bi-trash3-fill"></i> Delete</button>
                    }
                  </div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    } else {
      <div class="empty-state"><i class="bi bi-cash-stack"></i><h3>No expenses recorded</h3><p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Get started by adding your first expense." : "Try adjusting your search.")</p></div>
    }
  </div>
  @if (Model.TotalCount > 0) {
    <div class="dc-foot">
      <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
      @if (Model.TotalPages > 1) {
        <div class="pgn">
          @if (Model.Page > 1) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, category=Model.CategoryFilter, page=Model.Page-1 })" class="pb">Prev</a> }
          else { <span class="pb off">Prev</span> }
          @for (int p = Math.Max(1,Model.Page-2); p <= Math.Min(Model.TotalPages,Model.Page+2); p++) {
            if (p==Model.Page) { <span class="pb cur">@p</span> }
            else { <a href="@Url.Action("Index", new { search=Model.SearchTerm, category=Model.CategoryFilter, page=p })" class="pb">@p</a> }
          }
          @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, category=Model.CategoryFilter, page=Model.Page+1 })" class="pb">Next</a> }
          else { <span class="pb off">Next</span> }
        </div>
      }
    </div>
  }
</div>

<!-- CREATE/EDIT MODAL -->
<div class="modal-backdrop-custom" id="expenseModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-cash-stack" style="color:#b91c1c"></i> <span id="modalTitle">Add Expense</span></h5>
      <button class="modal-close" onclick="closeModal('expenseModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="e_id">
      <div class="frow-2">
        <div class="frow"><label>Category <span style="color:#ef4444">*</span></label>
          <select class="finput" id="e_category">
            @foreach (var c in categories) { <option value="@c">@c</option> }
          </select>
        </div>
        <div class="frow"><label>Amount <span style="color:#ef4444">*</span></label><input class="finput" type="number" step="0.01" min="0" id="e_amount" placeholder="0.00"></div>
      </div>
      <div class="frow"><label>Description <span style="color:#ef4444">*</span></label><input class="finput" id="e_description" placeholder="e.g. Monthly dog food order"></div>
      <div class="frow-2">
        <div class="frow"><label>Date <span style="color:#ef4444">*</span></label><input class="finput" type="date" id="e_expenseDate"></div>
        <div class="frow"><label>Dog (optional)</label>
          <select class="finput" id="e_dogId">
            <option value="">Not dog-specific</option>
            @foreach (var d in Model.Dogs) { <option value="@d.Id">@d.Name</option> }
          </select>
        </div>
      </div>
      <div class="frow-2">
        <div class="frow"><label>Vendor</label><input class="finput" id="e_vendor" placeholder="Paid to"></div>
        <div class="frow"><label>Payment Method</label>
          <select class="finput" id="e_paymentMethod">
            <option value="">Select</option>
            <option>Cash</option><option>Bank Transfer</option><option>EcoCash</option><option>Card</option><option>Other</option>
          </select>
        </div>
      </div>
      <div class="frow"><label>Notes</label><textarea class="finput" id="e_notes" rows="2" placeholder="Optional notes..."></textarea></div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('expenseModal')">Cancel</button>
      <button class="btn-pm" id="saveBtn" onclick="submitExpense()"><i class="bi bi-check2-circle"></i> Save</button>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-backdrop-custom" id="deleteModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-trash3-fill" style="color:#dc2626"></i> Delete Expense</h5>
      <button class="modal-close" onclick="closeModal('deleteModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body" style="text-align:center;padding-top:1.75rem">
      <input type="hidden" id="d_id">
      <div class="del-icon"><i class="bi bi-cash-stack"></i></div>
      <p style="font-size:.9rem;color:#374151;margin-bottom:.5rem">Delete this expense?</p>
      <p id="d_name" style="font-weight:700;color:#1e293b;font-size:1rem;margin-bottom:.5rem"></p>
      <p style="font-size:.82rem;color:#94a3b8;margin:0">This action cannot be undone.</p>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn-pm" id="deleteBtn" onclick="submitDelete()"><i class="bi bi-trash3-fill"></i> Delete</button>
    </div>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.modal-backdrop-custom').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)closeModal(bd.id);});});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop-custom.open').forEach(function(m){closeModal(m.id);});}});
function toggleActMenu(btn){var menu=btn.nextElementSibling;var isOpen=menu.classList.contains('open');closeAllActMenus();if(!isOpen){positionActMenu(btn,menu);menu.classList.add('open');}}
function closeAllActMenus(){document.querySelectorAll('.act-menu.open').forEach(function(m){m.classList.remove('open');m.style.top='';m.style.left='';m.style.right='';});}
function positionActMenu(btn,menu){menu.style.visibility='hidden';menu.style.display='block';var mr=menu.getBoundingClientRect();menu.style.display='';menu.style.visibility='';var br=btn.getBoundingClientRect();var right=window.innerWidth-br.right;if(right<8)right=8;var top=br.bottom+4;if(top+mr.height>window.innerHeight-8){var up=br.top-mr.height-4;top=up>=8?up:Math.max(8,window.innerHeight-mr.height-8);}menu.style.top=top+'px';menu.style.right=right+'px';menu.style.left='auto';}
document.addEventListener('click',function(e){if(!e.target.closest('.act-wrap'))closeAllActMenus();});
window.addEventListener('scroll',closeAllActMenus,true);
window.addEventListener('resize',closeAllActMenus);
function setLoading(id,on,html){var b=document.getElementById(id);b.disabled=on;if(on)b.innerHTML='<span class="spin"></span> Saving...';else if(html)b.innerHTML=html;}
function showToast(msg,type){var w=document.getElementById('toastWrap');var el=document.createElement('div');el.className='toast-msg toast-'+type;el.innerHTML='<i class="bi '+(type==='success'?'bi-check-circle-fill':'bi-exclamation-circle-fill')+'"></i>'+msg;w.appendChild(el);requestAnimationFrame(function(){el.classList.add('show');});setTimeout(function(){el.classList.remove('show');setTimeout(function(){el.remove();},350);},3500);}

function openCreateModal(){
  document.getElementById('modalTitle').textContent='Add Expense';
  document.getElementById('e_id').value='';
  document.getElementById('e_category').value='Food';
  document.getElementById('e_amount').value='';
  document.getElementById('e_description').value='';
  document.getElementById('e_expenseDate').value=new Date().toISOString().split('T')[0];
  document.getElementById('e_dogId').value='';
  document.getElementById('e_vendor').value='';
  document.getElementById('e_paymentMethod').value='';
  document.getElementById('e_notes').value='';
  openModal('expenseModal');
}
function openEdit(menu){
  closeAllActMenus();
  var d=menu.dataset;
  document.getElementById('modalTitle').textContent='Edit Expense';
  document.getElementById('e_id').value=d.id;
  document.getElementById('e_category').value=d.category;
  document.getElementById('e_amount').value=d.amount;
  document.getElementById('e_description').value=d.description;
  document.getElementById('e_expenseDate').value=d.expensedate;
  document.getElementById('e_dogId').value=d.dogid&&d.dogid!=='' ? d.dogid : '';
  document.getElementById('e_vendor').value=d.vendor||'';
  document.getElementById('e_paymentMethod').value=d.paymentmethod||'';
  document.getElementById('e_notes').value=d.notes||'';
  openModal('expenseModal');
}
function openDelete(menu){closeAllActMenus();var d=menu.dataset;document.getElementById('d_id').value=d.id;document.getElementById('d_name').textContent=d.description||'this expense';openModal('deleteModal');}

async function submitExpense(){
  var category=document.getElementById('e_category').value;
  var amount=parseFloat(document.getElementById('e_amount').value);
  var description=document.getElementById('e_description').value.trim();
  var expenseDate=document.getElementById('e_expenseDate').value;
  if(!description){showToast('Description is required.','error');return;}
  if(!amount||amount<=0){showToast('Please enter a valid amount.','error');return;}
  if(!expenseDate){showToast('Date is required.','error');return;}
  var id=document.getElementById('e_id').value;
  var payload={
    category:category,
    amount:amount,
    description:description,
    expenseDate:expenseDate,
    dogId:document.getElementById('e_dogId').value?parseInt(document.getElementById('e_dogId').value):null,
    vendor:document.getElementById('e_vendor').value.trim()||null,
    paymentMethod:document.getElementById('e_paymentMethod').value||null,
    notes:document.getElementById('e_notes').value.trim()||null,
  };
  if(id) payload.id=parseInt(id);
  setLoading('saveBtn',true);
  try{
    var url=id?'/Expenses/Update':'/Expenses/Create';
    var res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    var data=await res.json();
    if(data.success){showToast(data.message||'Expense saved!','success');closeModal('expenseModal');setTimeout(function(){location.reload();},900);}
    else showToast(data.message||'Failed.','error');
  }catch(e){showToast('Network error.','error');}
  finally{setLoading('saveBtn',false,'<i class="bi bi-check2-circle"></i> Save');}
}

async function submitDelete(){
  var id=document.getElementById('d_id').value;
  setLoading('deleteBtn',true);
  try{
    var res=await fetch('/Expenses/Delete/'+id,{method:'POST'});
    var data=await res.json();
    if(data.success){showToast(data.message||'Expense deleted.','success');closeModal('deleteModal');setTimeout(function(){location.reload();},900);}
    else showToast(data.message||'Failed.','error');
  }catch(e){showToast('Network error.','error');}
  finally{setLoading('deleteBtn',false,'<i class="bi bi-trash3-fill"></i> Delete');}
}
</script>
