// Breed Functions
function toggleBreeds(breedGroupId, breedGroupName) {
    const row = document.getElementById(`breed-row-${breedGroupId}`);
    const section = document.getElementById(`breed-section-${breedGroupId}`);
    
    if (row.style.display === 'none') {
        row.style.display = 'table-row';
        section.classList.add('show');
        
        // Load breeds if not already loaded
        if (!loadedBreedGroups.has(breedGroupId)) {
            loadBreeds(breedGroupId);
            loadedBreedGroups.add(breedGroupId);
        }
    } else {
        row.style.display = 'none';
        section.classList.remove('show');
    }
}

function loadBreeds(breedGroupId) {
    const grid = document.getElementById(`breed-grid-${breedGroupId}`);
    
    fetch(`/BreedGroups/GetBreedsByGroup?breedGroupId=${breedGroupId}`)
    .then(response => response.json())
    .then(data => {
        if (data.success && data.data) {
            displayBreeds(breedGroupId, data.data);
        } else {
            grid.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-exclamation-triangle"></i>
                    <h3>Failed to load breeds</h3>
                    <p>Please try again later.</p>
                </div>
            `;
        }
    })
    .catch(error => {
        console.error('Error loading breeds:', error);
        grid.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-exclamation-triangle"></i>
                <h3>Error loading breeds</h3>
                <p>Please try again later.</p>
            </div>
        `;
    });
}

function displayBreeds(breedGroupId, breeds) {
    const grid = document.getElementById(`breed-grid-${breedGroupId}`);
    
    if (breeds.length === 0) {
        grid.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-paw"></i>
                <h3>No breeds found</h3>
                <p>Start by adding breeds to this group.</p>
            </div>
        `;
        return;
    }
    
    grid.innerHTML = breeds.map(breed => `
        <div class="breed-card">
            <div class="breed-name">${breed.name}</div>
            <div class="breed-actions">
                <button type="button" class="btn-breed-edit" onclick="openEditBreedModal(${breed.id}, '${breed.name}', ${breed.breedGroupId}, '${document.getElementById('breed-group-name-' + breed.breedGroupId).textContent}', ${breed.isActive})" title="Edit">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" class="btn-breed-delete" onclick="deleteBreed(${breed.id}, '${breed.name}', ${breed.breedGroupId})" title="Delete">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
    `).join('');
}

