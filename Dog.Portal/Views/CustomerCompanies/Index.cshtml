@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customer Companies";
    var P = PermHelper.For(Context);
    var openId = ViewBag.OpenId as int?;
}
<style>
.cc-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem}
.cc-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.cc-hdr p{font-size:.845rem;color:#64748b;margin:0}
.cc-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.2rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer}
.cc-btn.sec{background:#f1f5f9;color:#475569;border:1.5px solid #e2e8f0}
.cc-btn.danger{background:linear-gradient(135deg,#ef4444,#dc2626)}
.cc-btn:disabled{opacity:.6;cursor:not-allowed}
.cc-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.875rem;margin-bottom:1.25rem}
.cc-stat{background:#fff;border:1px solid #e9eef4;border-radius:12px;padding:.9rem 1.1rem}
.cc-stat .v{font-size:1.3rem;font-weight:800;color:#0f172a;line-height:1.1}
.cc-stat .l{font-size:.74rem;color:#94a3b8;font-weight:600;margin-top:.2rem;text-transform:uppercase;letter-spacing:.03em}
.cc-card{background:#fff;border:1px solid #e9eef4;border-radius:14px;overflow:hidden}
.cc-bar{padding:.9rem 1.2rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;gap:.6rem;flex-wrap:wrap;align-items:center}
.cc-search{flex:1;min-width:200px;max-width:340px;padding:.55rem .9rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.85rem;outline:none}
.cc-search:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.cc-table{width:100%;border-collapse:collapse}
.cc-table th{padding:.7rem 1rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;text-align:left;white-space:nowrap}
.cc-table td{padding:.8rem 1rem;font-size:.85rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle}
.cc-table tbody tr{cursor:pointer}.cc-table tbody tr:hover td{background:#fafbff}
.cc-name{font-weight:700;color:#1e293b}.cc-sub{font-size:.74rem;color:#94a3b8}
.cc-num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.cc-pill{display:inline-block;padding:.15rem .6rem;border-radius:20px;font-size:.7rem;font-weight:700}
.cc-pill.ok{background:#d1fae5;color:#047857}.cc-pill.off{background:#e2e8f0;color:#64748b}.cc-pill.due{background:#fee2e2;color:#b91c1c}
.cc-empty{text-align:center;padding:3rem 1rem;color:#94a3b8}
.cc-bd{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.cc-bd.open{display:flex}
.cc-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:720px;max-height:92vh;overflow-y:auto}
.cc-box.wide{max-width:900px}
.cc-mh{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.4rem;border-bottom:1px solid #f1f5f9;position:sticky;top:0;background:#fff;z-index:2}
.cc-mh h5{font-size:1rem;font-weight:800;margin:0;color:#0f172a}
.cc-x{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer}
.cc-mb{padding:1.2rem 1.4rem}.cc-mf{padding:.9rem 1.4rem;border-top:1px solid #f1f5f9;display:flex;justify-content:flex-end;gap:.6rem;position:sticky;bottom:0;background:#fff}
.cc-sec{font-size:.72rem;font-weight:800;color:#6366f1;text-transform:uppercase;letter-spacing:.06em;margin:.9rem 0 .5rem;padding-bottom:.3rem;border-bottom:1px solid #eef2ff}
.cc-sec:first-child{margin-top:0}
.cc-g2{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.cc-g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.8rem}
@@media(max-width:640px){.cc-g2,.cc-g3{grid-template-columns:1fr}}
.cc-f{margin-bottom:.8rem}.cc-f label{display:block;font-size:.78rem;font-weight:600;color:#374151;margin-bottom:.3rem}.cc-f .req{color:#ef4444}
.cc-i{width:100%;padding:.6rem .8rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.85rem;outline:none;background:#fff}
.cc-i:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.cc-prof-top{display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;margin-bottom:1rem}
.cc-kv{display:grid;grid-template-columns:150px 1fr;gap:.35rem .8rem;font-size:.85rem}.cc-kv span:nth-child(odd){color:#94a3b8;font-weight:600}
.cc-tabs{display:flex;gap:.3rem;margin:1rem 0 .6rem;border-bottom:1px solid #f1f5f9}
.cc-tab{padding:.5rem .9rem;border:none;background:none;font-size:.82rem;font-weight:700;color:#94a3b8;cursor:pointer;border-bottom:2px solid transparent}
.cc-tab.on{color:#4f46e5;border-bottom-color:#4f46e5}
.cc-toast{position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;padding:.8rem 1.2rem;border-radius:11px;font-size:.85rem;font-weight:600;color:#fff;box-shadow:0 8px 28px rgba(0,0,0,.18);display:none;max-width:340px}
.cc-toast.ok{background:#065f46}.cc-toast.err{background:#991b1b}
</style>

<div class="cc-hdr">
  <div><h4><i class="bi bi-buildings" style="color:#667eea"></i> Customer Companies</h4><p>The companies you bill. Invoices are addressed to the company and carry its registration, tax and VAT details.</p></div>
  @if (P.Can("customercompany.create")) { <button class="cc-btn" onclick="ccEdit(0)"><i class="bi bi-plus-lg"></i> Add company</button> }
</div>

<div class="cc-stats" id="ccStats"></div>

<div class="cc-card">
  <div class="cc-bar">
    <input class="cc-search" id="ccSearch" placeholder="Search name, VAT, TIN, registration, email…" oninput="ccDebounce()">
    <span class="cc-sub" id="ccCount"></span>
  </div>
  <div style="overflow-x:auto"><table class="cc-table">
    <thead><tr><th>Company</th><th>VAT / TIN</th><th>Billing email</th><th>Contacts</th><th class="cc-num">Invoices</th><th class="cc-num">Billed</th><th class="cc-num">Outstanding</th><th>Status</th></tr></thead>
    <tbody id="ccBody"><tr><td colspan="8" class="cc-empty">Loading…</td></tr></tbody>
  </table></div>
</div>

<!-- Add / edit -->
<div class="cc-bd" id="ccEditModal"><div class="cc-box">
  <div class="cc-mh"><h5 id="ccEditTitle">Add company</h5><button class="cc-x" onclick="ccClose('ccEditModal')"><i class="bi bi-x-lg"></i></button></div>
  <div class="cc-mb">
    <input type="hidden" id="f_id">
    <div class="cc-sec">Company</div>
    <div class="cc-g2">
      <div class="cc-f"><label>Registered name <span class="req">*</span></label><input class="cc-i" id="f_name"></div>
      <div class="cc-f"><label>Trading name</label><input class="cc-i" id="f_trading"></div>
    </div>
    <div class="cc-g3">
      <div class="cc-f"><label>Registration no.</label><input class="cc-i" id="f_reg"></div>
      <div class="cc-f"><label>TIN / BP no.</label><input class="cc-i" id="f_tax"></div>
      <div class="cc-f"><label>VAT no.</label><input class="cc-i" id="f_vat"></div>
    </div>
    <div class="cc-sec">Contact &amp; billing</div>
    <div class="cc-g2">
      <div class="cc-f"><label>Main contact person</label><input class="cc-i" id="f_contact"></div>
      <div class="cc-f"><label>Phone</label><input class="cc-i" id="f_phone"></div>
      <div class="cc-f"><label>Company email</label><input class="cc-i" id="f_email" type="email"></div>
      <div class="cc-f"><label>Billing email <span class="cc-sub">(invoices are sent here; several allowed, separated by ;)</span></label><input class="cc-i" id="f_bemail"></div>
    </div>
    <div class="cc-f"><label>Address</label><input class="cc-i" id="f_addr" placeholder="Street, suburb"></div>
    <div class="cc-g3">
      <div class="cc-f"><label>City</label><input class="cc-i" id="f_city"></div>
      <div class="cc-f"><label>Country</label><input class="cc-i" id="f_country" value="Zimbabwe"></div>
      <div class="cc-f"><label>Website</label><input class="cc-i" id="f_web"></div>
    </div>
    <div class="cc-g2">
      <div class="cc-f"><label>Payment terms (days)</label><input class="cc-i" id="f_terms" type="number" min="0" max="365" value="30"></div>
      <div class="cc-f"><label>Status</label><select class="cc-i" id="f_active"><option value="1">Active</option><option value="0">Inactive</option></select></div>
    </div>
    <div class="cc-f"><label>Notes</label><textarea class="cc-i" id="f_notes" rows="2"></textarea></div>
  </div>
  <div class="cc-mf"><button class="cc-btn sec" onclick="ccClose('ccEditModal')">Cancel</button><button class="cc-btn" id="ccSaveBtn" onclick="ccSave()"><i class="bi bi-check2-circle"></i> Save company</button></div>
</div></div>

<!-- Profile -->
<div class="cc-bd" id="ccProfModal"><div class="cc-box wide">
  <div class="cc-mh"><h5 id="ccProfTitle">Company</h5><button class="cc-x" onclick="ccClose('ccProfModal')"><i class="bi bi-x-lg"></i></button></div>
  <div class="cc-mb" id="ccProfBody"></div>
  <div class="cc-mf" id="ccProfFoot"></div>
</div></div>

<!-- Delete -->
<div class="cc-bd" id="ccDelModal"><div class="cc-box" style="max-width:440px">
  <div class="cc-mh"><h5>Delete company</h5><button class="cc-x" onclick="ccClose('ccDelModal')"><i class="bi bi-x-lg"></i></button></div>
  <div class="cc-mb" style="text-align:center"><p>Delete <b id="ccDelName"></b>?</p><p class="cc-sub">Its contacts stay as customers, just without a company. A company that has invoices cannot be deleted — mark it inactive instead.</p></div>
  <div class="cc-mf"><button class="cc-btn sec" onclick="ccClose('ccDelModal')">Cancel</button><button class="cc-btn danger" id="ccDelBtn" onclick="ccDelete()">Delete</button></div>
</div></div>
<div class="cc-toast" id="ccToast"></div>

<script>
var CC_CAN = { edit: @(P.Can("customercompany.edit") ? "true" : "false"), del: @(P.Can("customercompany.delete") ? "true" : "false"), inv: @(P.Can("invoice.create") ? "true" : "false") };
var ccList = [], ccDelId = 0, ccTimer = null;
function esc(s){return (s==null?'':String(s)).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function money(v){return (Number(v)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
function ccOpen(id){document.getElementById(id).classList.add('open');}
function ccClose(id){document.getElementById(id).classList.remove('open');}
function ccToast(m,ok){var t=document.getElementById('ccToast');t.textContent=m;t.className='cc-toast '+(ok?'ok':'err');t.style.display='block';clearTimeout(t._h);t._h=setTimeout(function(){t.style.display='none';},4000);}
async function api(method,path,body){
  try{var r=await fetch('/BillingApi/'+path,{method:method,headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});
      var j=await r.json();return j;}catch(e){return {success:false,message:'Network error. Please try again.'};}
}
function ccDebounce(){clearTimeout(ccTimer);ccTimer=setTimeout(ccLoad,300);}
async function ccLoad(){
  var q=document.getElementById('ccSearch').value.trim();
  var j=await api('GET','CustomerCompany'+(q?'?search='+encodeURIComponent(q):''));
  if(!j.success){document.getElementById('ccBody').innerHTML='<tr><td colspan="8" class="cc-empty">'+esc(j.message||'Could not load companies.')+'</td></tr>';return;}
  ccList=j.data||[];
  var out=ccList.reduce(function(a,c){return a+(c.outstanding||0);},0), billed=ccList.reduce(function(a,c){return a+(c.totalBilled||0);},0);
  document.getElementById('ccStats').innerHTML=
    '<div class="cc-stat"><div class="v">'+ccList.length+'</div><div class="l">Companies</div></div>'+
    '<div class="cc-stat"><div class="v">'+ccList.reduce(function(a,c){return a+(c.contactCount||0);},0)+'</div><div class="l">Contact people</div></div>'+
    '<div class="cc-stat"><div class="v">'+money(billed)+'</div><div class="l">Total billed</div></div>'+
    '<div class="cc-stat"><div class="v" style="color:'+(out>0?'#b91c1c':'#047857')+'">'+money(out)+'</div><div class="l">Outstanding</div></div>';
  document.getElementById('ccCount').textContent=ccList.length+' compan'+(ccList.length===1?'y':'ies');
  document.getElementById('ccBody').innerHTML=ccList.length?ccList.map(function(c){
    return '<tr onclick="ccProfile('+c.id+')"><td><div class="cc-name">'+esc(c.name)+'</div><div class="cc-sub">'+esc(c.tradingName||c.city||'')+'</div></td>'+
      '<td><div>'+(c.vatNumber?'VAT '+esc(c.vatNumber):'<span class="cc-sub">no VAT no.</span>')+'</div><div class="cc-sub">'+(c.taxNumber?'TIN '+esc(c.taxNumber):'')+'</div></td>'+
      '<td>'+esc(c.billingEmail||c.email||'—')+'</td><td>'+(c.contactCount||0)+'</td><td class="cc-num">'+(c.invoiceCount||0)+'</td>'+
      '<td class="cc-num">'+money(c.totalBilled)+'</td><td class="cc-num" style="font-weight:700;color:'+(c.outstanding>0?'#b91c1c':'#047857')+'">'+money(c.outstanding)+'</td>'+
      '<td><span class="cc-pill '+(c.isActive?'ok':'off')+'">'+(c.isActive?'Active':'Inactive')+'</span></td></tr>';
  }).join(''):'<tr><td colspan="8" class="cc-empty"><i class="bi bi-buildings" style="font-size:2.4rem;display:block;color:#cbd5e1"></i>No companies yet. Add the companies you invoice.</td></tr>';
}
function ccEdit(id){
  var c=id?ccList.find(function(x){return x.id===id;}):null;
  document.getElementById('ccEditTitle').textContent=c?'Edit company':'Add company';
  var set=function(k,v){document.getElementById('f_'+k).value=v==null?'':v;};
  set('id',c?c.id:0);set('name',c&&c.name);set('trading',c&&c.tradingName);set('reg',c&&c.registrationNumber);set('tax',c&&c.taxNumber);set('vat',c&&c.vatNumber);
  set('contact',c&&c.contactPerson);set('phone',c&&c.phone);set('email',c&&c.email);set('bemail',c&&c.billingEmail);set('addr',c&&c.address);set('city',c&&c.city);
  set('country',c?c.country:'Zimbabwe');set('web',c&&c.website);set('terms',c?c.paymentTermsDays:30);set('active',c&&!c.isActive?'0':'1');set('notes',c&&c.notes);
  ccClose('ccProfModal');ccOpen('ccEditModal');
}
async function ccSave(){
  var g=function(k){return document.getElementById('f_'+k).value.trim();};
  if(!g('name')){ccToast('Enter the company name.',false);return;}
  var id=parseInt(g('id'))||0;
  var body={name:g('name'),tradingName:g('trading')||null,registrationNumber:g('reg')||null,taxNumber:g('tax')||null,vatNumber:g('vat')||null,contactPerson:g('contact')||null,phone:g('phone')||null,
    email:g('email')||null,billingEmail:g('bemail')||null,address:g('addr')||null,city:g('city')||null,country:g('country')||null,website:g('web')||null,
    paymentTermsDays:parseInt(g('terms'))||0,isActive:g('active')==='1',notes:g('notes')||null};
  var btn=document.getElementById('ccSaveBtn');btn.disabled=true;
  var j=await api(id?'PUT':'POST','CustomerCompany'+(id?'/'+id:''),body);
  btn.disabled=false;
  if(j.success){ccToast(j.message||'Saved.',true);ccClose('ccEditModal');ccLoad();}else ccToast(j.message||'Could not save.',false);
}
var ccTab='contacts', ccProf=null;
async function ccProfile(id){
  var j=await api('GET','CustomerCompany/'+id);
  if(!j.success){ccToast(j.message||'Could not load the company.',false);return;}
  ccProf=j.data;ccTab='contacts';ccRenderProfile();ccOpen('ccProfModal');
}
function ccRenderProfile(){
  var c=ccProf;
  document.getElementById('ccProfTitle').innerHTML='<i class="bi bi-buildings" style="color:#667eea"></i> '+esc(c.name);
  var kv=function(k,v){return '<span>'+k+'</span><span>'+(v?esc(v):'—')+'</span>';};
  var h='<div class="cc-prof-top"><div class="cc-kv" style="flex:1;min-width:280px">'+kv('Trading name',c.tradingName)+kv('Registration no.',c.registrationNumber)+kv('TIN / BP no.',c.taxNumber)+kv('VAT no.',c.vatNumber)+
    kv('Contact person',c.contactPerson)+kv('Phone',c.phone)+kv('Email',c.email)+kv('Billing email',c.billingEmail)+kv('Address',[c.address,c.city,c.country].filter(Boolean).join(', '))+kv('Payment terms',c.paymentTermsDays+' days')+'</div>'+
    '<div class="cc-stats" style="min-width:230px;grid-template-columns:1fr 1fr"><div class="cc-stat"><div class="v">'+money(c.totalBilled)+'</div><div class="l">Billed</div></div><div class="cc-stat"><div class="v">'+money(c.totalPaid)+'</div><div class="l">Paid</div></div>'+
    '<div class="cc-stat" style="grid-column:1/3"><div class="v" style="color:'+(c.outstanding>0?'#b91c1c':'#047857')+'">'+money(c.outstanding)+'</div><div class="l">Outstanding</div></div></div></div>';
  h+='<div class="cc-tabs"><button class="cc-tab '+(ccTab==='contacts'?'on':'')+'" onclick="ccTab=\'contacts\';ccRenderProfile()">Contact people ('+c.contacts.length+')</button><button class="cc-tab '+(ccTab==='invoices'?'on':'')+'" onclick="ccTab=\'invoices\';ccRenderProfile()">Invoices ('+c.invoices.length+')</button></div>';
  if(ccTab==='contacts'){
    h+=c.contacts.length?'<table class="cc-table"><thead><tr><th>Name</th><th>Role</th><th>Phone</th><th>Email</th></tr></thead><tbody>'+c.contacts.map(function(x){return '<tr onclick="location.href=\'/Customers/Details/'+x.id+'\'"><td class="cc-name">'+esc(x.fullName)+'</td><td>'+esc(x.jobTitle||'—')+'</td><td>'+esc(x.cellphone||'—')+'</td><td>'+esc(x.email||'—')+'</td></tr>';}).join('')+'</tbody></table>'
      :'<div class="cc-empty">No contact people yet. Add a customer and choose this company.</div>';
  } else {
    h+=c.invoices.length?'<table class="cc-table"><thead><tr><th>Invoice</th><th>Date</th><th>Due</th><th class="cc-num">Total</th><th class="cc-num">Balance</th><th>Status</th></tr></thead><tbody>'+c.invoices.map(function(i){return '<tr onclick="location.href=\'/Invoices?search='+encodeURIComponent(i.invoiceNumber)+'\'"><td class="cc-name">'+esc(i.invoiceNumber)+'</td><td>'+new Date(i.invoiceDate).toLocaleDateString()+'</td><td>'+new Date(i.dueDate).toLocaleDateString()+'</td><td class="cc-num">'+money(i.totalAmount)+'</td><td class="cc-num">'+money(i.balanceAmount)+'</td><td><span class="cc-pill '+(i.status==='PAID'?'ok':i.status==='CANCELLED'?'off':'due')+'">'+esc(i.status)+'</span></td></tr>';}).join('')+'</tbody></table>'
      :'<div class="cc-empty">No invoices for this company yet.</div>';
  }
  document.getElementById('ccProfBody').innerHTML=h;
  var f='';
  if(CC_CAN.del) f+='<button class="cc-btn danger" onclick="ccAskDelete('+c.id+')"><i class="bi bi-trash3"></i> Delete</button>';
  f+='<span style="flex:1"></span>';
  if(CC_CAN.edit) f+='<button class="cc-btn sec" onclick="ccEdit('+c.id+')"><i class="bi bi-pencil"></i> Edit</button>';
  if(CC_CAN.inv) f+='<a class="cc-btn" style="text-decoration:none" href="/Invoices?newFor='+c.id+'"><i class="bi bi-receipt"></i> New invoice</a>';
  document.getElementById('ccProfFoot').innerHTML=f;
}
function ccAskDelete(id){var c=ccList.find(function(x){return x.id===id;})||ccProf;ccDelId=id;document.getElementById('ccDelName').textContent=c.name;ccClose('ccProfModal');ccOpen('ccDelModal');}
async function ccDelete(){
  var b=document.getElementById('ccDelBtn');b.disabled=true;
  var j=await api('DELETE','CustomerCompany/'+ccDelId);b.disabled=false;
  if(j.success){ccToast(j.message||'Deleted.',true);ccClose('ccDelModal');ccLoad();}else ccToast(j.message||'Could not delete.',false);
}
document.querySelectorAll('.cc-bd').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)ccClose(bd.id);});});
ccLoad().then(function(){ @if (openId.HasValue) { <text>ccProfile(@openId.Value);</text> } });
</script>
