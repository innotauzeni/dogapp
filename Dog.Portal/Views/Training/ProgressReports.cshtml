@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Progress Reports";
}
<partial name="_TrainingShared" />
<div class="tr">
    <div class="tr-head">
        <div><h4><i class="bi bi-graph-up-arrow me-2" style="color:#667eea"></i>Weekly Progress Reports</h4><p>Handlers submit a report at the end of every training week; the Training Manager reviews and approves it</p></div>
    </div>

    <div class="tr-filters">
        <div class="tr-field"><label>Status</label>
            <select class="tr-in" id="fStatus"><option value="">All</option><option>Submitted</option><option>Approved</option><option>Returned</option><option>Draft</option></select></div>
    </div>

    <div class="tr-tablewrap"><table class="tr-table">
        <thead><tr><th>Dog</th><th>Customer</th><th>Week</th><th>Handler</th><th>Avg rating</th><th>Status</th><th>Submitted</th><th></th></tr></thead>
        <tbody id="rows"><tr><td colspan="8"><div class="tr-empty">Loading…</div></td></tr></tbody>
    </table></div>
</div>

<script>
(function () {
    var pre = T.qs('status'); if (pre) fStatus.value = pre;
    async function load() {
        var r = await T.api('GET', 'progress-reports' + (fStatus.value ? '?status=' + fStatus.value : ''));
        if (!r.success) { rows.innerHTML = '<tr><td colspan="8"><div class="tr-empty"><i class="bi bi-exclamation-circle"></i>' + T.esc(r.message || 'Could not load.') + '</div></td></tr>'; return; }
        rows.innerHTML = r.data.length === 0 ? '<tr><td colspan="8"><div class="tr-empty"><i class="bi bi-inbox"></i>No reports found.</div></td></tr>' : r.data.map(function (p) {
            return '<tr class="click" onclick="location.href=\'/Training/ProgressReport?enrollmentId=' + p.enrollmentId + '&week=' + p.weekNumber + '\'"><td><b>' + T.esc(p.dogName) + '</b></td><td>' + T.esc(p.customerName || '—') + '</td><td>Week ' + p.weekNumber + '</td><td>' + T.esc(p.handlerName || '—') + '</td><td>' + (p.averageRating != null ? p.averageRating + '/10' : '—') + '</td><td>' + T.resultBadge(p.status) + '</td><td>' + (p.submittedOn ? T.date(p.submittedOn) : '—') + '</td><td><i class="bi bi-chevron-right"></i></td></tr>';
        }).join('');
    }
    fStatus.onchange = load; load();
})();
</script>
