@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register your company";
}

<style>
    /* Wide form — override the auth-layout's 420px cap */
    .auth-form-box { max-width: 560px; }

    .ob-heading {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
        margin: 0 0 .3rem;
    }
    .ob-sub {
        font-size: .875rem;
        color: #64748b;
        margin: 0 0 1.5rem;
    }

    /* Stepper */
    .ob-steps { display:flex; align-items:center; gap:.5rem; margin-bottom:1.75rem; }
    .ob-step { flex:1; position:relative; }
    .ob-step-bar {
        height:4px; border-radius:3px; background:#e2e8f0;
        transition:background .25s ease;
    }
    .ob-step.active .ob-step-bar { background:linear-gradient(90deg,#667eea,#764ba2); }
    .ob-step.done   .ob-step-bar { background:#10b981; }
    .ob-step-label {
        font-size:.72rem; font-weight:700; color:#94a3b8;
        margin-top:.375rem; text-transform:uppercase; letter-spacing:.06em;
        display:flex; align-items:center; gap:.3rem;
    }
    .ob-step.active .ob-step-label { color:#6d28d9; }
    .ob-step.done   .ob-step-label { color:#065f46; }
    .ob-step-label .num {
        display:inline-flex; align-items:center; justify-content:center;
        width:18px; height:18px; border-radius:50%; background:#e2e8f0; color:#64748b;
        font-size:.65rem; font-weight:700;
    }
    .ob-step.active .num { background:#6d28d9; color:#fff; }
    .ob-step.done   .num { background:#10b981; color:#fff; }

    /* Panels */
    .ob-panel { display:none; animation:slideIn .25s cubic-bezier(.16,1,.3,1); }
    .ob-panel.active { display:block; }
    @@keyframes slideIn {
        from { opacity:0; transform:translateY(8px); }
        to   { opacity:1; transform:translateY(0); }
    }

    /* Form fields */
    .ob-row { margin-bottom:1rem; }
    .ob-row label {
        display:block;
        font-size:.8rem; font-weight:600; color:#374151;
        margin-bottom:.375rem;
    }
    .ob-row label .req { color:#ef4444; margin-left:.15rem; }
    .ob-input, .ob-select {
        width:100%; padding:.7rem .875rem;
        border:1.5px solid #e2e8f0; border-radius:10px;
        font-size:.875rem; color:#1e293b; background:#fff;
        outline:none; transition:border-color .2s, box-shadow .2s;
    }
    .ob-input:focus, .ob-select:focus {
        border-color:#667eea;
        box-shadow:0 0 0 3px rgba(102,126,234,.1);
    }
    .ob-input::placeholder { color:#cbd5e1; }
    .ob-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; }
    .ob-row-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:.75rem; }

    .pw-wrap { position:relative; }
    .pw-wrap .ob-input { padding-right:2.5rem; }
    .pw-toggle {
        position:absolute; right:.75rem; top:50%; transform:translateY(-50%);
        background:none; border:none; color:#94a3b8; cursor:pointer; font-size:.9rem;
        padding:0;
    }
    .pw-toggle:hover { color:#64748b; }
    .pw-bar-track { height:4px; border-radius:2px; background:#f1f5f9; margin-top:.4rem; overflow:hidden; }
    .pw-bar { height:100%; width:0; border-radius:2px; transition:width .25s, background .25s; }

    .ob-hint { font-size:.72rem; color:#94a3b8; margin-top:.3rem; }
    .ob-err  { font-size:.72rem; color:#ef4444; margin-top:.3rem; display:none; }
    .ob-err.show { display:block; }

    .ob-alert {
        background:#fef2f2; border:1.5px solid #fecaca; border-radius:10px;
        padding:.75rem 1rem; font-size:.845rem; color:#dc2626;
        display:none; align-items:center; gap:.5rem; margin-bottom:1rem;
    }
    .ob-alert.show { display:flex; }

    /* Actions */
    .ob-actions {
        display:flex; align-items:center; justify-content:space-between;
        gap:.625rem; margin-top:1.5rem;
    }
    .ob-back, .ob-next {
        padding:.75rem 1.25rem; border-radius:10px;
        font-size:.875rem; font-weight:700; cursor:pointer;
        display:inline-flex; align-items:center; gap:.4rem;
        transition:all .2s; border:none;
    }
    .ob-back {
        background:#f1f5f9; color:#64748b;
        border:1.5px solid #e2e8f0;
    }
    .ob-back:hover { background:#e2e8f0; color:#334155; }
    .ob-next {
        background:linear-gradient(135deg,#667eea,#764ba2);
        color:#fff; box-shadow:0 4px 14px rgba(102,126,234,.3);
        min-width:140px; justify-content:center;
    }
    .ob-next:hover:not(:disabled) { transform:translateY(-1px); box-shadow:0 6px 20px rgba(102,126,234,.4); }
    .ob-next:disabled { opacity:.65; cursor:not-allowed; transform:none; }

    .ob-signin {
        font-size:.845rem; text-align:center; margin-top:1.25rem; color:#64748b;
    }
    .ob-signin a { color:#667eea; text-decoration:none; font-weight:600; }
    .ob-signin a:hover { color:#4f46e5; }

    /* Review (step 3) */
    .review-card {
        background:#fafbfc; border:1.5px solid #e9eef4; border-radius:12px;
        padding:1rem 1.125rem; margin-bottom:.875rem;
    }
    .review-card h6 {
        font-size:.72rem; font-weight:700; color:#94a3b8;
        text-transform:uppercase; letter-spacing:.06em;
        margin:0 0 .625rem; display:flex; align-items:center; gap:.4rem;
    }
    .review-card h6 i { color:#667eea; }
    .review-row {
        display:flex; justify-content:space-between; align-items:center;
        padding:.3rem 0; font-size:.835rem;
    }
    .review-row .k { color:#64748b; font-weight:500; }
    .review-row .v { color:#1e293b; font-weight:600; text-align:right; }

    /* Success screen */
    .ob-success { text-align:center; padding:1rem 0; }
    .ob-success .check-circle {
        width:68px; height:68px; border-radius:50%;
        background:linear-gradient(135deg,#10b981,#059669);
        color:#fff; font-size:2rem;
        display:flex; align-items:center; justify-content:center;
        margin:0 auto 1rem;
        box-shadow:0 8px 24px rgba(16,185,129,.35);
        animation:pop .4s cubic-bezier(.16,1.5,.3,1);
    }
    @@keyframes pop {
        from { transform:scale(0); opacity:0; }
        to   { transform:scale(1); opacity:1; }
    }
    .ob-success h4 { font-size:1.3rem; font-weight:800; color:#0f172a; margin:0 0 .4rem; }
    .ob-success p  { font-size:.9rem; color:#64748b; margin:0 0 1.25rem; }
    .ob-success .account-box {
        background:#f0fdf4; border:1.5px solid #bbf7d0; border-radius:10px;
        padding:.875rem 1rem; font-size:.83rem; color:#065f46;
        text-align:left; margin-bottom:1rem;
    }
    .ob-success .account-box strong { color:#064e3b; }

    .spin {
        width:14px; height:14px;
        border:2px solid rgba(255,255,255,.3);
        border-top-color:#fff; border-radius:50%;
        animation:spin .6s linear infinite; flex-shrink:0;
    }
    @@keyframes spin { to { transform:rotate(360deg); } }

    @@media (max-width:576px) {
        .ob-row-2, .ob-row-3 { grid-template-columns:1fr; }
        .auth-form-box { max-width:100% !important; }
    }
</style>

<!-- Heading -->
<div>
    <h1 class="ob-heading">Register your company</h1>
    <p class="ob-sub">Set up your breeding business on Dog Section in just a few steps.</p>
</div>

<!-- Stepper -->
<div class="ob-steps" id="stepper">
    <div class="ob-step active" data-step="1">
        <div class="ob-step-bar"></div>
        <div class="ob-step-label"><span class="num">1</span> Company</div>
    </div>
    <div class="ob-step" data-step="2">
        <div class="ob-step-bar"></div>
        <div class="ob-step-label"><span class="num">2</span> Location</div>
    </div>
    <div class="ob-step" data-step="3">
        <div class="ob-step-bar"></div>
        <div class="ob-step-label"><span class="num">3</span> Admin</div>
    </div>
    <div class="ob-step" data-step="4">
        <div class="ob-step-bar"></div>
        <div class="ob-step-label"><span class="num">4</span> Review</div>
    </div>
</div>

<div class="ob-alert" id="obAlert">
    <i class="bi bi-exclamation-circle-fill"></i>
    <span id="obAlertMsg"></span>
</div>

<!-- Step 1: Company -->
<div class="ob-panel active" data-panel="1">
    <div class="ob-row">
        <label>Company Name <span class="req">*</span></label>
        <input class="ob-input" id="f-companyName" type="text" placeholder="e.g. Tailwagger Kennels" autocomplete="organization" />
        <div class="ob-err" id="e-companyName">Company name is required.</div>
    </div>
    <div class="ob-row-2">
        <div class="ob-row">
            <label>Short Code <span class="req">*</span></label>
            <input class="ob-input" id="f-companyCode" type="text" placeholder="e.g. TWK" maxlength="10" style="text-transform:uppercase;" />
            <div class="ob-hint">2–10 letters; used as a company identifier.</div>
            <div class="ob-err" id="e-companyCode">Code is required.</div>
        </div>
        <div class="ob-row">
            <label>Default Currency <span class="req">*</span></label>
            <select class="ob-select" id="f-currency">
                <option value="">Loading…</option>
            </select>
            <div class="ob-err" id="e-currency">Please pick a currency.</div>
        </div>
    </div>
    <div class="ob-row-2">
        <div class="ob-row">
            <label>Business Email <span class="req">*</span></label>
            <input class="ob-input" id="f-email" type="email" placeholder="info@company.com" />
            <div class="ob-err" id="e-email">Enter a valid email.</div>
        </div>
        <div class="ob-row">
            <label>Phone <span class="req">*</span></label>
            <input class="ob-input" id="f-phone" type="tel" placeholder="+263 77 123 4567" />
            <div class="ob-err" id="e-phone">Phone is required.</div>
        </div>
    </div>
    <div class="ob-row">
        <label>Website</label>
        <input class="ob-input" id="f-website" type="url" placeholder="https://yourcompany.com" />
    </div>

    <div class="ob-actions">
        <a href="/Auth/Login" class="ob-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>
        <button class="ob-next" onclick="goToStep(2)">Next <i class="bi bi-arrow-right"></i></button>
    </div>
</div>

<!-- Step 2: Location -->
<div class="ob-panel" data-panel="2">
    <div class="ob-row-3">
        <div class="ob-row">
            <label>Country <span class="req">*</span></label>
            <select class="ob-select" id="f-country" onchange="onCountryChange(parseInt(this.value) || 0)">
                <option value="">Loading…</option>
            </select>
            <div class="ob-err" id="e-country">Country is required.</div>
        </div>
        <div class="ob-row">
            <label>Province / State <span class="req">*</span></label>
            <select class="ob-select" id="f-province" onchange="onProvinceChange(parseInt(this.value) || 0)">
                <option value="">Select province…</option>
            </select>
            <div class="ob-err" id="e-province">Province is required.</div>
        </div>
        <div class="ob-row">
            <label>City <span class="req">*</span></label>
            <select class="ob-select" id="f-city">
                <option value="">Select city…</option>
            </select>
            <div class="ob-err" id="e-city">City is required.</div>
        </div>
    </div>
    <div class="ob-row">
        <label>Street Address</label>
        <input class="ob-input" id="f-address" type="text" placeholder="123 Main Street, Suburb" />
    </div>

    <div class="ob-actions">
        <button class="ob-back" onclick="goToStep(1)"><i class="bi bi-arrow-left"></i> Back</button>
        <button class="ob-next" onclick="goToStep(3)">Next <i class="bi bi-arrow-right"></i></button>
    </div>
</div>

<!-- Step 3: Admin -->
<div class="ob-panel" data-panel="3">
    <p style="font-size:.83rem;color:#64748b;margin:0 0 1rem;">
        <i class="bi bi-person-gear me-1" style="color:#667eea;"></i>
        The Admin is the first user of your company — they can create staff, branches and other users.
    </p>

    <div class="ob-row-2">
        <div class="ob-row">
            <label>First Name <span class="req">*</span></label>
            <input class="ob-input" id="f-adFirst" type="text" placeholder="John" autocomplete="given-name" />
            <div class="ob-err" id="e-adFirst">First name is required.</div>
        </div>
        <div class="ob-row">
            <label>Last Name <span class="req">*</span></label>
            <input class="ob-input" id="f-adLast" type="text" placeholder="Doe" autocomplete="family-name" />
            <div class="ob-err" id="e-adLast">Last name is required.</div>
        </div>
    </div>

    <div class="ob-row">
        <label>Admin Email <span class="req">*</span></label>
        <input class="ob-input" id="f-adEmail" type="email" placeholder="admin@company.com" autocomplete="email" />
        <div class="ob-hint">You'll sign in with this email.</div>
        <div class="ob-err" id="e-adEmail">Enter a valid admin email.</div>
    </div>

    <div class="ob-row">
        <label>Password <span class="req">*</span></label>
        <div class="pw-wrap">
            <input class="ob-input" id="f-adPw" type="password" placeholder="Minimum 8 characters" autocomplete="new-password" oninput="scorePw()" />
            <button type="button" class="pw-toggle" onclick="togglePw('f-adPw', this)"><i class="bi bi-eye"></i></button>
        </div>
        <div class="pw-bar-track"><div class="pw-bar" id="pwBar"></div></div>
        <div class="ob-err" id="e-adPw">Password must be at least 8 characters.</div>
    </div>

    <div class="ob-actions">
        <button class="ob-back" onclick="goToStep(2)"><i class="bi bi-arrow-left"></i> Back</button>
        <button class="ob-next" onclick="goToStep(4)">Review <i class="bi bi-arrow-right"></i></button>
    </div>
</div>

<!-- Step 4: Review -->
<div class="ob-panel" data-panel="4">
    <div class="review-card">
        <h6><i class="bi bi-building"></i> Company</h6>
        <div class="review-row"><span class="k">Name</span><span class="v" id="r-name"></span></div>
        <div class="review-row"><span class="k">Code</span><span class="v" id="r-code"></span></div>
        <div class="review-row"><span class="k">Email</span><span class="v" id="r-email"></span></div>
        <div class="review-row"><span class="k">Phone</span><span class="v" id="r-phone"></span></div>
        <div class="review-row"><span class="k">Currency</span><span class="v" id="r-currency"></span></div>
    </div>

    <div class="review-card">
        <h6><i class="bi bi-geo-alt-fill"></i> Location</h6>
        <div class="review-row"><span class="k">Country</span><span class="v" id="r-country"></span></div>
        <div class="review-row"><span class="k">Province</span><span class="v" id="r-province"></span></div>
        <div class="review-row"><span class="k">City</span><span class="v" id="r-city"></span></div>
        <div class="review-row"><span class="k">Address</span><span class="v" id="r-address"></span></div>
    </div>

    <div class="review-card">
        <h6><i class="bi bi-person-gear"></i> Admin</h6>
        <div class="review-row"><span class="k">Name</span><span class="v" id="r-adName"></span></div>
        <div class="review-row"><span class="k">Email</span><span class="v" id="r-adEmail"></span></div>
    </div>

    <div class="ob-actions">
        <button class="ob-back" onclick="goToStep(3)"><i class="bi bi-arrow-left"></i> Back</button>
        <button class="ob-next" id="submitBtn" onclick="submitOnboard()">
            <i class="bi bi-check2-circle"></i> Register Company
        </button>
    </div>
</div>

<!-- Step 5: Success -->
<div class="ob-panel" data-panel="5">
    <div class="ob-success">
        <div class="check-circle"><i class="bi bi-check-lg"></i></div>
        <h4>You're all set!</h4>
        <p>Your company has been registered successfully.</p>

        <div class="account-box">
            <strong>Sign in with:</strong><br>
            <span id="s-email" style="font-family:'Consolas','Monaco',monospace;"></span>
        </div>

        <a href="/Auth/Login" class="ob-next" style="text-decoration:none; width:100%; justify-content:center;">
            <i class="bi bi-box-arrow-in-right"></i> Go to Sign In
        </a>
    </div>
</div>

<!-- Sign-in link (hidden on success) -->
<div class="ob-signin" id="signinFooter">
    Already have an account? <a href="/Auth/Login">Sign in</a>
</div>

<script>
    let currentStep = 1;
    const state = {
        countries: [], provinces: [], cities: [], currencies: []
    };

    // ── Init ───────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async () => {
        await Promise.all([loadCountries(), loadCurrencies()]);
    });

    async function loadCountries() {
        const sel = document.getElementById('f-country');
        try {
            const res = await fetch('/Onboard/Countries');
            const data = await res.json();
            state.countries = data.data || [];
            sel.innerHTML = '<option value="">Select country…</option>';
            state.countries.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id; opt.textContent = `${c.code} — ${c.name}`;
                sel.appendChild(opt);
            });
        } catch { sel.innerHTML = '<option value="">Error loading</option>'; }
    }

    async function loadCurrencies() {
        const sel = document.getElementById('f-currency');
        try {
            const res = await fetch('/Onboard/Currencies');
            const data = await res.json();
            state.currencies = data.data || [];
            sel.innerHTML = '<option value="">Select currency…</option>';
            state.currencies.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id; opt.textContent = `${c.code} — ${c.name}`;
                sel.appendChild(opt);
            });
        } catch { sel.innerHTML = '<option value="">Error loading</option>'; }
    }

    async function onCountryChange(countryId) {
        const pSel = document.getElementById('f-province');
        const cSel = document.getElementById('f-city');
        pSel.innerHTML = '<option value="">Loading…</option>';
        cSel.innerHTML = '<option value="">Select city…</option>';
        if (!countryId) { pSel.innerHTML = '<option value="">Select province…</option>'; return; }
        try {
            const res = await fetch(`/Onboard/Provinces/${countryId}`);
            const data = await res.json();
            state.provinces = data.data || [];
            pSel.innerHTML = state.provinces.length
                ? '<option value="">Select province…</option>'
                : '<option value="">No provinces available</option>';
            state.provinces.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id; opt.textContent = p.name;
                pSel.appendChild(opt);
            });
        } catch { pSel.innerHTML = '<option value="">Error loading</option>'; }
    }

    async function onProvinceChange(provinceId) {
        const cSel = document.getElementById('f-city');
        cSel.innerHTML = '<option value="">Loading…</option>';
        if (!provinceId) { cSel.innerHTML = '<option value="">Select city…</option>'; return; }
        try {
            const res = await fetch(`/Onboard/Cities/${provinceId}`);
            const data = await res.json();
            state.cities = data.data || [];
            cSel.innerHTML = state.cities.length
                ? '<option value="">Select city…</option>'
                : '<option value="">No cities available</option>';
            state.cities.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id; opt.textContent = c.name;
                cSel.appendChild(opt);
            });
        } catch { cSel.innerHTML = '<option value="">Error loading</option>'; }
    }

    // ── Validation per step ───────────────────────────────────
    function validateStep(n) {
        clearErrors();
        let ok = true;

        if (n === 1) {
            if (!v('f-companyName')) { showErr('e-companyName'); ok = false; }
            if (!v('f-companyCode')) { showErr('e-companyCode'); ok = false; }
            if (!v('f-currency'))    { showErr('e-currency');    ok = false; }
            if (!isValidEmail(v('f-email'))) { showErr('e-email'); ok = false; }
            if (!v('f-phone'))       { showErr('e-phone');       ok = false; }
        }
        if (n === 2) {
            if (!v('f-country'))  { showErr('e-country');  ok = false; }
            if (!v('f-province')) { showErr('e-province'); ok = false; }
            if (!v('f-city'))     { showErr('e-city');     ok = false; }
        }
        if (n === 3) {
            if (!v('f-adFirst')) { showErr('e-adFirst'); ok = false; }
            if (!v('f-adLast'))  { showErr('e-adLast');  ok = false; }
            if (!isValidEmail(v('f-adEmail'))) { showErr('e-adEmail'); ok = false; }
            if ((v('f-adPw')).length < 8)     { showErr('e-adPw');    ok = false; }
        }
        return ok;
    }

    function v(id) { return (document.getElementById(id).value || '').trim(); }
    function isValidEmail(s) { return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(s); }
    function showErr(id) { document.getElementById(id).classList.add('show'); }
    function clearErrors() { document.querySelectorAll('.ob-err').forEach(e => e.classList.remove('show')); document.getElementById('obAlert').classList.remove('show'); }

    // ── Step navigation ───────────────────────────────────────
    function goToStep(n) {
        if (n > currentStep && !validateStep(currentStep)) return;

        // When moving to review, fill it
        if (n === 4) fillReview();

        currentStep = n;

        document.querySelectorAll('.ob-panel').forEach(p => {
            const step = parseInt(p.dataset.panel);
            p.classList.toggle('active', step === n);
        });
        document.querySelectorAll('.ob-step').forEach(s => {
            const step = parseInt(s.dataset.step);
            s.classList.toggle('active', step === n);
            s.classList.toggle('done', step < n);
        });

        // Hide signin footer on success
        document.getElementById('signinFooter').style.display = (n === 5) ? 'none' : 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function fillReview() {
        document.getElementById('r-name').textContent  = v('f-companyName');
        document.getElementById('r-code').textContent  = v('f-companyCode').toUpperCase();
        document.getElementById('r-email').textContent = v('f-email');
        document.getElementById('r-phone').textContent = v('f-phone');

        const curId = v('f-currency');
        const cur = state.currencies.find(c => c.id == curId);
        document.getElementById('r-currency').textContent = cur ? `${cur.code} — ${cur.name}` : '—';

        const ctId = v('f-country');
        const ct = state.countries.find(c => c.id == ctId);
        document.getElementById('r-country').textContent = ct ? ct.name : '—';

        const pvId = v('f-province');
        const pv = state.provinces.find(p => p.id == pvId);
        document.getElementById('r-province').textContent = pv ? pv.name : '—';

        const ctyId = v('f-city');
        const cty = state.cities.find(c => c.id == ctyId);
        document.getElementById('r-city').textContent = cty ? cty.name : '—';

        document.getElementById('r-address').textContent = v('f-address') || '—';
        document.getElementById('r-adName').textContent = `${v('f-adFirst')} ${v('f-adLast')}`;
        document.getElementById('r-adEmail').textContent = v('f-adEmail');
    }

    // ── Password helpers ──────────────────────────────────────
    function togglePw(id, btn) {
        const inp = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (inp.type === 'password') { inp.type = 'text'; icon.className = 'bi bi-eye-slash'; }
        else                         { inp.type = 'password'; icon.className = 'bi bi-eye'; }
    }
    function scorePw() {
        const val  = document.getElementById('f-adPw').value;
        const bar  = document.getElementById('pwBar');
        let score  = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;
        const colors = ['#ef4444','#f59e0b','#10b981','#059669'];
        const widths = ['25%','50%','75%','100%'];
        bar.style.width     = score > 0 ? widths[score - 1] : '0';
        bar.style.background = score > 0 ? colors[score - 1] : '';
    }

    // ── Submit ────────────────────────────────────────────────
    async function submitOnboard() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spin"></span> Registering…';

        try {
            const payload = {
                company: {
                    companyName:       v('f-companyName'),
                    companyCode:       v('f-companyCode').toUpperCase(),
                    emailAddress:      v('f-email'),
                    phoneNumber:       v('f-phone'),
                    website:           v('f-website') || null,
                    address:           v('f-address') || null,
                    countryId:         parseInt(v('f-country'))   || 0,
                    provinceId:        parseInt(v('f-province'))  || 0,
                    cityId:            parseInt(v('f-city'))      || 0,
                    defaultCurrencyId: parseInt(v('f-currency'))  || 0
                },
                admin: {
                    firstName: v('f-adFirst'),
                    lastName:  v('f-adLast'),
                    email:     v('f-adEmail'),
                    password:  document.getElementById('f-adPw').value
                }
            };

            const res  = await fetch('/Onboard/Register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
                document.getElementById('s-email').textContent = v('f-adEmail');
                goToStep(5);
            } else {
                showAlert(data.message || 'Registration failed. Please review your details.');
            }
        } catch (err) {
            showAlert('Network error: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Register Company';
        }
    }

    function showAlert(msg) {
        const el = document.getElementById('obAlert');
        document.getElementById('obAlertMsg').textContent = msg;
        el.classList.add('show');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>
