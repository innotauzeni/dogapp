
@model Dog.Portal.Models.AuditsListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Audit Trail";
    var totalAll = Model.TotalCount;
    var entities = ViewBag.Entities as List<string> ?? new List<string>();
    var creates = Model.AuditList.Count(a => a.ActionKind == "create");
    var updates = Model.AuditList.Count(a => a.ActionKind == "update");
    var deletes = Model.AuditList.Count(a => a.ActionKind == "delete");
}
<style>
.page-hdr h4{font-size:1.15rem;font-weight:800;color:#0f172a;margin:0 0 .25rem}
.page-hdr p{font-size:.845rem;color:#64748b;margin:0}
.page-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.total-chip{display:inline-flex;align-items:center;gap:.375rem;background:#ede9fe;color:#6d28d9;font-size:.8rem;font-weight:700;padding:.35rem .875rem;border-radius:20px}
.hdr-actions{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:.875rem;margin-bottom:1.5rem}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e9eef4;padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem}
.stat-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.si-total{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#7c3aed}
.si-create{background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46}
.si-update{background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e}
.si-delete{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b}
.si-entity{background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1d4ed8}
.stat-body .val{font-size:1.35rem;font-weight:800;color:#0f172a;line-height:1}
.stat-body .lbl{font-size:.75rem;color:#94a3b8;font-weight:500;margin-top:.2rem}
.dc{background:#fff;border-radius:14px;border:1px solid #e9eef4;overflow:hidden}
.dc-head{padding:1rem 1.375rem;border-bottom:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
.srch-wrap{position:relative;flex:1;min-width:180px;max-width:260px}
.srch-wrap i{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none}
.srch-input{width:100%;padding:.6rem .875rem .6rem 2.375rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#1e293b;background:#fff;outline:none}
.srch-input:focus{border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
.filter-sel{padding:.6rem .875rem;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;color:#374151;background:#fff;outline:none;cursor:pointer;min-width:120px}
.filter-sel:focus{border-color:#667eea}
.btn-srch{padding:.6rem 1.125rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:9px;font-size:.845rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.375rem}
.btn-clr{padding:.6rem .875rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.845rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem}
.btn-clr:hover{background:#e2e8f0}
.tbl-wrap{overflow-x:auto;min-height:300px}
.dt{width:100%;border-collapse:collapse;table-layout:fixed}
.dt thead th{padding:.75rem 1.125rem;font-size:.7rem;font-weight:700;color:#64748b;text-transform:uppercase;background:#f8fafc;border-bottom:1px solid #f0f4f8;white-space:nowrap}
.dt tbody td{padding:.875rem 1.125rem;font-size:.855rem;color:#374151;border-bottom:1px solid #f8fafc;vertical-align:middle;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dt tbody tr:hover td{background:#fafbff}
.rn{color:#cbd5e1;font-size:.8rem;font-weight:600}
.action-badge{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:700;padding:.25rem .65rem;border-radius:20px}
.action-create{background:#d1fae5;color:#065f46}
.action-update{background:#fef3c7;color:#92400e}
.action-delete{background:#fee2e2;color:#991b1b}
.action-other{background:#f3f4f6;color:#374151}
.changes-pill{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:600;padding:.2rem .55rem;border-radius:12px;background:#ede9fe;color:#6d28d9;cursor:pointer;border:none}
.changes-pill:hover{background:#ddd6fe}
.act-wrap{position:relative;display:inline-block}
.act-btn{width:32px;height:32px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s}
.act-btn:hover{background:#f8fafc;border-color:#cbd5e1;color:#334155}
.act-menu{position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:11px;box-shadow:0 12px 40px rgba(0,0,0,.18);min-width:180px;z-index:1045;padding:.375rem;display:none}
.act-menu.open{display:block}
.act-item{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:7px;font-size:.835rem;font-weight:500;color:#374151;cursor:pointer;border:none;background:none;width:100%;text-align:left}
.act-item:hover{background:#f8fafc}
.act-item i{width:16px;text-align:center}
.dc-foot{padding:.9rem 1.375rem;border-top:1px solid #f1f5f9;background:#fafbfc;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem}
.ri{font-size:.82rem;color:#94a3b8}
.ri strong{color:#374151}
.pgn{display:flex;align-items:center;gap:.25rem}
.pb{display:flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 .5rem;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.8rem;color:#64748b;text-decoration:none;background:#fff}
.pb:hover{background:#f8fafc}
.pb.cur{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-color:transparent;font-weight:700}
.pb.off{opacity:.35;pointer-events:none}
.pb.wide{padding:0 .875rem}
.empty-state{text-align:center;padding:3rem 1rem;color:#94a3b8}
.empty-state i{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;display:block}
.empty-state h3{font-size:1.1rem;font-weight:600;color:#64748b;margin-bottom:.5rem}
.modal-backdrop-custom{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:1050;display:none;align-items:center;justify-content:center;padding:1rem}
.modal-backdrop-custom.open{display:flex}
.modal-box{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:820px;max-height:90vh;overflow-y:auto;animation:mslide .22s ease}
@@keyframes mslide{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9}
.modal-hdr h5{font-size:1rem;font-weight:800;color:#0f172a;margin:0;display:flex;align-items:center;gap:.5rem}
.modal-close{width:30px;height:30px;border:none;background:#f1f5f9;border-radius:7px;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.modal-close:hover{background:#e2e8f0}
.modal-body-p{padding:1.375rem 1.5rem}
.modal-foot{padding:1rem 1.5rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:flex-end;gap:.625rem}
.btn-cancel{padding:.65rem 1.25rem;background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;border-radius:9px;font-size:.855rem;font-weight:600;cursor:pointer}
.btn-cancel:hover{background:#e2e8f0}
.meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.25rem}
.meta-item{background:#f8fafc;border-radius:8px;padding:.75rem 1rem}
.meta-item .lbl{font-size:.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;margin-bottom:.25rem}
.meta-item .val{font-size:.875rem;color:#1e293b;font-weight:600}
.changes-title{font-size:.85rem;font-weight:700;color:#374151;margin-bottom:.75rem;display:flex;align-items:center;gap:.4rem;padding-bottom:.5rem;border-bottom:1px solid #f1f5f9}
.change-row{display:grid;grid-template-columns:140px 1fr;gap:.75rem;padding:.6rem .75rem;border-radius:8px;margin-bottom:.375rem;align-items:start}
.change-row:nth-child(odd){background:#f8fafc}
.change-row:nth-child(even){background:#fff;border:1px solid #f1f5f9}
.change-field{font-weight:700;color:#374151;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;padding-top:.2rem}
.change-val{color:#1e293b;background:#f1f5f9;padding:.3rem .6rem;border-radius:5px;font-family:monospace;font-size:.8rem;word-break:break-all;white-space:pre-wrap}
.json-block{background:#0f172a;color:#e2e8f0;border-radius:10px;padding:1rem 1.25rem;font-family:monospace;font-size:.78rem;line-height:1.7;overflow-x:auto;max-height:420px;overflow-y:auto;white-space:pre}
.toast-wrap{position:fixed;bottom:1.75rem;right:1.75rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast-msg{display:flex;align-items:center;gap:.625rem;padding:.875rem 1.25rem;border-radius:12px;font-size:.855rem;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.15);pointer-events:all;transform:translateX(120%);transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:320px}
.toast-msg.show{transform:translateX(0)}
.toast-success{background:#065f46;color:#fff}
.toast-error{background:#991b1b;color:#fff}
</style>
<div class="toast-wrap" id="toastWrap"></div>
@if (ViewBag.FetchError != null) {
    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:.875rem 1.125rem;color:#dc2626;font-size:.845rem;display:flex;align-items:center;gap:.625rem;margin-bottom:1.25rem">
        <i class="bi bi-exclamation-circle-fill"></i> @ViewBag.FetchError
    </div>
}
<div class="page-hdr-row">
  <div class="page-hdr"><h4><i class="bi bi-clock-history me-2" style="color:#667eea"></i>Audit Trail</h4><p>Track all system changes and user activities</p></div>
  <div class="hdr-actions"><span class="total-chip"><i class="bi bi-clock-history"></i> @totalAll Total</span></div>
</div>
<div class="stats-row">
  <div class="stat-card"><div class="stat-icon si-total"><i class="bi bi-clock-history"></i></div><div class="stat-body"><div class="val">@totalAll</div><div class="lbl">Total Entries</div></div></div>
  <div class="stat-card"><div class="stat-icon si-create"><i class="bi bi-plus-circle"></i></div><div class="stat-body"><div class="val">@creates</div><div class="lbl">Creates</div></div></div>
  <div class="stat-card"><div class="stat-icon si-update"><i class="bi bi-pencil"></i></div><div class="stat-body"><div class="val">@updates</div><div class="lbl">Updates</div></div></div>
  <div class="stat-card"><div class="stat-icon si-delete"><i class="bi bi-trash3"></i></div><div class="stat-body"><div class="val">@deletes</div><div class="lbl">Deletes</div></div></div>
  <div class="stat-card"><div class="stat-icon si-entity"><i class="bi bi-database"></i></div><div class="stat-body"><div class="val">@entities.Count</div><div class="lbl">Entities</div></div></div>
</div>
<div class="dc">
  <div class="dc-head">
    <form method="get" style="display:contents">
      <div class="srch-wrap"><i class="bi bi-search"></i><input type="text" name="search" value="@Model.SearchTerm" class="srch-input" placeholder="Search entries..."></div>
      <select name="entity" class="filter-sel">
        <option value="">All Entities</option>
        @foreach (var e in entities) {
          if (ViewBag.EntityFilter == e) { <option value="@e" selected>@e</option> }
          else { <option value="@e">@e</option> }
        }
      </select>
      <select name="actionType" class="filter-sel">
        <option value="">All Actions</option>
        @if (ViewBag.ActionFilter == "Create") { <option value="Create" selected>Create</option> } else { <option value="Create">Create</option> }
        @if (ViewBag.ActionFilter == "Update") { <option value="Update" selected>Update</option> } else { <option value="Update">Update</option> }
        @if (ViewBag.ActionFilter == "Delete") { <option value="Delete" selected>Delete</option> } else { <option value="Delete">Delete</option> }
      </select>
      <input type="text" name="username" value="@ViewBag.UsernameFilter" class="filter-sel" placeholder="Username..." style="min-width:140px">
      <button type="submit" class="btn-srch"><i class="bi bi-funnel-fill"></i> Filter</button>
      @if (!string.IsNullOrEmpty(Model.SearchTerm) || ViewBag.EntityFilter != null || ViewBag.ActionFilter != null || ViewBag.UsernameFilter != null) {
        <a href="@Url.Action("Index")" class="btn-clr"><i class="bi bi-x"></i> Clear</a>
      }
    </form>
  </div>
  <div class="tbl-wrap">
    @if (Model.AuditList.Count > 0) {
      <table class="dt">
        <thead><tr>
          <th style="width:50px">#</th>
          <th style="width:140px">Entity</th>
          <th style="width:100px">Action</th>
          <th style="width:140px">User</th>
          <th style="width:90px">Entity ID</th>
          <th style="width:110px">Changes</th>
          <th style="width:160px">Timestamp</th>
          <th style="width:70px;text-align:center">View</th>
        </tr></thead>
        <tbody>
          @{ var si = (Model.Page - 1) * Model.PageSize; }
          @for (int i = 0; i < Model.AuditList.Count; i++) {
            var item = Model.AuditList[i];
            var atype = item.ActionKind;
            var actionClass = atype == "create" ? "action-create" : atype == "update" ? "action-update" : atype == "delete" ? "action-delete" : "action-other";
            var actionIcon = atype == "create" ? "bi-plus-circle" : atype == "update" ? "bi-pencil" : atype == "delete" ? "bi-trash3" : "bi-gear";
            var changesCount = item.ChangesCount;
            var changesJson = item.ChangesJson;
            <tr>
              <td><span class="rn">@(si+i+1)</span></td>
              <td title="@item.EntityName"><div style="font-weight:600;color:#1e293b">@item.EntityName</div></td>
              <td><span class="action-badge @actionClass"><i class="bi @actionIcon"></i> @item.ActionLabel</span></td>
              <td title="@item.Username"><div style="font-weight:500">@item.Username</div>@if (!string.IsNullOrEmpty(item.Actor?.Role)) {<div style="font-size:.72rem;color:#94a3b8">@item.Actor.Role</div>}</td>
              <td><div style="font-family:monospace;font-size:.78rem;color:#64748b">@item.EntityId</div></td>
              <td>
                @if (changesCount > 0) {
                  <button class="changes-pill"
                          data-changes="@Html.Encode(changesJson)"
                          onclick="openChangesFromBtn(this)">
                    <i class="bi bi-list-check"></i> @changesCount field@(changesCount != 1 ? "s" : "")
                  </button>
                } else {
                  <span style="font-size:.78rem;color:#cbd5e1">—</span>
                }
              </td>
              <td>
                <div style="font-size:.8rem;color:#64748b">@item.TimeStamp.ToString("MMM dd, yyyy")</div>
                <div style="font-size:.75rem;color:#94a3b8">@item.TimeStamp.ToString("HH:mm:ss")</div>
              </td>
              <td style="text-align:center">
                <div class="act-wrap">
                  <button class="act-btn" onclick="toggleActMenu(this)" title="Actions"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu"
                       data-id="@item.Id"
                       data-entity="@item.EntityName"
                       data-action="@item.ActionLabel"
                       data-user="@item.Username"
                       data-entityid="@item.EntityId"
                       data-timestamp="@item.TimeStamp.ToString("MMM dd, yyyy HH:mm:ss")"
                       data-changes="@Html.Encode(changesJson)"
                       data-previous="@Html.Encode(item.PreviousJson)"
                       data-actor="@Html.Encode(item.ActorJson)">
                    <button class="act-item" onclick="openDetails(this.closest('.act-menu'))"><i class="bi bi-eye" style="color:#667eea"></i> View Details</button>
                  </div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    } else {
      <div class="empty-state"><i class="bi bi-clock-history"></i><h3>No audit entries found</h3><p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "No audit trail entries to display." : "Try adjusting your search criteria.")</p></div>
    }
  </div>
  @if (Model.TotalCount > 0) {
    <div class="dc-foot">
      <div class="ri">Showing <strong>@Model.From</strong>-<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong></div>
      @if (Model.TotalPages > 1) {
        <div class="pgn">
          @if (Model.Page > 1) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, entity=ViewBag.EntityFilter, actionType=ViewBag.ActionFilter, username=ViewBag.UsernameFilter, page=Model.Page-1 })" class="pb wide"><i class="bi bi-chevron-left"></i> Prev</a> }
          else { <span class="pb wide off"><i class="bi bi-chevron-left"></i> Prev</span> }
          @for (int p = Math.Max(1,Model.Page-2); p <= Math.Min(Model.TotalPages,Model.Page+2); p++) {
            if (p==Model.Page) { <span class="pb cur">@p</span> }
            else { <a href="@Url.Action("Index", new { search=Model.SearchTerm, entity=ViewBag.EntityFilter, actionType=ViewBag.ActionFilter, username=ViewBag.UsernameFilter, page=p })" class="pb">@p</a> }
          }
          @if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { search=Model.SearchTerm, entity=ViewBag.EntityFilter, actionType=ViewBag.ActionFilter, username=ViewBag.UsernameFilter, page=Model.Page+1 })" class="pb wide">Next <i class="bi bi-chevron-right"></i></a> }
          else { <span class="pb wide off">Next <i class="bi bi-chevron-right"></i></span> }
        </div>
      }
    </div>
  }
</div>

<!-- DETAILS MODAL -->
<style>
.perf-card{border:1px solid #e0e7ff;background:linear-gradient(135deg,#f5f7ff,#faf5ff);border-radius:12px;padding:1rem 1.1rem;margin-bottom:1.1rem}
.perf-top{display:flex;align-items:center;gap:.8rem;margin-bottom:.8rem}
.perf-avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;flex-shrink:0}
.perf-name{font-weight:800;color:#0f172a;font-size:.98rem}
.perf-role{font-size:.78rem;color:#6d28d9;font-weight:600}
.perf-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem .9rem}
.perf-grid .pi .lbl{font-size:.68rem;color:#94a3b8;font-weight:700;text-transform:uppercase}
.perf-grid .pi .val{font-size:.84rem;color:#1e293b;font-weight:600;word-break:break-word}
.banner{border-radius:10px;padding:.7rem .95rem;font-size:.84rem;font-weight:600;margin-bottom:1rem;display:flex;align-items:center;gap:.55rem}
.banner-del{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.banner-new{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
.banner-upd{background:#fffbeb;border:1px solid #fde68a;color:#92400e}
.banner-info{background:#f1f5f9;border:1px solid #e2e8f0;color:#475569}
.dtbl{width:100%;border-collapse:collapse;font-size:.82rem;margin-bottom:.5rem}
.dtbl th{background:#f8fafc;color:#64748b;font-size:.68rem;text-transform:uppercase;text-align:left;padding:.5rem .65rem;border-bottom:1px solid #e2e8f0;position:sticky;top:0}
.dtbl td{padding:.45rem .65rem;border-bottom:1px solid #f1f5f9;vertical-align:top;word-break:break-word}
.dtbl td.f{font-weight:700;color:#374151;width:24%;font-size:.76rem}
.dtbl td.v{font-family:monospace;font-size:.78rem;color:#1e293b}
.dtbl tr.chg td{background:#fffbeb}
.dtbl tr.chg td.old{background:#fef2f2;color:#991b1b;text-decoration:line-through;text-decoration-color:#fca5a5}
.dtbl tr.chg td.new{background:#ecfdf5;color:#065f46;font-weight:700}
.dtbl tr.noise td{color:#94a3b8}
.dtbl-wrap{max-height:48vh;overflow:auto;border:1px solid #f1f5f9;border-radius:10px}
.nullv{color:#94a3b8;font-style:italic}
.tog{font-size:.78rem;color:#667eea;font-weight:600;cursor:pointer;margin:.2rem 0 .6rem;display:inline-flex;align-items:center;gap:.3rem;background:none;border:none;padding:0}
</style>
<div class="modal-backdrop-custom" id="detailsModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h5><i class="bi bi-clock-history" style="color:#667eea"></i> Audit Details</h5>
      <button class="modal-close" onclick="closeModal('detailsModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body-p">
      <div id="d_banner"></div>

      <div class="changes-title"><i class="bi bi-person-badge-fill" style="color:#667eea"></i> Performed By</div>
      <div class="perf-card" id="d_performer"></div>

      <div class="meta-grid">
        <div class="meta-item"><div class="lbl">Entity</div><div class="val" id="d_entity"></div></div>
        <div class="meta-item"><div class="lbl">Action</div><div class="val" id="d_action"></div></div>
        <div class="meta-item"><div class="lbl">Entity ID</div><div class="val" id="d_entityid" style="font-family:monospace"></div></div>
        <div class="meta-item"><div class="lbl">Timestamp</div><div class="val" id="d_timestamp"></div></div>
      </div>

      <div id="d_changesSection" style="display:none">
        <div class="changes-title"><i class="bi bi-list-check" style="color:#667eea"></i> <span id="d_tableTitle">Record</span> <span id="d_changesCount" style="background:#ede9fe;color:#6d28d9;font-size:.72rem;padding:.15rem .5rem;border-radius:10px;margin-left:.25rem"></span></div>
        <button class="tog" id="d_toggleUnchanged" style="display:none" onclick="toggleUnchanged()"><i class="bi bi-eye"></i> <span>Show unchanged fields</span></button>
        <div class="dtbl-wrap"><div id="d_changesRows"></div></div>
        <div style="margin-top:1rem">
          <div class="changes-title" style="cursor:pointer" onclick="toggleRaw()"><i class="bi bi-code-slash" style="color:#667eea"></i> Raw JSON <i class="bi bi-chevron-down" id="rawChevron" style="font-size:.7rem;margin-left:.25rem"></i></div>
          <div id="d_rawJson" style="display:none"></div>
        </div>
      </div>
      <div id="d_noChanges" style="display:none;text-align:center;padding:1.5rem;color:#94a3b8;font-size:.875rem">
        <i class="bi bi-info-circle" style="font-size:1.5rem;display:block;margin-bottom:.5rem;color:#cbd5e1"></i>
        No field data recorded for this entry.
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal('detailsModal')">Close</button>
    </div>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.modal-backdrop-custom').forEach(function(bd){bd.addEventListener('click',function(e){if(e.target===bd)closeModal(bd.id);});});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop-custom.open').forEach(function(m){closeModal(m.id);});}});

function toggleActMenu(btn){var menu=btn.nextElementSibling;var isOpen=menu.classList.contains('open');closeAllActMenus();if(!isOpen){positionActMenu(btn,menu);menu.classList.add('open');}}
function closeAllActMenus(){document.querySelectorAll('.act-menu.open').forEach(function(m){m.classList.remove('open');m.style.top='';m.style.left='';m.style.right='';});}
function positionActMenu(btn,menu){menu.style.visibility='hidden';menu.style.display='block';var mr=menu.getBoundingClientRect();menu.style.display='';menu.style.visibility='';var br=btn.getBoundingClientRect();var right=window.innerWidth-br.right;if(right<8)right=8;var top=br.bottom+4;if(top+mr.height>window.innerHeight-8){var up=br.top-mr.height-4;top=up>=8?up:Math.max(8,window.innerHeight-mr.height-8);}menu.style.top=top+'px';menu.style.right=right+'px';menu.style.left='auto';}
document.addEventListener('click',function(e){if(!e.target.closest('.act-wrap'))closeAllActMenus();});
window.addEventListener('scroll',closeAllActMenus,true);
window.addEventListener('resize',closeAllActMenus);

// Clicking the "N fields" pill opens the same full details as the menu.
function openChangesFromBtn(btn){
    var menu = btn.closest('tr').querySelector('.act-menu');
    if (menu) openDetails(menu);
}

function openDetails(menu){
    closeAllActMenus();
    showDetails(menu.dataset);
}

function parseJson(s){ try { return s && s !== 'null' ? JSON.parse(s) : null; } catch(e) { return null; } }
function escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function fmtVal(v){
    if (v === null || v === undefined) return '<span class="nullv">null</span>';
    if (v === '') return '<span class="nullv">(empty)</span>';
    if (typeof v === 'object') return escHtml(JSON.stringify(v));
    return escHtml(String(v));
}
function sameVal(a, b){ return JSON.stringify(a === undefined ? null : a) === JSON.stringify(b === undefined ? null : b); }
var NOISE = {UpdatedAt:1, UpdatedBy:1, DeletedAt:1, DeletedBy:1};
var showUnchanged = false;

function initials(name){
    var p = (name || '?').trim().split(/\s+/);
    return ((p[0]||'?')[0] + (p.length > 1 ? p[p.length-1][0] : '')).toUpperCase();
}
function shortAgent(ua){
    if(!ua) return '';
    var b = /Edg\//.test(ua) ? 'Edge' : /OPR\/|Opera/.test(ua) ? 'Opera' : /Chrome\//.test(ua) ? 'Chrome' : /Firefox\//.test(ua) ? 'Firefox' : /Safari\//.test(ua) ? 'Safari' : /okhttp|Dart|Flutter/i.test(ua) ? 'Mobile app' : ua.substring(0, 40);
    var o = /Windows/.test(ua) ? 'Windows' : /Android/.test(ua) ? 'Android' : /iPhone|iPad|iOS/.test(ua) ? 'iOS' : /Mac OS/.test(ua) ? 'macOS' : /Linux/.test(ua) ? 'Linux' : '';
    return o ? b + ' on ' + o : b;
}

function renderPerformer(actor, userFallback){
    var a = actor || {};
    var name = a.fullName || userFallback || 'Unknown';
    var items = [
        ['Email', a.email], ['Phone', a.phone], ['Company', a.companyName],
        ['IP Address', a.ipAddress], ['Device', shortAgent(a.userAgent)],
        ['Request', (a.method && a.path) ? a.method + ' ' + a.path : (a.path || '')],
        ['User ID', a.userId]
    ].filter(function(x){ return x[1]; });
    var html = '<div class="perf-top"><div class="perf-avatar">' + escHtml(initials(name)) + '</div>'
        + '<div><div class="perf-name">' + escHtml(name) + '</div>'
        + (a.role ? '<div class="perf-role">' + escHtml(a.role) + '</div>' : '') + '</div></div>';
    if (items.length) {
        html += '<div class="perf-grid">' + items.map(function(x){
            return '<div class="pi"><div class="lbl">' + escHtml(x[0]) + '</div><div class="val"' + (x[0]==='User ID'||x[0]==='IP Address' ? ' style="font-family:monospace;font-size:.78rem"' : '') + '>' + escHtml(x[1]) + '</div></div>';
        }).join('') + '</div>';
    } else {
        html += '<div style="font-size:.8rem;color:#94a3b8">No further details were recorded for this entry.</div>';
    }
    document.getElementById('d_performer').innerHTML = html;
}

function showDetails(d){
    var action = (d.action || '').toLowerCase();
    var current = parseJson(d.changes);
    var previous = parseJson(d.previous);
    var actor = parseJson(d.actor);

    document.getElementById('d_entity').textContent = d.entity || '—';
    document.getElementById('d_action').textContent = d.action || '—';
    document.getElementById('d_entityid').textContent = d.entityid || '—';
    document.getElementById('d_timestamp').textContent = d.timestamp || '—';
    renderPerformer(actor, d.user);

    var banner = document.getElementById('d_banner');
    var section = document.getElementById('d_changesSection');
    var noChanges = document.getElementById('d_noChanges');
    var rows = document.getElementById('d_changesRows');
    var rawEl = document.getElementById('d_rawJson');
    var countEl = document.getElementById('d_changesCount');
    var toggleBtn = document.getElementById('d_toggleUnchanged');
    var titleEl = document.getElementById('d_tableTitle');
    showUnchanged = false;

    if (!current || Object.keys(current).length === 0) {
        banner.innerHTML = '';
        section.style.display = 'none';
        noChanges.style.display = 'block';
        openModal('detailsModal');
        return;
    }

    var keys = Object.keys(current);
    var html = '';
    var changedCount = 0;

    if (action === 'update' && previous) {
        // Previous vs New, side by side — changed fields highlighted and listed first.
        var changed = [], same = [];
        keys.forEach(function(k){ (sameVal(previous[k], current[k]) ? same : changed).push(k); });
        var real = changed.filter(function(k){ return !NOISE[k]; });
        changedCount = real.length;
        banner.innerHTML = '<div class="banner banner-upd"><i class="bi bi-pencil-fill"></i> This record was updated. ' + real.length + ' field' + (real.length !== 1 ? 's' : '') + ' changed — the previous value is shown beside the new one.</div>';
        titleEl.textContent = 'Previous vs New';
        html = '<table class="dtbl"><thead><tr><th>Field</th><th>Previous value</th><th>New value</th></tr></thead><tbody>';
        real.forEach(function(k){ html += '<tr class="chg"><td class="f">' + escHtml(k) + '</td><td class="v old">' + fmtVal(previous[k]) + '</td><td class="v new">' + fmtVal(current[k]) + '</td></tr>'; });
        changed.filter(function(k){ return NOISE[k]; }).forEach(function(k){ html += '<tr class="noise"><td class="f">' + escHtml(k) + '</td><td class="v">' + fmtVal(previous[k]) + '</td><td class="v">' + fmtVal(current[k]) + '</td></tr>'; });
        same.forEach(function(k){ html += '<tr class="unch" style="display:none"><td class="f">' + escHtml(k) + '</td><td class="v">' + fmtVal(previous[k]) + '</td><td class="v">' + fmtVal(current[k]) + '</td></tr>'; });
        html += '</tbody></table>';
        toggleBtn.style.display = same.length ? 'inline-flex' : 'none';
        toggleBtn.querySelector('span').textContent = 'Show ' + same.length + ' unchanged field' + (same.length !== 1 ? 's' : '');
        toggleBtn.querySelector('i').className = 'bi bi-eye';
    } else {
        toggleBtn.style.display = 'none';
        changedCount = keys.length;
        if (action === 'delete') {
            banner.innerHTML = '<div class="banner banner-del"><i class="bi bi-trash3-fill"></i> This record was deleted. Below is the full record as it was when it was deleted.</div>';
            titleEl.textContent = 'Deleted record';
        } else if (action === 'create') {
            banner.innerHTML = '<div class="banner banner-new"><i class="bi bi-plus-circle-fill"></i> This record was created. Below is everything that was saved.</div>';
            titleEl.textContent = 'New record';
        } else {
            banner.innerHTML = action === 'update'
                ? '<div class="banner banner-info"><i class="bi bi-info-circle-fill"></i> Previous values were not recorded for this older entry — only the values after the update are available.</div>'
                : '';
            titleEl.textContent = 'Record';
        }
        html = '<table class="dtbl"><thead><tr><th>Field</th><th>Value</th></tr></thead><tbody>';
        keys.forEach(function(k){ html += '<tr class="' + (NOISE[k] ? 'noise' : '') + '"><td class="f">' + escHtml(k) + '</td><td class="v">' + fmtVal(current[k]) + '</td></tr>'; });
        html += '</tbody></table>';
    }

    countEl.textContent = changedCount + ' field' + (changedCount !== 1 ? 's' : '');
    rows.innerHTML = html;

    var raw = (action === 'update' && previous) ? {previous: previous, current: current} : current;
    rawEl.innerHTML = '<div class="json-block">' + escHtml(JSON.stringify(raw, null, 2)) + '</div>';
    rawEl.style.display = 'none';
    document.getElementById('rawChevron').className = 'bi bi-chevron-down';
    section.style.display = 'block';
    noChanges.style.display = 'none';
    openModal('detailsModal');
}

function toggleUnchanged(){
    showUnchanged = !showUnchanged;
    document.querySelectorAll('#d_changesRows tr.unch').forEach(function(tr){ tr.style.display = showUnchanged ? '' : 'none'; });
    var btn = document.getElementById('d_toggleUnchanged');
    var n = document.querySelectorAll('#d_changesRows tr.unch').length;
    btn.querySelector('span').textContent = showUnchanged ? 'Hide unchanged fields' : 'Show ' + n + ' unchanged field' + (n !== 1 ? 's' : '');
    btn.querySelector('i').className = showUnchanged ? 'bi bi-eye-slash' : 'bi bi-eye';
}

function toggleRaw(){
    var el = document.getElementById('d_rawJson');
    var ch = document.getElementById('rawChevron');
    if(el.style.display === 'none'){el.style.display='block';ch.className='bi bi-chevron-up';}
    else{el.style.display='none';ch.className='bi bi-chevron-down';}
}
</script>
