@model Dog.Portal.Models.CompanyDetailViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Company.CompanyName ?? "Company";
    var c = Model.Company;
    var av = c.CompanyName?.Length > 0 ? c.CompanyName[0].ToString().ToUpper() : "C";
}

<style>
    .bcrumb { display:flex; align-items:center; gap:.375rem; font-size:.8rem; color:#94a3b8; margin-bottom:1.25rem; flex-wrap:wrap; }
    .bcrumb a { color:#667eea; text-decoration:none; font-weight:500; }
    .bcrumb a:hover { color:#4f46e5; }
    .bcrumb .sep { color:#e2e8f0; }
    .bcrumb .cur { color:#374151; font-weight:600; }

    /* Hero card */
    .co-hero { background:#fff; border-radius:16px; border:1px solid #e9eef4; box-shadow:0 1px 4px rgba(0,0,0,.04),0 8px 24px rgba(0,0,0,.05); overflow:hidden; margin-bottom:1.5rem; }
    .co-hero-top { background:linear-gradient(135deg,#667eea 0%,#764ba2 100%); padding:1.75rem 2rem; display:flex; align-items:center; gap:1.375rem; flex-wrap:wrap; position:relative; overflow:hidden; }
    .co-hero-top::before { content:''; position:absolute; width:200px; height:200px; background:rgba(255,255,255,.07); border-radius:50%; top:-80px; right:-60px; }
    .co-hero-av { width:64px; height:64px; border-radius:16px; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.75rem; font-weight:900; flex-shrink:0; position:relative; z-index:1; backdrop-filter:blur(4px); border:2px solid rgba(255,255,255,.3); }
    .co-hero-title { position:relative; z-index:1; }
    .co-hero-title h4 { color:#fff; font-size:1.25rem; font-weight:800; margin:0 0 .35rem; }
    .co-hero-title .code { background:rgba(255,255,255,.2); color:#fff; font-size:.78rem; font-weight:700; padding:.2rem .6rem; border-radius:6px; font-family:monospace; display:inline-block; }
    .co-hero-right { margin-left:auto; position:relative; z-index:1; }

    .s-on  { background:#d1fae5; color:#065f46; font-size:.74rem; font-weight:600; padding:.3rem .75rem; border-radius:20px; display:inline-flex; align-items:center; gap:.3rem; }
    .s-off { background:#fee2e2; color:#991b1b; font-size:.74rem; font-weight:600; padding:.3rem .75rem; border-radius:20px; display:inline-flex; align-items:center; gap:.3rem; }

    /* Info grid */
    .co-hero-body { padding:1.375rem 2rem; }
    .info-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1.125rem; }
    .info-item { }
    .info-lbl  { font-size:.72rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.07em; margin-bottom:.25rem; }
    .info-val  { font-size:.875rem; font-weight:600; color:#1e293b; }
    .info-val.light { font-weight:400; color:#374151; }
    .info-val a { color:#667eea; text-decoration:none; }
    .info-val a:hover { text-decoration:underline; }

    /* Stat row */
    .stat-row { display:flex; align-items:center; gap:.875rem; padding:1rem 2rem; border-top:1px solid #f1f5f9; background:#fafbfc; flex-wrap:wrap; }
    .stat-item { display:flex; align-items:center; gap:.5rem; }
    .stat-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:.9rem; }
    .stat-text strong { display:block; font-size:1.1rem; font-weight:800; color:#0f172a; line-height:1; }
    .stat-text span   { font-size:.74rem; color:#94a3b8; font-weight:500; }

    /* Data card */
    .dc { background:#fff; border-radius:14px; border:1px solid #e9eef4; box-shadow:0 1px 4px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.04); overflow:hidden; }
    .dc-head { padding:1rem 1.375rem; border-bottom:1px solid #f1f5f9; background:#fafbfc; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .dc-title { font-size:.9rem; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:.5rem; }
    .dc-title i { color:#667eea; }
    .cc-lrg { display:inline-flex; align-items:center; gap:.375rem; background:#ede9fe; color:#6d28d9; font-size:.8rem; font-weight:700; padding:.3rem .75rem; border-radius:20px; }

    /* Search */
    .srch-wrap { position:relative; }
    .srch-wrap i { position:absolute; left:.875rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:.9rem; pointer-events:none; }
    .srch-input { width:240px; padding:.58rem .875rem .58rem 2.375rem; border:1.5px solid #e2e8f0; border-radius:9px; font-size:.845rem; color:#1e293b; background:#fff; outline:none; transition:border-color .2s; }
    .srch-input:focus { border-color:#667eea; box-shadow:0 0 0 3px rgba(102,126,234,.1); }
    .srch-input::placeholder { color:#cbd5e1; }
    .btn-srch { padding:.58rem 1rem; background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; border:none; border-radius:9px; font-size:.845rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:.375rem; }
    .btn-clr  { padding:.58rem .875rem; background:#f1f5f9; color:#64748b; border:1.5px solid #e2e8f0; border-radius:9px; font-size:.845rem; font-weight:500; text-decoration:none; display:inline-flex; align-items:center; gap:.3rem; }
    .btn-clr:hover { background:#e2e8f0; }

    /* Table */
    .tbl-wrap { overflow-x:auto; }
    .dt { width:100%; border-collapse:collapse; }
    .dt thead th { padding:.75rem 1.125rem; font-size:.7rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.09em; background:#f8fafc; border-bottom:1px solid #f0f4f8; white-space:nowrap; }
    .dt tbody td { padding:.875rem 1.125rem; font-size:.855rem; color:#374151; border-bottom:1px solid #f8fafc; vertical-align:middle; }
    .dt tbody tr:last-child td { border-bottom:none; }
    .dt tbody tr:hover td { background:#fafbff; }
    .rn { color:#cbd5e1; font-size:.8rem; font-weight:600; }
    .co-av-sm { width:34px; height:34px; border-radius:9px; background:linear-gradient(135deg,#0ea5e9,#2563eb); display:flex; align-items:center; justify-content:center; color:#fff; font-size:.82rem; font-weight:800; flex-shrink:0; }
    .co-name { font-weight:700; color:#1e293b; }
    .co-code { font-size:.72rem; color:#94a3b8; font-family:'Consolas','Monaco',monospace; }

    /* Footer + pagination */
    .dc-foot { padding:.9rem 1.375rem; border-top:1px solid #f1f5f9; background:#fafbfc; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem; }
    .ri { font-size:.82rem; color:#94a3b8; }
    .ri strong { color:#374151; }
    .pgn { display:flex; align-items:center; gap:.25rem; }
    .pb { display:flex; align-items:center; justify-content:center; min-width:32px; height:32px; padding:0 .5rem; border:1.5px solid #e2e8f0; border-radius:7px; font-size:.8rem; font-weight:500; color:#64748b; text-decoration:none; transition:all .18s; background:#fff; }
    .pb:hover { background:#f8fafc; color:#334155; border-color:#cbd5e1; }
    .pb.cur   { background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; border-color:transparent; font-weight:700; }
    .pb.off   { opacity:.35; pointer-events:none; }
    .pb.wide  { padding:0 .875rem; }
    .pgn-dots { padding:0 .25rem; color:#cbd5e1; font-size:.82rem; }

    .es { text-align:center; padding:3.5rem 2rem; }
    .es i { font-size:2.75rem; color:#e2e8f0; display:block; margin-bottom:.875rem; }
    .es h6 { font-weight:600; color:#64748b; margin:0 0 .375rem; }
    .es p  { font-size:.845rem; color:#94a3b8; margin:0; }

    .btn-back { display:inline-flex; align-items:center; gap:.375rem; padding:.5rem 1.125rem; background:rgba(255,255,255,.15); color:#fff; border:1.5px solid rgba(255,255,255,.3); border-radius:9px; font-size:.845rem; font-weight:600; text-decoration:none; transition:all .18s; backdrop-filter:blur(4px); }
    .btn-back:hover { background:rgba(255,255,255,.25); color:#fff; }

    @@media (max-width:576px) { .co-hero-top { flex-direction:column; } .info-grid { grid-template-columns:1fr 1fr; } }
</style>

<!-- Breadcrumb -->
<nav class="bcrumb">
    <a href="/Companies"><i class="bi bi-building-fill me-1"></i>Companies</a>
    <span class="sep"><i class="bi bi-chevron-right" style="font-size:.65rem;"></i></span>
    <span class="cur">@c.CompanyName</span>
</nav>

<!-- Company hero -->
<div class="co-hero">
    <div class="co-hero-top">
        <div class="co-hero-av">@av</div>
        <div class="co-hero-title">
            <h4>@c.CompanyName</h4>
            <span class="code">@c.CompanyCode</span>
            @if (c.ParentCompanyId == null)
            {
                <span style="background:rgba(255,255,255,.2);color:#fff;font-size:.74rem;font-weight:700;padding:.2rem .6rem;border-radius:6px;display:inline-block;margin-left:.5rem;">
                    <i class="bi bi-building-fill" style="font-size:.65rem;"></i> Head Office
                </span>
            }
        </div>
        <div class="co-hero-right d-flex align-items-center gap-2">
            @if (c.IsActive)
            { <span class="s-on"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Active</span> }
            else
            { <span class="s-off"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Inactive</span> }
            <a href="/Companies" class="btn-back"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="co-hero-body">
        <div class="info-grid">
            @if (!string.IsNullOrEmpty(c.EmailAddress))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-envelope me-1"></i>Email</div>
                    <div class="info-val"><a href="mailto:@c.EmailAddress">@c.EmailAddress</a></div>
                </div>
            }
            @if (!string.IsNullOrEmpty(c.PhoneNumber))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-telephone me-1"></i>Phone</div>
                    <div class="info-val light">@c.PhoneNumber</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(c.Website))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-globe me-1"></i>Website</div>
                    <div class="info-val"><a href="@c.Website" target="_blank">@c.Website</a></div>
                </div>
            }
            <div class="info-item">
                <div class="info-lbl"><i class="bi bi-geo-alt me-1"></i>Location</div>
                <div class="info-val light">
                    @(c.Location ?? c.CityName ?? "—")
                    @if (!string.IsNullOrEmpty(c.CountryName)) { <span>, @c.CountryName</span> }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(c.Address))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-building me-1"></i>Address</div>
                    <div class="info-val light">@c.Address</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(c.CurrencyCode))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-currency-exchange me-1"></i>Currency</div>
                    <div class="info-val">@c.CurrencyCode</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(c.ProvinceName))
            {
                <div class="info-item">
                    <div class="info-lbl"><i class="bi bi-map me-1"></i>Province / City</div>
                    <div class="info-val light">@c.ProvinceName, @c.CityName</div>
                </div>
            }
        </div>
    </div>

    @if (c.ParentCompanyId == null)
    {
        <div class="stat-row">
            <div class="stat-item">
                <div class="stat-icon" style="background:#ede9fe;">
                    <i class="bi bi-diagram-2-fill" style="color:#7c3aed;"></i>
                </div>
                <div class="stat-text">
                    <strong>@c.BranchCount</strong>
                    <span>Branch@(c.BranchCount != 1 ? "es" : "")</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon" style="background:#d1fae5;">
                    <i class="bi bi-people-fill" style="color:#065f46;"></i>
                </div>
                <div class="stat-text">
                    <strong>@c.UserCount</strong>
                    <span>User@(c.UserCount != 1 ? "s" : "")</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Branches table (head offices only) -->
@if (c.ParentCompanyId == null)
{
    <div class="dc">
        <div class="dc-head">
            <div class="d-flex align-items-center gap-2">
                <div class="dc-title"><i class="bi bi-diagram-2-fill"></i> Branches</div>
                <span class="cc-lrg"><i class="bi bi-building"></i> @Model.TotalCount</span>
            </div>
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <input type="hidden" name="page" value="1" />
                <div class="srch-wrap">
                    <i class="bi bi-search"></i>
                    <input class="srch-input" type="text" name="search" value="@Model.SearchTerm" placeholder="Search branches…" autocomplete="off" />
                </div>
                <button type="submit" class="btn-srch"><i class="bi bi-search"></i> Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a href="/Companies/Details/@c.Id" class="btn-clr"><i class="bi bi-x-circle"></i> Clear</a>
                }
            </form>
        </div>

        <div class="tbl-wrap">
            <table class="dt">
                <thead>
                    <tr>
                        <th style="width:48px;">#</th>
                        <th>Branch Name</th>
                        <th class="d-none d-md-table-cell">Location</th>
                        <th style="width:90px;" class="d-none d-md-table-cell">Currency</th>
                        <th style="width:90px;">Status</th>
                        <th style="width:80px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Branches.Any())
                    {
                        @for (int i = 0; i < Model.Branches.Count; i++)
                        {
                            var b = Model.Branches[i];
                            var bav = b.CompanyName?.Length > 0 ? b.CompanyName[0].ToString().ToUpper() : "B";
                            <tr>
                                <td><span class="rn">@(Model.From + i)</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="co-av-sm">@bav</div>
                                        <div>
                                            <div class="co-name">@b.CompanyName</div>
                                            <div class="co-code">@b.CompanyCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <span style="font-size:.82rem;color:#64748b;">
                                        <i class="bi bi-geo-alt" style="font-size:.7rem;"></i>
                                        @(b.Location ?? b.CityName ?? "—")@(b.CountryName != null ? $", {b.CountryName}" : "")
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    @if (!string.IsNullOrEmpty(b.CurrencyCode))
                                    {
                                        <span style="background:#f1f5f9;border:1px solid #e2e8f0;color:#475569;font-size:.75rem;font-weight:700;padding:.2rem .55rem;border-radius:6px;font-family:monospace;">@b.CurrencyCode</span>
                                    }
                                </td>
                                <td>
                                    @if (b.IsActive)
                                    { <span class="s-on"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Active</span> }
                                    else
                                    { <span class="s-off"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>Inactive</span> }
                                </td>
                                <td>
                                    <a href="/Companies/Details/@b.Id"
                                       style="display:inline-flex;align-items:center;gap:.3rem;padding:.35rem .7rem;border-radius:7px;font-size:.78rem;font-weight:600;color:#4338ca;border:1.5px solid #e0e7ff;background:#eef2ff;text-decoration:none;transition:all .18s;">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6">
                            <div class="es">
                                <i class="bi bi-diagram-2"></i>
                                <h6>@(string.IsNullOrEmpty(Model.SearchTerm) ? "No branches found" : "No branches match your search")</h6>
                                <p>@(string.IsNullOrEmpty(Model.SearchTerm) ? "This company has no branches yet." : "Try a different keyword.")</p>
                            </div>
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalCount > 0)
        {
            <div class="dc-foot">
                <div class="ri">Showing <strong>@Model.From</strong>–<strong>@Model.To</strong> of <strong>@Model.TotalCount</strong> branch@(Model.TotalCount != 1 ? "es" : "")</div>
                @if (Model.TotalPages > 1)
                {
                    <nav class="pgn">
                        <a class="pb wide @(Model.Page<=1?"off":"")" href="?search=@Model.SearchTerm&page=@(Model.Page-1)">
                            <i class="bi bi-chevron-left" style="font-size:.7rem;"></i> Prev
                        </a>
                        @{
                            int tp=Model.TotalPages,cp=Model.Page;
                            var pages=new List<int?>();
                            if(tp<=7){for(int p=1;p<=tp;p++)pages.Add(p);}
                            else{pages.Add(1);if(cp>3)pages.Add(null);for(int p=Math.Max(2,cp-1);p<=Math.Min(tp-1,cp+1);p++)pages.Add(p);if(cp<tp-2)pages.Add(null);pages.Add(tp);}
                        }
                        @foreach(var pn in pages){
                            if(pn==null){<span class="pgn-dots">…</span>}
                            else{<a class="pb @(pn==Model.Page?"cur":"")" href="?search=@Model.SearchTerm&page=@pn">@pn</a>}
                        }
                        <a class="pb wide @(Model.Page>=Model.TotalPages?"off":"")" href="?search=@Model.SearchTerm&page=@(Model.Page+1)">
                            Next <i class="bi bi-chevron-right" style="font-size:.7rem;"></i>
                        </a>
                    </nav>
                }
            </div>
        }
    </div>
}
else
{
    <div style="background:#fff;border-radius:14px;border:1px solid #e9eef4;padding:2rem;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.04);">
        <i class="bi bi-diagram-2" style="font-size:2.5rem;color:#e2e8f0;display:block;margin-bottom:.875rem;"></i>
        <h6 style="color:#64748b;font-weight:600;margin:0 0 .375rem;">This is a Branch</h6>
        <p style="font-size:.845rem;color:#94a3b8;margin:0 0 1rem;">
            Parent: <strong style="color:#374151;">@c.ParentCompanyName</strong>
        </p>
        <a href="/Companies" style="display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.25rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:9px;font-size:.855rem;font-weight:600;text-decoration:none;">
            <i class="bi bi-arrow-left"></i> Back to Companies
        </a>
    </div>
}
